# Produktionsdomain (für Canonicals, Sitemap, Social-Vorschau). Vor dem Livegang bestätigen.
SITE_URL=https://www.silver-stage.de
# Nur setzen, wenn die Seite in einem Unterverzeichnis liegt, z. B. /silver-stage/
BASE_PATH=/
# true = Vorschau (noindex + robots Disallow), false = Produktion
PUBLIC_PREVIEW=true
# Adresse des Formular-Backends (siehe form-backend/README.md). Leer = Formular öffnet das E-Mail-Programm.
PUBLIC_FORM_ENDPOINT=
