---
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import { PADS, SETTINGS } from "../../game/engine.js";
import { u } from "../../lib/url";
---
<Base title="Beat Stage – das Rhythmusspiel von Silver Stage" description="Beat Stage: Triff im Takt die vier Pads Kick, Snare, Hi-Hat und Clap. 30 Sekunden, 100 BPM, ohne Anmeldung – mit oder ohne Ton spielbar." current="/beat-stage/">
  <section class="game-sec venue">
    <div class="wrap game" data-game>
      <!-- Startansicht -->
      <div class="screen start" data-screen="start">
        <div class="intro-col">
          <h1>Triff den Takt.</h1>
          <p class="lead">Vier Pads, {SETTINGS.roundSeconds} Sekunden, {SETTINGS.bpm} BPM. Tipp das Pad, wenn sein Symbol die Linie erreicht.</p>
          <ul class="how">
            <li><strong>Steuerung:</strong> Tasten <kbd>D</kbd> <kbd>F</kbd> <kbd>J</kbd> <kbd>K</kbd> – oder die großen Pads antippen.</li>
            <li><strong>Wertung:</strong> Perfekt (±80 ms), Gut (±150 ms), sonst verpasst. Fehlgriffe beenden die Combo.</li>
            <li><strong>Pause:</strong> <kbd>Esc</kbd> oder <kbd>P</kbd>. Wechselst du den Tab, pausiert das Spiel automatisch.</li>
          </ul>
          <div class="btn-row">
            <button class="btn" type="button" data-start-sound>Mit Sound spielen</button>
            <button class="btn btn--ghost" type="button" data-start-mute>Stumm spielen</button>
          </div>
          <button class="text-btn" type="button" data-start-free>Freier Modus ohne Zeitdruck</button>
          <p class="small muted">Ton startet erst nach deinem Klick. Bestwert: <span data-best>–</span> (nur auf diesem Gerät gespeichert).</p>
        </div>
        <div class="start-art" aria-hidden="true"><Logo variant="signet" /></div>
      </div>

      <!-- Spielansicht -->
      <div class="screen stage" data-screen="stage" hidden>
        <div class="hud">
          <p class="mode" data-mode></p>
          <dl class="stats">
            <div><dt>Punkte</dt><dd data-score>0</dd></div>
            <div><dt>Combo</dt><dd data-combo>0</dd></div>
            <div><dt>Quote</dt><dd data-acc>–</dd></div>
          </dl>
          <div class="controls">
            <button class="btn btn--ghost btn--sm" type="button" data-pause aria-pressed="false">Pause</button>
            <button class="btn btn--ghost btn--sm" type="button" data-restart>Neustart</button>
            <button class="btn btn--ghost btn--sm" type="button" data-quit>Beenden</button>
            <button class="btn btn--ghost btn--sm" type="button" data-mute aria-pressed="false">Stumm</button>
            <label class="vol"><span>Lautstärke</span><input type="range" min="0" max="100" step="5" data-volume aria-label="Lautstärke" /></label>
          </div>
        </div>
        <p class="sound-info small" data-sound-info role="status"></p>
        <div class="progress" aria-hidden="true"><span data-progress></span></div>
        <div class="field">
          <div class="signet" data-signet aria-hidden="true"><Logo variant="signet" /></div>
          <canvas aria-hidden="true"></canvas>
          <p class="judge" data-judge aria-hidden="true"></p>
          <p class="count" data-count aria-hidden="true" hidden></p>
        </div>
        <div class="pads" role="group" aria-label="Pads">
          {PADS.map((p, i) => (
            <button class="pad" type="button" data-pad={i} aria-label={`${p.name} (Taste ${p.key.toUpperCase()})`}>
              <svg viewBox="-20 -20 40 40" class={`ico ${p.shape}`} aria-hidden="true">
                {p.shape === "circle" && <circle r="12" />}
                {p.shape === "square" && <rect x="-11" y="-11" width="22" height="22" />}
                {p.shape === "triangle" && <path d="M0 -13 L13 10 L-13 10 Z" />}
                {p.shape === "diamond" && <path d="M0 -14 L14 0 L0 14 L-14 0 Z" />}
              </svg>
              <span class="pname">{p.name}</span><kbd>{p.key.toUpperCase()}</kbd>
            </button>
          ))}
        </div>
      </div>

      <!-- Ergebnis -->
      <div class="screen result" data-screen="result" hidden>
        <h2 tabindex="-1" data-result-title>Runde beendet</h2>
        <p class="new" data-r-new hidden>Neuer Bestwert!</p>
        <dl class="res">
          <div class="big"><dt>Punkte</dt><dd data-r-score>0</dd></div>
          <div class="big"><dt>Trefferquote</dt><dd data-r-acc>0 %</dd></div>
          <div><dt>Perfekt</dt><dd data-r-perfect>0</dd></div>
          <div><dt>Gut</dt><dd data-r-good>0</dd></div>
          <div><dt>Verpasst</dt><dd data-r-miss>0</dd></div>
          <div><dt>Beste Combo</dt><dd data-r-combo>0</dd></div>
          <div><dt>Dein Bestwert</dt><dd data-best>–</dd></div>
        </dl>
        <div class="btn-row">
          <button class="btn" type="button" data-again>Noch einmal spielen</button>
          <a class="btn btn--ghost" href={u("/kontakt/?raum=tonstudio")}>Deinen eigenen Sound aufnehmen – Session anfragen</a>
        </div>
      </div>
      <p class="visually-hidden" aria-live="polite" data-live></p>
    </div>
  </section>
  <noscript><div class="wrap"><p class="lead">Beat Stage braucht JavaScript. Die übrige Website funktioniert auch ohne.</p></div></noscript>
</Base>

<script>
  import "../../game/ui.js";
</script>

<style>
  .game-sec { padding-block: clamp(40px, 6vw, 80px) clamp(64px, 8vw, 112px); min-height: 70vh; }
  .screen[hidden] { display: none !important; }
  .start { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(32px, 6vw, 96px); align-items: center; min-height: 60vh; }
  .intro-col { display: grid; gap: 22px; justify-items: start; }
  .intro-col h1 { font-size: clamp(3rem, 1rem + 7vw, 6rem); font-weight: 880; font-stretch: 130%; letter-spacing: -0.04em; line-height: 0.86; }
  .how { margin: 0; padding: 0; list-style: none; display: grid; gap: 10px; color: var(--ink-2); max-width: 60ch; border-top: 2px solid var(--ink); padding-top: 16px; }
  .how strong { color: var(--ink); }
  .text-btn { background: none; border: 0; color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; min-height: 44px; padding: 0; font: 650 1rem / 1.2 var(--font-body); cursor: pointer; }
  .start-art { max-width: 420px; width: 100%; justify-self: center; }
  .start-art :global(svg) { width: 100%; height: auto; overflow: visible; }
  .start-art :global(path) { vector-effect: non-scaling-stroke; stroke-width: 7px; animation: art-beat var(--beat) cubic-bezier(0.15, 0.7, 0.3, 1) 8 both; }
  .start-art :global(path[data-group="0"]) { stroke: var(--pink); }
  .start-art :global(path[data-group="1"]) { stroke: #7b8cff; }
  .start-art :global(path[data-group="2"]) { stroke: var(--yellow); }
  .start-art :global(path[data-ring="1"]) { animation-delay: 0.05s; }
  .start-art :global(path[data-ring="2"]) { animation-delay: 0.1s; }
  .start-art :global(path[data-ring="3"]) { animation-delay: 0.15s; }
  .start-art :global(.signet-dot) { fill: #eceaf0; }
  @keyframes art-beat { 0% { opacity: 1; } 60%, 100% { opacity: 0.4; } }

  .stage { display: grid; gap: 16px; }
  .hud { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .mode { font-weight: 650; color: var(--yellow); }
  .stats { display: flex; gap: 28px; margin: 0; }
  .stats div { display: grid; }
  .stats dt { font-size: var(--step--1); color: var(--ink-2); }
  .stats dd { margin: 0; font: 880 1.8rem / 1.1 var(--font-display); font-stretch: 112%; font-variant-numeric: tabular-nums; min-width: 3ch; }
  :global(.is-free) .stats, :global(.is-free) [data-pause], :global(.is-free) .progress { visibility: hidden; }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .controls [aria-pressed="true"] { background: #eceaf0; color: #1c1a21; }
  .vol { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; font-size: var(--step--1); color: var(--ink-2); }
  .vol input { width: 110px; accent-color: var(--yellow); }
  .sound-info:empty { display: none; }
  .progress { height: 4px; background: rgb(236 234 240 / 0.16); }
  .progress span { display: block; height: 100%; background: var(--yellow); transform: scaleX(0); transform-origin: left; }
  .field { position: relative; height: min(52vh, 460px); overflow: hidden; background: #141218; border-top: 2px solid #eceaf0; border-bottom: 2px solid #eceaf0; }
  .field canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .signet { position: absolute; left: 50%; top: 42%; width: min(46%, 280px); transform: translate(-50%, -50%); color: rgb(236 234 240 / 0.1); pointer-events: none; }
  .signet :global(svg) { width: 100%; height: auto; }
  .signet :global(path.on) { animation: arc 0.45s ease-out; }
  @keyframes arc { 0% { stroke: var(--yellow); } 100% { stroke: currentColor; } }
  .judge { position: absolute; left: 0; right: 0; top: 18%; text-align: center; font: 880 clamp(1.8rem, 4vw, 2.8rem) / 1 var(--font-display); font-stretch: 125%; pointer-events: none; }
  .judge[data-kind="perfect"] { color: var(--yellow); }
  .judge[data-kind="good"] { color: #eceaf0; }
  .judge[data-kind="miss"] { color: #ff9fbf; }
  .judge.pop { animation: pop 0.3s var(--ease); }
  @keyframes pop { from { transform: scale(1.25); opacity: 0.4; } to { transform: none; opacity: 1; } }
  .count { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; font: 900 clamp(4rem, 14vw, 9rem) / 1 var(--font-display); font-stretch: 140%; color: var(--yellow); background: rgb(20 18 24 / 0.6); }
  .count[hidden] { display: none; }
  .pads { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .pad { --c: var(--yellow); position: relative; display: grid; justify-items: center; gap: 8px; min-height: 120px; padding: 16px 8px; background: #1c1a21; border: 2px solid var(--c); border-radius: 4px; color: #eceaf0; cursor: pointer; touch-action: manipulation; -webkit-user-select: none; user-select: none; transition: background-color 0.12s, color 0.12s, transform 0.08s; }
  .pad:nth-child(2) { --c: var(--pink); } .pad:nth-child(3) { --c: #7b8cff; } .pad:nth-child(4) { --c: #eceaf0; }
  .pad .ico { color: var(--c); }
  .pad:active, .pad.hit { background: var(--c); color: #1c1a21; }
  .pad:active .ico, .pad.hit .ico { color: #1c1a21; }
  .pad.hit { animation: padhit 0.18s ease-out; }
  @keyframes padhit { 0% { transform: translateY(3px); } 100% { transform: none; } }
  .ico { width: 34px; height: 34px; fill: none; stroke: currentColor; stroke-width: 2.5; }
  .pname { font: 750 1rem / 1.2 var(--font-display); font-stretch: 110%; }
  .pad kbd { position: absolute; top: 8px; right: 8px; }

  .result { display: grid; gap: 22px; justify-items: start; max-width: 900px; }
  .result h2 { font-size: var(--step-4); font-weight: 880; font-stretch: 128%; }
  .result h2:focus { outline: none; }
  .new { color: #1c1a21; background: var(--yellow); padding: 4px 10px; font: 750 1rem / 1.2 var(--font-display); }
  .new[hidden] { display: none; }
  .res { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; margin: 0; width: 100%; border-top: 2px solid #eceaf0; }
  .res div { padding: 16px 16px 16px 0; display: grid; gap: 4px; border-bottom: 1px solid var(--rule-strong); }
  .res .big { grid-column: span 2; }
  .res dt { font-size: var(--step--1); color: var(--ink-2); }
  .res dd { margin: 0; font: 880 1.6rem / 1.1 var(--font-display); font-stretch: 112%; font-variant-numeric: tabular-nums; }
  .res .big dd { font-size: var(--step-3); color: var(--yellow); }
  @media (max-width: 860px) { .start { grid-template-columns: 1fr; } .start-art { max-width: 180px; justify-self: start; order: -1; } }
  @media (max-width: 640px) {
    .pads { gap: 8px; } .pad { min-height: 104px; } .pad kbd { display: none; }
    .field { height: max(200px, calc(100svh - 76px - 330px)); }
    .stage { gap: 10px; }
    .hud { gap: 10px; }
    .mode { display: none; }
    .controls { gap: 6px; }
    .controls :global(.btn--sm) { --h: 44px; padding: 0 12px; }
    .vol span { display: none; }
    .stats { gap: 18px; } .stats dd { font-size: 1.4rem; }
    .res { grid-template-columns: 1fr 1fr; }
    .vol input { width: 90px; }
  }
  @media (prefers-reduced-motion: reduce) { .signet :global(path.on), .judge.pop, .pad.hit { animation: none; } }
</style>
