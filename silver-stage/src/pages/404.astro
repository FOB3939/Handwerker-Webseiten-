---
import Base from "../layouts/Base.astro";
import { u } from "../lib/url";
---
<Base title="Seite nicht gefunden – Silver Stage" description="Diese Seite gibt es bei Silver Stage nicht. Zur Startseite, zum Tonstudio oder direkt eine Session anfragen." noindex>
  <section class="section"><div class="wrap nf">
    <p class="code" aria-hidden="true">404</p>
    <h1>Hier spielt gerade keine Musik.</h1>
    <p class="lead">Die Seite gibt es nicht (mehr). Vielleicht suchst du eines davon:</p>
    <div class="btn-row"><a class="btn" href={u("/")}>Zur Startseite</a><a class="btn btn--ghost" href={u("/kontakt/")}>Session anfragen</a></div>
  </div></section>
</Base>
<style>
  .nf { display: grid; gap: 22px; justify-items: start; min-height: 50vh; align-content: center; }
  .code { font: 900 clamp(6rem, 3rem + 14vw, 14rem) / 0.8 var(--font-display); font-stretch: 140%; letter-spacing: -0.05em; color: var(--pink); -webkit-text-stroke: 2px var(--ink); }
  .nf h1 { font-size: var(--step-3); }
</style>
