---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Light from "../../components/Light.astro";
import Photo from "../../components/Photo.astro";
import { ROOM_PHOTOS } from "../../assets/photos";
import { ROOMS } from "../../config/site";
import { u } from "../../lib/url";
---
<Base title="Über Silver Stage – Studio & Proberäume in München" description="Silver Stage in München-Sendling: Tonstudio, Stageroom mit Bühne, Lightroom und Lounge unter einem Dach – für Musik, Proben, Tanz und Fotoshootings." current="/ueber-uns/">
  <PageHero kicker="Über uns" title="Ein Ort für Sound und Bühne" lead="Silver Stage verbindet in München-Sendling ein Tonstudio mit Räumen zum Proben, Tanzen und Fotografieren." photo="stageVeniceBuehne" cta={{ label: "Session anfragen", href: u("/kontakt/") }} />
  <section class="section">
    <div class="wrap about">
      <div>
        <h2>Aufnehmen, proben, gestalten</h2>
      </div>
      <div class="text">
        <p class="lead">Bei Silver Stage findest du an der Flößergasse in Sendling ein akustisch optimiertes Tonstudio, den Stageroom mit Bühne und Konzertanlage, den Lightroom mit farbigem Licht und Spiegelwand sowie eine Lounge.</p>
        <p class="muted">So kannst du einen Song aufnehmen, mit der Band für den nächsten Auftritt proben oder ein Shooting im farbigen Licht planen – ohne den Ort zu wechseln.</p>
      </div>
    </div>
  </section>
  <section class="section section--sheet">
    <div class="wrap">
      <ul class="tiles">
        {ROOMS.map((r) => (
          <li data-room={r.key}><a href={u(r.path)} class="inked"><span class="tp plate"><Photo name={ROOM_PHOTOS[r.key].hero} sizes="(min-width: 980px) 25vw, 50vw" decorative /></span><span class="t"><span class="name">{r.name}</span><span class="k">{r.kicker}</span></span></a></li>
        ))}
        <li><div class="lounge"><span class="tp"><Light class="tile-light" /></span><span class="t"><span class="name">Lounge</span><span class="k">Pause</span></span></div></li>
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="wrap team">
      <h2>Die Menschen hinter Silver Stage</h2>
      <p class="muted">Dieser Abschnitt wird ergänzt, sobald Namen, Fotos und Texte des Teams freigegeben sind. Bis dahin erreichst du das Studio direkt per Telefon oder E-Mail.</p>
      <a class="link" href={u("/kontakt/")}>Kontakt aufnehmen</a>
    </div>
  </section>
</Base>
<style>
  .about { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); }
  .text { display: grid; gap: 20px; }
  .text .lead { color: var(--ink); max-width: 52ch; }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .tiles a, .lounge { display: grid; grid-template-rows: auto 1fr; height: 100%; text-decoration: none; border: 2px solid var(--ink); }
  .lounge { background: var(--paper-3); }
  .tp { position: relative; display: block; aspect-ratio: 4 / 3.4; overflow: hidden; }
  .tp :global(img) { position: absolute; inset: 0; }
  .tp :global(.tile-light) { position: absolute; inset: 0; }
  .t { display: grid; gap: 4px; padding: 18px 18px 20px; align-content: start; }
  .name { font: 880 var(--step-2) / 1 var(--font-display); font-stretch: 122%; letter-spacing: -0.02em; }
  .k { font-weight: 650; }
  .tiles a:hover .name { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .team { display: grid; gap: 18px; max-width: 720px; justify-items: start; }
  @media (max-width: 980px) { .tiles { grid-template-columns: 1fr 1fr; } .about { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .tiles { grid-template-columns: 1fr; } }
</style>
