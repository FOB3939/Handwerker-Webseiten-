---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Light from "../../components/Light.astro";
import Icon from "../../components/Icon.astro";
import { ROOMS } from "../../config/site";
import { u } from "../../lib/url";
---
<Base title="Über Silver Stage – Tonstudio und kreative Räume in München-Sendling" description="Silver Stage in München-Sendling: Tonstudio, Stageroom mit Bühne, Lightroom und Lounge unter einem Dach – für Musik, Proben, Tanz und Fotoshootings." current="/ueber-uns/">
  <PageHero kicker="Über uns" title="Ein Ort für Sound und Bühne" lead="Silver Stage verbindet in München-Sendling ein Tonstudio mit Räumen zum Proben, Tanzen und Fotografieren." cta={{ label: "Session anfragen", href: u("/kontakt/") }} />
  <section class="section">
    <div class="wrap about">
      <div data-reveal>
        <h2>Aufnehmen, proben, gestalten</h2>
      </div>
      <div class="text" data-reveal style="--d:.1s">
        <p class="lead">Bei Silver Stage findest du an der Flößergasse in Sendling ein akustisch optimiertes Tonstudio, den Stageroom mit Bühne und Konzertanlage, den Lightroom mit farbigem Licht und Spiegelwand sowie eine Lounge.</p>
        <p class="muted">So kannst du einen Song aufnehmen, mit der Band für den nächsten Auftritt proben oder ein Shooting im farbigen Licht planen – ohne den Ort zu wechseln.</p>
      </div>
    </div>
  </section>
  <section class="section section--alt">
    <div class="wrap">
      <ul class="tiles">
        {ROOMS.map((r) => (
          <li data-room={r.key}><a href={u(r.path)}><Light room={r.key} class="tile-light" at="center" /><span class="t"><span class="label">{r.kicker}</span><span class="name">{r.name}</span></span></a></li>
        ))}
        <li><div class="lounge"><Light class="tile-light" at="center" /><span class="t"><span class="label">Pause</span><span class="name">Lounge</span></span></div></li>
      </ul>
    </div>
  </section>
  <section class="section">
    <div class="wrap team" data-reveal>
      <h2>Die Menschen hinter Silver Stage</h2>
      <p class="muted">Dieser Abschnitt wird ergänzt, sobald Namen, Fotos und Texte des Teams freigegeben sind. Bis dahin erreichst du das Studio direkt per Telefon oder E-Mail.</p>
      <a class="link-arrow" href={u("/kontakt/")}>Kontakt aufnehmen</a>
    </div>
  </section>
</Base>
<style>
  .about { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 96px); }

  .text { display: grid; gap: 20px; }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .tiles a, .lounge { position: relative; display: grid; align-content: end; min-height: 380px; text-decoration: none; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; height: 100%; }
  .tiles :global(.tile-light) { position: absolute; inset: 0; --size: 130%; --cx: 50%; }
  .t { position: relative; display: grid; gap: 8px; padding: 22px; }
  .name { font: 300 var(--step-2) / 1.05 var(--font-display); letter-spacing: -0.02em; }
  .team { display: grid; gap: 18px; max-width: 720px; }
  @media (max-width: 980px) { .tiles { grid-template-columns: 1fr 1fr; } .about { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .tiles { grid-template-columns: 1fr; } }
</style>
