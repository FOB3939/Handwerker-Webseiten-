---
import Base from "../../layouts/Base.astro";
import InquiryForm from "../../components/InquiryForm.astro";
import Icon from "../../components/Icon.astro";
import { CONTACT } from "../../config/site";
---
<Base title="Kontakt & Session anfragen – Silver Stage München-Sendling" description="Session im Tonstudio, Stageroom oder Lightroom anfragen: Silver Stage, Flößergasse 8, 81369 München. Telefon, E-Mail oder Anfrageformular." current="/kontakt/">
  <section class="section contact">
    <div class="wrap grid">
      <div class="info">
        <p class="label">Kontakt</p>
        <h1>Session anfragen</h1>
        <p class="lead">Erzähl uns kurz, was du vorhast. Wir melden uns mit einem individuellen Angebot und stimmen den Termin mit dir ab.</p>
        <ul class="channels">
          <li><a href={CONTACT.phoneHref}><Icon name="phone" /><span><small>Telefon</small>{CONTACT.phone}</span></a></li>
          <li><a href={`mailto:${CONTACT.email}`}><Icon name="mail" /><span><small>E-Mail</small>{CONTACT.email}</span></a></li>
          <li><a href={CONTACT.routeUrl} target="_blank" rel="noopener"><Icon name="pin" /><span><small>Adresse · Route planen</small>{CONTACT.street}, {CONTACT.zip} {CONTACT.city}</span></a></li>
          <li class="static"><Icon name="clock" /><span><small>Zeiten</small>{CONTACT.hoursNote}</span></li>
        </ul>
      </div>
      <div class="form-card">
        <h2 class="visually-hidden">Anfrageformular</h2>
        <InquiryForm />
      </div>
    </div>
  </section>
</Base>
<style>
  .contact { padding-top: clamp(56px, 8vw, 104px); }
  .grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .info { display: grid; gap: 22px; position: sticky; top: 110px; }
  .info h1 { font-size: var(--step-3); }
  .channels { list-style: none; margin: 12px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .channels a, .channels .static { display: flex; gap: 16px; align-items: flex-start; padding: 18px 0; border-bottom: 1px solid var(--line); text-decoration: none; min-height: 44px; overflow-wrap: anywhere; }
  .channels a:hover span { text-decoration: underline; text-underline-offset: 4px; }
  .channels :global(svg) { width: 20px; height: 20px; color: var(--silver); flex: none; margin-top: 3px; }
  .channels span { display: grid; gap: 2px; }
  .channels small { font: 500 0.72rem / 1.3 var(--font-display); letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-2); }
  .form-card { background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(22px, 3.5vw, 44px); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .info { position: static; } }
</style>
