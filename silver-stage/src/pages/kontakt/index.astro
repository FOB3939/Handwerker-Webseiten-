---
import Base from "../../layouts/Base.astro";
import InquiryForm from "../../components/InquiryForm.astro";
import Icon from "../../components/Icon.astro";
import { CONTACT } from "../../config/site";
---
<Base title="Kontakt & Session anfragen – Silver Stage München-Sendling" description="Session im Tonstudio, Stageroom oder Lightroom anfragen: Silver Stage, Flößergasse 8, 81369 München. Telefon, E-Mail oder Anfrageformular." current="/kontakt/">
  <section class="section contact">
    <div class="wrap grid">
      <div class="info">
        <h1>Session anfragen</h1>
        <p class="lead">Erzähl uns kurz, was du vorhast. Wir melden uns mit einem individuellen Angebot und stimmen den Termin mit dir ab.</p>
        <ul class="channels">
          <li><a href={CONTACT.phoneHref}><Icon name="phone" /><span><small>Telefon</small>{CONTACT.phone}</span></a></li>
          <li><a href={`mailto:${CONTACT.email}`}><Icon name="mail" /><span><small>E-Mail</small>{CONTACT.email}</span></a></li>
          <li><a href={CONTACT.routeUrl} target="_blank" rel="noopener"><Icon name="pin" /><span><small>Adresse und Route</small>{CONTACT.street}, {CONTACT.zip} {CONTACT.city}</span></a></li>
          <li class="static"><Icon name="clock" /><span><small>Zeiten</small>{CONTACT.hoursNote}</span></li>
        </ul>
      </div>
      <div class="form-card">
        <h2 class="visually-hidden">Anfrageformular</h2>
        <InquiryForm />
      </div>
    </div>
  </section>
</Base>
<style>
  .contact { padding-top: clamp(48px, 7vw, 96px); }
  .grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(36px, 6vw, 96px); align-items: start; }
  .info { display: grid; gap: 22px; position: sticky; top: 104px; }
  .info h1 { font-size: clamp(2.6rem, 1.2rem + 4.4vw, 5.4rem); font-weight: 860; font-stretch: 122%; line-height: 0.9; letter-spacing: -0.035em; }
  .channels { list-style: none; margin: 8px 0 0; padding: 0; border-top: 2px solid var(--ink); }
  .channels a, .channels .static { display: flex; gap: 16px; align-items: flex-start; padding: 16px 0; border-bottom: 1px solid var(--rule-strong); text-decoration: none; min-height: 44px; overflow-wrap: anywhere; font-weight: 650; }
  .channels a:hover span { text-decoration: underline; text-underline-offset: 4px; }
  .channels :global(svg) { width: 22px; height: 22px; flex: none; margin-top: 2px; }
  .channels span { display: grid; gap: 2px; }
  .channels small { font: 400 var(--step--1) / 1.3 var(--font-body); color: var(--ink-2); }
  .form-card { background: var(--paper-3); border: 2px solid var(--ink); padding: clamp(20px, 3.5vw, 44px); box-shadow: 0 24px 48px -28px rgb(28 26 33 / 0.5); }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .info { position: static; } }
</style>
