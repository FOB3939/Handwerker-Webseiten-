---
// Leistungen: was man bei Silver Stage buchen kann – je Raum, nur belegte Angaben aus site.ts
import Base from "../../layouts/Base.astro";
import Photo from "../../components/Photo.astro";
import { ROOMS, PRICES, SITE, priceShown, euro } from "../../config/site";
import { ROOM_PHOTOS } from "../../assets/photos";
import { u } from "../../lib/url";
const isExample = !PRICES.confirmed && SITE.preview;
const verb: Record<string, string> = { tonstudio: "Aufnehmen", stageroom: "Proben und auftreten", lightroom: "Tanzen, singen, fotografieren" };
---
<Base title="Leistungen – Aufnahme, Proberaum, Tanz & Foto in München | Silver Stage" description="Was du bei Silver Stage in München-Sendling buchen kannst: Aufnahme-Sessions, Gesangs- und Sprachaufnahmen, Bandproben mit Bühne, Live-Mitschnitt, Tanztraining und Fotoshootings." current="/leistungen/">
  <section class="section lhero">
    <div class="wrap">
      <h1>Leistungen</h1>
      <p class="lead">Drei Räume, ein Haus: Hier siehst du, was du bei Silver Stage buchen kannst, was dabei ist und womit du rechnen kannst.</p>
      <nav class="jump" aria-label="Zu den Räumen springen">
        {ROOMS.map((r) => <a href={`#${r.key}`} data-room={r.key}><span class="dot" aria-hidden="true"></span>{r.name}<small>{verb[r.key]}</small></a>)}
      </nav>
      {isExample && <p class="note" role="note"><strong>Vorschau:</strong> Die Beträge sind Beispielpreise und noch nicht vom Studio bestätigt.</p>}
    </div>
  </section>

  {ROOMS.map((r, i) => {
    const items = PRICES.groups.find((g) => g.room === r.key)?.items ?? [];
    return (
      <section class:list={["section", "svc", { "section--sheet": i % 2 === 1 }]} id={r.key} data-room={r.key} aria-labelledby={`h-${r.key}`}>
        <div class="wrap svc-grid">
          <div class="svc-media plate"><Photo name={ROOM_PHOTOS[r.key].hero} sizes="(min-width: 960px) 40vw, 100vw" /></div>
          <div class="svc-body">
            <h2 id={`h-${r.key}`}><span class="rname">{r.name}</span> {verb[r.key]}</h2>
            <p class="lead">{r.short}</p>
            <ul class="cards">
              {items.map((it) => { const pr = priceShown(it); return (
                <li class="card">
                  <h3>{it.name}</h3>
                  <p>{it.detail}</p>
                  <p class="price">{pr === null ? "Preis auf Anfrage" : <>{euro(pr)}{" "}<span>{it.unit}{isExample && " · Beispielpreis"}</span></>}</p>
                </li>
              ); })}
            </ul>
            <h3 class="inc">Dabei im {r.name}</h3>
            <ul class="facts">{r.facts.map((f) => <li>{f}</li>)}</ul>
            <div class="btn-row">
              <a class="btn" href={u(`/kontakt/?raum=${r.key}`)}>{r.name} anfragen</a>
              <a class="btn btn--ghost" href={u(r.path)}>Mehr zum {r.name}</a>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <section class="section cta">
    <div class="wrap cta-inner">
      <h2>Nicht sicher, welcher Raum passt?</h2>
      <div class="btn-row">
        <a class="btn" href={u("/kontakt/")}>Vorhaben beschreiben</a>
        <a class="btn btn--ghost" href={u("/preise/")}>Alle Preise</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .lhero { padding-bottom: clamp(32px, 5vw, 64px); border-bottom: 2px solid var(--ink); }
  .lhero .wrap { display: grid; gap: 22px; }
  h1 { font-size: clamp(2.8rem, 1rem + 6vw, 6rem); font-weight: 880; font-stretch: 128%; line-height: 0.88; letter-spacing: -0.04em; }
  .jump { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 8px; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .jump a { position: relative; display: grid; grid-template-columns: auto 1fr; column-gap: 12px; align-items: center; padding: 18px 18px 16px; text-decoration: none; font: 850 var(--step-2) / 1.05 var(--font-display); font-stretch: 122%; letter-spacing: -0.02em; transition: background-color 0.2s var(--ease), color 0.2s var(--ease); }
  .jump a + a { border-left: 2px solid var(--ink); }
  .jump a:hover { background: var(--room); color: var(--on-room); }
  .jump a:hover small { color: var(--on-room-2); }
  .jump small { grid-column: 2; font: 500 var(--step--1) / 1.3 var(--font-body); color: var(--ink-2); letter-spacing: 0; }
  .dot { width: 16px; height: 16px; background: var(--room); box-shadow: inset 0 0 0 1px rgb(28 26 33 / 0.3); }
  .svc { scroll-margin-top: 80px; }
  .svc-grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(28px, 5vw, 72px); align-items: start; }
  .svc-media { position: sticky; top: 100px; aspect-ratio: 4 / 5; }
  .svc-media :global(img) { position: absolute; inset: 0; }
  .svc-body { display: grid; gap: 18px; }
  .svc h2 { font-size: var(--step-3); }
  .rname { display: block; font-size: clamp(2.6rem, 1rem + 5vw, 5rem); font-weight: 880; font-stretch: 128%; letter-spacing: -0.04em; line-height: 0.9; margin-bottom: 0.15em; }
  .rname::after { content: ""; display: block; width: 72px; height: 10px; margin-top: 14px; background: var(--room); box-shadow: inset 0 0 0 1px rgb(28 26 33 / 0.25); }
  .cards { list-style: none; margin: 8px 0 0; padding: 0; border-top: 2px solid var(--ink); }
  .card { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 24px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--rule-strong); }
  .card h3 { font-size: 1.2rem; }
  .card p { margin: 0; color: var(--ink-2); font-size: var(--step--1); grid-column: 1; }
  .card .price { grid-column: 2; grid-row: 1 / span 2; margin: 0; color: var(--ink); font: 880 1.4rem / 1.1 var(--font-display); font-stretch: 112%; text-align: right; font-variant-numeric: tabular-nums; }
  .card .price span { display: block; font: 400 var(--step--1) / 1.3 var(--font-body); color: var(--ink-2); }
  .inc { margin: 14px 0 0; font-size: 1.1rem; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 24px; }
  .facts li { display: flex; gap: 10px; }
  .facts li::before { content: ""; flex: none; width: 8px; height: 8px; margin-top: 0.6em; background: var(--room); box-shadow: inset 0 0 0 1px rgb(28 26 33 / 0.3); }
  .cta { border-top: 2px solid var(--ink); }
  .cta-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  @media (max-width: 960px) { .svc-grid { grid-template-columns: 1fr; } .svc-media { position: relative; top: 0; aspect-ratio: 16 / 9; } }
  @media (max-width: 680px) { .jump { grid-template-columns: 1fr; } .jump a + a { border-left: 0; border-top: 2px solid var(--ink); } .facts { grid-template-columns: 1fr; } .card { grid-template-columns: 1fr; } .card .price { grid-column: 1; grid-row: auto; text-align: left; margin-top: 6px; } }
  @media (max-width: 480px) { h1 { font-size: clamp(2.2rem, 0.6rem + 8vw, 2.8rem); font-stretch: 108%; } }
</style>
