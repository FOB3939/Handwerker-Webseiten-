---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import { getImage } from "astro:assets";
import { PHOTOS, type PhotoKey } from "../assets/photos";
import Icon from "../components/Icon.astro";
import Faq from "../components/Faq.astro";
import SoundCheck from "../components/SoundCheck.astro";
import HomeHero from "../components/HomeHero.astro";
import { ROOMS, CONTACT, PRICES, SITE, roomByKey, priceShown, euro } from "../config/site";
import { u } from "../lib/url";
const studio = roomByKey("tonstudio");
// Bildstrecke „Einblicke“ mit Großansicht (Format je Bild im Raster)
const gallery: { photo: PhotoKey; shape: string }[] = [
  { photo: "stageVeniceBuehne", shape: "a" },
  { photo: "lightSpots", shape: "b" },
  { photo: "tonRegie", shape: "c" },
  { photo: "tonMikrofon", shape: "d" },
  { photo: "lightDrums", shape: "e" },
  { photo: "yamahaPult", shape: "f" },
  { photo: "stageRackFunk", shape: "g" },
  { photo: "stagePultBlick", shape: "h" },
  { photo: "lightBackline", shape: "i" },
];
const large = Object.fromEntries(await Promise.all(gallery.map(async (g) => [g.photo, (await getImage({ src: PHOTOS[g.photo].src, width: 1672, format: "webp", quality: 78 })).src])));
// Konkrete Eckdaten statt Schlagworte (nur belegte Angaben aus site.ts)
const spec: Record<string, string> = { tonstudio: "32-Kanal-Analogpult", stageroom: "80 m² mit Bühne", lightroom: "55 m² mit Spiegelwand" };
// Einstiegspreis je Raum (günstigste Leistung pro Stunde) für die Preis-Vorschau
const fromPrice = Object.fromEntries(PRICES.groups.map((g) => {
  const hourly = g.items.filter((i) => i.unit === "pro Stunde").map((i) => priceShown(i)).filter((p): p is number => p !== null);
  return [g.room, hourly.length ? Math.min(...hourly) : null];
}));
const priceIsExample = !PRICES.confirmed && SITE.preview;
const fromText = (k: string) => (fromPrice[k] === null || fromPrice[k] === undefined ? "Preis auf Anfrage" : `ab ${euro(fromPrice[k]!)} pro Stunde`);
// Raumfinder „Was hast du vor?“ (Texte nur aus belegten Angaben)
const finder = [
  { key: "tonstudio", k: "Aufnehmen", s: "Song, Vocals, Podcast, Sprache", text: "Für Songs, Vocals, Podcasts und Sprachaufnahmen: 32-Kanal-Analogpult, Neumann TLM 49 und Shure SM7B." },
  { key: "stageroom", k: "Proben", s: "Band, Bühnenshow, Live-Mitschnitt", text: "Für Bandproben und Bühnenprogramme: 80&nbsp;m² mit Bühne, Licht, Konzertanlage und Monitoring. Live-Mitschnitt möglich." },
  { key: "lightroom", k: "Gestalten", s: "Tanz, Gesang, Foto & Video", text: "Für Tanz, Gesang, Foto und Video: 55&nbsp;m² mit Spiegelwand, farbigem Licht und hängender PA." },
] as const;
// Startbereich: ein Kanalzug je Raum (Stageroom mit dem Pult-Foto ist vorgewählt)
const heroPhoto = { tonstudio: "tonAufnahmeraum", stageroom: "stagePultBlick", lightroom: "lightBackline" } as const;
const heroChannels = finder.map((f) => ({
  key: f.key, name: roomByKey(f.key).name, path: roomByKey(f.key).path, photo: heroPhoto[f.key], alt: PHOTOS[heroPhoto[f.key]].alt,
  spec: spec[f.key], use: f.k, price: fromText(f.key) + (priceIsExample && fromPrice[f.key] != null ? " (Beispielpreis)" : ""),
}));
// Für wen
const who = [
  { room: "stageroom", t: "Bands & Musiker:innen", d: "Proben mit Bühne, Licht und Konzertanlage, auf Wunsch mit Live-Mitschnitt.", go: "Zum Stageroom" },
  { room: "tonstudio", t: "Sänger:innen & Rapper:innen", d: "Vocals über Neumann TLM 49 oder Shure SM7B im akustisch optimierten Raum.", go: "Zum Tonstudio" },
  { room: "tonstudio", t: "Podcasts & Sprecher:innen", d: "Sprachaufnahmen für Podcast, Hörspiel oder Werbung, klar und ohne störenden Hall.", go: "Zum Tonstudio" },
  { room: "lightroom", t: "Tanz, Foto & Video", d: "55 m² mit Spiegelwand und farbigem Licht für Training, Choreos und Shootings.", go: "Zum Lightroom" },
] as const;
// Häufige Fragen aus den belegten Antworten der Raumseiten
const faq = [
  { q: "Was kostet eine Session?", a: fromPrice.tonstudio == null
      ? "Das hängt von Raum, Dauer und Technik ab. Beschreib kurz dein Vorhaben, dann bekommst du ein konkretes Angebot."
      : `Das Tonstudio gibt es ${fromText("tonstudio")}, den Stageroom ${fromText("stageroom")} und den Lightroom ${fromText("lightroom")}, ganze Tage sind ebenfalls möglich.${priceIsExample ? " (Vorschau: Beispielpreise, noch nicht vom Studio bestätigt.)" : ""} Für dein Vorhaben bekommst du vorab ein konkretes Angebot.` },
  { q: "Ist jemand für die Technik da?", a: roomByKey("tonstudio").faq[1].a },
  { q: "Kann ich die Bandprobe aufnehmen lassen?", a: roomByKey("stageroom").faq[1].a },
  { q: "Kann ich auch Podcasts oder Sprachaufnahmen machen?", a: "Ja. Das Tonstudio ist für Musik-, Gesangs- und Sprachaufnahmen ausgelegt, also auch für Podcast, Hörspiel oder Werbung." },
  { q: "Wie groß sind die Räume?", a: "Der Stageroom hat 80 m² mit Bühne, der Lightroom 55 m² mit Spiegelwand. Das Tonstudio ist ein akustisch optimierter Aufnahmeraum." },
  { q: "Ist meine Anfrage schon eine Buchung?", a: "Nein. Wir melden uns mit einem Angebot und einem Terminvorschlag. Verbindlich wird es erst, wenn wir den Termin gemeinsam bestätigen." },
  { q: "Wann kann ich kommen?", a: CONTACT.hoursNote },
];
---
<Base
  title="Silver Stage – Tonstudio & Proberäume in München-Sendling"
  description="Tonstudio, Proberaum mit Bühne und Raum für Tanz & Fotografie in München-Sendling. Musik aufnehmen, proben und gestalten – jetzt Session anfragen."
  intro
  current="/"
>
  <!-- Einstieg: Plakat mit Line-up der drei Räume -->
  <HomeHero channels={heroChannels} />

  <!-- Überblick zum gewählten Raum (vom Line-up gesteuert) -->
  <section class="programm inked" id="programm" data-programm data-room="stageroom" aria-label="Der gewählte Raum im Überblick">
    {finder.map((f) => { const r = roomByKey(f.key); return (
      <div class="wrap prog" data-prog={f.key} hidden={f.key !== "stageroom"}>
        <div class="prog-head">
          <h2 class="prog-name">{r.name}</h2>
          <p class="prog-text">{f.text}</p>
          <div class="btn-row">
            <a class="btn" href={u(`/kontakt/?raum=${f.key}`)}>{r.name} anfragen</a>
            <a class="btn btn--ghost" href={u(r.path)}>Alles zum {r.name}</a>
          </div>
        </div>
        <div class="prog-col">
          <h3>Das kannst du hier machen</h3>
          <ul class="prog-uses">{r.uses.map((x) => <li><strong>{x.title}</strong> {x.text}</li>)}</ul>
          <h3>Ausstattung</h3>
          <ul class="prog-facts">{r.facts.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="prog-col">
          <h3>Preise{priceIsExample && <span class="prog-ex"> (Beispielpreise, noch nicht bestätigt)</span>}</h3>
          <ul class="prog-prices">
            {PRICES.groups.find((g) => g.room === f.key)!.items.map((it) => { const pr = priceShown(it); return <li><span>{it.name}</span><span class="prog-p">{pr === null ? "auf Anfrage" : `${euro(pr)} ${it.unit}`}</span></li>; })}
          </ul>
          <a class="link" href={u("/preise/")}>Alle Leistungen und Preise</a>
        </div>
      </div>
    ); })}
  </section>

  <!-- Für wen -->
  <section class="section" aria-labelledby="who-title">
    <div class="wrap who-grid">
      <div class="who-head">
        <h2 id="who-title">Für wen Silver Stage gemacht ist</h2>
        <p class="lead">Ob erste Demo oder fertiges Album, Bandprobe oder Choreo: Du bringst die Idee mit, wir den Raum und die Technik.</p>
      </div>
      <ul class="who">
        {who.map((w) => (
          <li data-room={w.room}>
            <a href={u(`/${w.room}/`)}>
              <h3>{w.t}</h3>
              <p>{w.d}</p>
              <span class="go"><span class="swatch" aria-hidden="true"></span>{w.go}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Studiotechnik: Ausstattung des Tonstudios auf gelber Fläche -->
  <section class="tech inked" data-room="tonstudio" aria-labelledby="tech-title">
    <div class="wrap tech-grid">
      <div class="tech-text">
        <h2 id="tech-title">Analog, wo es klingt. Digital, wo es hilft.</h2>
        <p class="lead">Ein akustisch optimierter Aufnahmeraum mit Technik, die du nicht zu Hause stehen hast.</p>
        <a class="link" href={u("/tonstudio/")}>Zum Tonstudio</a>
      </div>
      <figure class="tech-photo"><Photo name="tonRack" sizes="(min-width: 900px) 30vw, 100vw" /></figure>
      <ul class="tech-list" aria-label="Ausstattung Tonstudio">
        {studio.facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <!-- Bildstrecke mit Großansicht -->
  <section class="section gal-sec" aria-labelledby="gal-title">
    <div class="wrap">
      <div class="gal-head">
        <h2 id="gal-title">Einblicke</h2>
        <p class="lead">Bühne, Regie und Lichtraum, so wie du sie bei Silver Stage vorfindest. Tippe ein Bild an für die Großansicht.</p>
      </div>
      <ul class="wall">
        {gallery.map((g) => (
          <li class={`w-${g.shape}`}>
            <button type="button" class="zoom" data-zoom={large[g.photo]} data-alt={PHOTOS[g.photo].alt} aria-label={`Großansicht: ${PHOTOS[g.photo].alt}`}>
              <Photo name={g.photo} sizes="(min-width: 900px) 33vw, 50vw" decorative />
            </button>
          </li>
        ))}
      </ul>
    </div>
    <dialog class="lightbox" data-lightbox aria-label="Großansicht">
      <form method="dialog"><button class="lb-close" aria-label="Großansicht schließen"><Icon name="close" /></button></form>
      <img alt="" data-lb-img />
      <div class="lb-bar">
        <p class="lb-cap" data-lb-cap></p>
        <span class="lb-count" data-lb-count></span>
        <button type="button" class="lb-nav" data-lb-prev aria-label="Vorheriges Bild"><Icon name="chevron" class="lb-l" /></button>
        <button type="button" class="lb-nav" data-lb-next aria-label="Nächstes Bild"><Icon name="chevron" class="lb-r" /></button>
      </div>
    </dialog>
  </section>

  <!-- Mini-Spiel -->
  <SoundCheck />

  <!-- Ablauf (echte Reihenfolge) -->
  <section class="section" aria-labelledby="steps-title">
    <div class="wrap steps-grid">
      <h2 id="steps-title">So kommst du zu deiner Session</h2>
      <ol class="steps">
        <li><h3>Vorhaben beschreiben</h3><p class="muted">Schreib uns, was du aufnehmen, proben oder gestalten möchtest – und wann.</p></li>
        <li><h3>Details abstimmen</h3><p class="muted">Wir klären Raum, Dauer, Technik und dein individuelles Angebot.</p></li>
        <li><h3>Termin bestätigen</h3><p class="muted">Sobald alles passt, bestätigen wir deinen Termin verbindlich.</p></li>
      </ol>
    </div>
  </section>

  <!-- Einwände vor der Anfrage klären -->
  <section class="section section--sheet" aria-label="Häufige Fragen">
    <div class="wrap"><Faq items={faq} /></div>
  </section>

  <!-- Standort + Kontakt -->
  <section class="section visit" id="anfrage" aria-labelledby="visit-title">
    <div class="wrap">
      <h2 id="visit-title" class="addr">{CONTACT.street}</h2>
      <p class="city">{CONTACT.zip} {CONTACT.city}-Sendling</p>
      <div class="visit-grid">
        <div class="visit-info">
          <p class="lead">Erzähl uns von deinem Projekt. Wir melden uns mit einem individuellen Angebot und stimmen den Termin mit dir ab.</p>
          <div class="btn-row channels">
            <a class="btn btn--ghost" href={CONTACT.phoneHref}><Icon name="phone" />{CONTACT.phone}</a>
            <a class="btn btn--ghost" href={`mailto:${CONTACT.email}`}><Icon name="mail" />{CONTACT.email}</a>
            <a class="btn btn--ghost" href={CONTACT.routeUrl} target="_blank" rel="noopener"><Icon name="pin" />Route planen<span class="visually-hidden"> (öffnet Google Maps in neuem Tab)</span></a>
          </div>
          <p class="small muted">{CONTACT.hoursNote}</p>
        </div>
        <form class="quick" data-quick novalidate>
          <h3>Schnellanfrage</h3>
          <div class="row">
            <label>Name<input name="name" type="text" autocomplete="name" required /></label>
            <label>Telefon oder E-Mail<input name="contact" type="text" autocomplete="email" required /></label>
          </div>
          <div class="row">
            <label>Raum<select name="room"><option value="">Noch offen</option>{ROOMS.map((r) => <option>{r.name}</option>)}</select></label>
            <label>Wunschtermin<input name="date" type="date" /></label>
          </div>
          <label>Dein Vorhaben<textarea name="message" rows="3" required placeholder="Was möchtest du aufnehmen, proben oder gestalten? Wie viele Personen?"></textarea></label>
          <p class="err" data-quick-err role="alert"></p>
          <button class="btn" type="submit">Anfrage per E-Mail vorbereiten</button>
          <p class="note-s">Öffnet dein E-Mail-Programm mit deinen Angaben; gesendet wird erst, wenn du dort auf Senden tippst. Mehr Optionen im <a href={u("/kontakt/")}>ausführlichen Formular</a>. Hinweise zum <a href={u("/datenschutz/")}>Datenschutz</a>.</p>
        </form>
      </div>
    </div>
  </section>

  <a class="to-top" href="#inhalt" data-to-top aria-label="Nach oben"><Icon name="chevron" /></a>

  <!-- Schnellleiste am Handy, sobald der Startbereich verlassen ist -->
  <nav class="mbar" data-mbar aria-label="Schnellkontakt">
    <a href={CONTACT.phoneHref}><Icon name="phone" />Anrufen</a>
    <a href={CONTACT.routeUrl} target="_blank" rel="noopener"><Icon name="pin" />Route<span class="visually-hidden"> (öffnet Google Maps in neuem Tab)</span></a>
    <a class="pri" href={u("/kontakt/")}>Session anfragen</a>
  </nav>
</Base>

<style>
  /* ---------- Überblick (Druckfläche in der Raumfarbe) ---------- */
  .programm { padding-block: clamp(56px, 8vw, 112px); transition: background-color 0.5s var(--ease), color 0.5s var(--ease); }
  .prog { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: start; }
  .prog[hidden] { display: none; }
  .prog-head { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 20px clamp(28px, 4vw, 64px); align-items: end; padding-bottom: clamp(20px, 3vw, 40px); border-bottom: 2px solid currentColor; }
  .prog-head .prog-name { grid-column: 1 / -1; }
  .prog-head .btn-row { justify-self: end; }
  .prog-name { font-size: clamp(3rem, 1.2rem + 5.4vw, 6rem); font-weight: 880; font-stretch: 130%; line-height: 0.86; letter-spacing: -0.04em; }
  .prog-text { font-size: var(--step-1); line-height: 1.45; max-width: 34ch; }
  .prog-col { display: grid; gap: 12px; align-content: start; }
  .prog-col h3 { font-size: 1.05rem; padding-bottom: 8px; border-bottom: 2px solid currentColor; }
  .prog-col h3 + ul { margin-bottom: 18px; }
  .prog-ex { font: 400 var(--step--1) / 1.3 var(--font-body); color: var(--ink-2); }
  .prog-uses, .prog-facts, .prog-prices { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .prog-uses strong { font-weight: 700; }
  .prog-facts li { display: flex; gap: 10px; }
  .prog-facts li::before { content: ""; flex: none; width: 7px; height: 7px; margin-top: 0.62em; background: currentColor; }
  .prog-prices { gap: 0; }
  .prog-prices li { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--rule-strong); }
  .prog-p { white-space: nowrap; font-weight: 650; font-variant-numeric: tabular-nums; }
  @media (max-width: 900px) { .prog-head { grid-template-columns: minmax(0, 1fr); } .prog-head .btn-row { justify-self: start; } }
  @media (max-width: 680px) { .prog { grid-template-columns: minmax(0, 1fr); } .prog-name { font-size: clamp(2.4rem, 0.4rem + 10vw, 3.4rem); font-stretch: 115%; } .prog-prices li { flex-direction: column; gap: 2px; } }

  /* ---------- Für wen ---------- */
  .who-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .who-head { display: grid; gap: 20px; position: sticky; top: 110px; }
  .who { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .who a { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 6px 28px; padding: 24px 0; border-bottom: 1px solid var(--rule-strong); text-decoration: none; }
  .who h3 { font-size: clamp(1.3rem, 1rem + 1vw, 1.85rem); font-stretch: 112%; font-weight: 780; line-height: 1.02; grid-row: span 2; }
  .who p { color: var(--ink-2); }
  .who .go { display: inline-flex; align-items: center; gap: 10px; font-weight: 650; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .who a:hover h3 { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 8px; text-decoration-color: var(--room); }
  @media (max-width: 900px) { .who-grid { grid-template-columns: 1fr; } .who-head { position: static; } }
  @media (max-width: 600px) { .who a { grid-template-columns: 1fr; } .who h3 { grid-row: auto; } }

  /* ---------- Technik ---------- */
  .tech { padding-block: clamp(64px, 9vw, 128px); }
  .tech-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.8fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .tech-text { display: grid; gap: 20px; justify-items: start; }
  .tech-text .lead { color: var(--on-room); }
  .tech-photo { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; box-shadow: 0 22px 40px -18px rgb(28 26 33 / 0.55); }
  .tech-photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tech-list { list-style: none; margin: 0; padding: 0; border-top: 2px solid currentColor; }
  .tech-list li { padding: 14px 0; border-bottom: 1px solid var(--rule-strong); font: 750 var(--step-1) / 1.2 var(--font-display); font-stretch: 108%; }
  @media (max-width: 960px) { .tech-grid { grid-template-columns: 1fr 1fr; } .tech-text { grid-column: 1 / -1; } }
  @media (max-width: 600px) { .tech-grid { grid-template-columns: 1fr; } .tech-photo { aspect-ratio: 16 / 10; } }

  /* ---------- Einblicke ---------- */
  .gal-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 48px; align-items: end; margin-bottom: clamp(28px, 4vw, 48px); }
  .gal-head h2 { font-size: clamp(3rem, 1rem + 7vw, 6rem); font-stretch: 130%; font-weight: 880; letter-spacing: -0.04em; line-height: 0.86; }
  .wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: clamp(120px, 13vw, 190px); gap: 10px; }
  .wall li { min-width: 0; }
  .w-a { grid-column: span 4; grid-row: span 2; } .w-b { grid-column: span 2; grid-row: span 3; }
  .w-c, .w-d { grid-column: span 2; grid-row: span 2; }
  .w-e, .w-f { grid-column: span 2; grid-row: span 2; } .w-g { grid-column: span 2; grid-row: span 2; }
  .w-h { grid-column: span 4; grid-row: span 2; } .w-i { grid-column: span 2; grid-row: span 2; }
  .zoom { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; overflow: hidden; background: var(--ink); cursor: zoom-in; }
  .zoom :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .zoom:hover :global(img), .zoom:focus-visible :global(img) { transform: scale(1.035); }
  @media (max-width: 760px) {
    .gal-head { grid-template-columns: 1fr; }
    .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 150px; }
    .wall li { grid-column: span 1 !important; grid-row: span 1 !important; }
    .wall .w-a, .wall .w-h { grid-column: span 2 !important; grid-row: span 2 !important; }
  }
  .lightbox { width: min(96vw, 1400px); max-height: 94vh; padding: 0; border: 0; background: #1c1a21; color: #eceaf0; overflow: visible; }
  .lightbox::backdrop { background: rgb(28 26 33 / 0.9); }
  .lightbox img { display: block; width: 100%; max-height: 78vh; object-fit: contain; background: #000; }
  .lb-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; padding: 10px 12px 10px 20px; }
  .lb-cap { flex: 1 1 260px; font-size: var(--step--1); color: #d9d7de; }
  .lb-count { font-variant-numeric: tabular-nums; font-size: var(--step--1); color: #b5b2bd; }
  .lb-nav, .lb-close { width: 48px; height: 48px; display: grid; place-items: center; border: 2px solid #eceaf0; border-radius: 3px; background: #1c1a21; color: #eceaf0; cursor: pointer; }
  .lb-nav:hover, .lb-close:hover { background: var(--yellow); color: #1c1a21; border-color: var(--yellow); }
  .lb-nav :global(svg), .lb-close :global(svg) { width: 22px; height: 22px; }
  .lb-nav :global(.lb-l) { transform: rotate(90deg); } .lb-nav :global(.lb-r) { transform: rotate(-90deg); }
  .lb-close { position: absolute; top: 10px; right: 10px; z-index: 2; }
  .lightbox :focus-visible { outline-color: var(--yellow); }

  /* ---------- Ablauf ---------- */
  .steps-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.5fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .steps { list-style: none; margin: 0; padding: 0; counter-reset: s; border-top: 2px solid var(--ink); }
  .steps li { counter-increment: s; display: grid; grid-template-columns: auto 1fr; column-gap: 24px; row-gap: 6px; padding: 22px 0; border-bottom: 1px solid var(--rule-strong); }
  .steps li::before { content: counter(s); grid-row: span 2; font: 880 clamp(2.6rem, 1.6rem + 3vw, 4rem) / 0.85 var(--font-display); font-stretch: 130%; min-width: 1.2em; }
  .steps h3 { font-size: var(--step-2); font-stretch: 112%; font-weight: 780; }
  @media (max-width: 860px) { .steps-grid { grid-template-columns: 1fr; } }

  /* ---------- Besuch + Schnellanfrage ---------- */
  .visit { border-top: 2px solid var(--ink); }
  .visit .addr { font-size: clamp(2.1rem, 0.4rem + 8vw, 6rem); font-stretch: 130%; font-weight: 880; line-height: 0.88; letter-spacing: -0.04em; }
  @media (max-width: 420px) { .visit .addr { font-stretch: 108%; } }
  .city { font: 750 var(--step-2) / 1.2 var(--font-display); font-stretch: 115%; margin-top: 10px; }
  .visit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: start; margin-top: clamp(36px, 5vw, 64px); }
  .visit-info { display: grid; gap: 22px; justify-items: start; }
  .channels { flex-direction: column; align-items: stretch; width: min(100%, 380px); }
  .channels .btn { justify-content: flex-start; overflow-wrap: anywhere; }
  .quick { display: grid; gap: 14px; padding: clamp(20px, 3vw, 32px); background: var(--paper-3); border: 2px solid var(--ink); box-shadow: 0 20px 40px -24px rgb(28 26 33 / 0.45); }
  .quick h3 { font-size: var(--step-2); font-stretch: 115%; font-weight: 800; }
  .quick .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .quick label { display: grid; gap: 6px; font-weight: 650; font-size: var(--step--1); }
  .quick input, .quick select, .quick textarea { width: 100%; min-height: 48px; padding: 12px 14px; border-radius: 3px; border: 1.5px solid var(--ink); background: #fff; color: var(--ink); font: 400 1rem / 1.4 var(--font-body); }
  .quick textarea { min-height: 96px; resize: vertical; }
  .quick ::placeholder { color: #66636d; }
  .quick .err { color: var(--error); font-weight: 650; font-size: var(--step--1); min-height: 1.2em; }
  .note-s { font-size: var(--step--1); color: var(--ink-2); }
  .note-s a { color: var(--ink); }
  @media (max-width: 860px) { .visit-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .quick .row { grid-template-columns: 1fr; } }

  /* ---------- Nach oben + Schnellleiste am Handy ---------- */
  .to-top { position: fixed; right: 16px; bottom: 20px; z-index: 61; width: 48px; height: 48px; display: grid; place-items: center;
    background: var(--ink); color: var(--paper); border-radius: 3px; opacity: 0; transform: translateY(12px); pointer-events: none; transition: opacity 0.3s var(--ease), transform 0.3s var(--ease); }
  .to-top :global(svg) { width: 22px; height: 22px; transform: rotate(180deg); }
  .to-top.show { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:hover { background: var(--yellow); color: #1c1a21; }
  @media (max-width: 760px) { .to-top { bottom: calc(84px + env(safe-area-inset-bottom, 0px)); right: 12px; } }
  .mbar { display: none; }
  @media (max-width: 760px) {
    .mbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px)); background: var(--paper); border-top: 2px solid var(--ink); transform: translateY(110%); transition: transform 0.35s var(--ease); }
    .mbar.show { transform: none; }
    .mbar a { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; border-radius: 3px; border: 2px solid var(--ink); color: var(--ink); text-decoration: none; font: 700 0.9rem / 1 var(--font-display); font-stretch: 100%; white-space: nowrap; padding: 0 6px; }
    .mbar a.pri { background: var(--ink); color: var(--paper); }
    .mbar :global(svg) { width: 18px; height: 18px; }
    :global(.footer) { padding-bottom: 84px; }
  }
</style>

<script>
  // Nach oben
  const toTop = document.querySelector<HTMLElement>("[data-to-top]");
  if (toTop) {
    const upd = () => toTop.classList.toggle("show", scrollY > innerHeight * 1.5);
    addEventListener("scroll", upd, { passive: true }); upd();
    toTop.addEventListener("click", (e) => {
      e.preventDefault();
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      scrollTo({ top: 0, behavior: calm ? "auto" : "smooth" });
      document.querySelector<HTMLElement>("#inhalt")?.focus({ preventScroll: true });
    });
  }
  // Schnellanfrage: bereitet eine E-Mail vor (kein Versand ohne Zutun, keine vorgetäuschte Erfolgsmeldung)
  const quick = document.querySelector<HTMLFormElement>("[data-quick]");
  quick?.addEventListener("submit", (e) => {
    e.preventDefault();
    const v = (n: string) => (quick.elements.namedItem(n) as HTMLInputElement).value.trim();
    const err = quick.querySelector<HTMLElement>("[data-quick-err]")!;
    if (!v("name") || !v("contact") || !v("message")) { err.textContent = "Bitte Name, Kontakt und dein Vorhaben ausfüllen."; return; }
    err.textContent = "";
    const body = `Hallo Silver Stage,\n\n${v("message")}\n\nRaum: ${v("room") || "noch offen"}\nWunschtermin: ${v("date") || "flexibel"}\n\nName: ${v("name")}\nErreichbar unter: ${v("contact")}`;
    location.href = `mailto:info@silver-stage.de?subject=${encodeURIComponent("Anfrage " + (v("room") || "Session") + " – " + v("name"))}&body=${encodeURIComponent(body)}`;
  });
  // Schnellleiste am Handy erst nach dem Startbereich einblenden
  const mbar = document.querySelector<HTMLElement>("[data-mbar]"), heroEl = document.querySelector<HTMLElement>("[data-hero]");
  if (mbar && heroEl && "IntersectionObserver" in window) new IntersectionObserver(([e]) => mbar.classList.toggle("show", !e.isIntersecting), { threshold: 0.15 }).observe(heroEl);
  // Großansicht der Bildstrecke
  const lb = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  if (lb) {
    const img = lb.querySelector<HTMLImageElement>("[data-lb-img]")!, cap = lb.querySelector<HTMLElement>("[data-lb-cap]")!;
    const btns = [...document.querySelectorAll<HTMLButtonElement>("[data-zoom]")], cnt = lb.querySelector<HTMLElement>("[data-lb-count]")!;
    let opener: HTMLElement | null = null, cur = 0;
    const show = (n: number) => { cur = (n + btns.length) % btns.length; const b = btns[cur]; img.src = b.dataset.zoom!; img.alt = b.dataset.alt!; cap.textContent = b.dataset.alt!; cnt.textContent = `${cur + 1} / ${btns.length}`; };
    btns.forEach((b, k) => b.addEventListener("click", () => { opener = b; show(k); lb.showModal(); }));
    lb.querySelector("[data-lb-prev]")!.addEventListener("click", () => show(cur - 1));
    lb.querySelector("[data-lb-next]")!.addEventListener("click", () => show(cur + 1));
    lb.addEventListener("keydown", (e) => { if (e.key === "ArrowLeft") show(cur - 1); if (e.key === "ArrowRight") show(cur + 1); });
    let x0: number | null = null;
    lb.addEventListener("touchstart", (e) => (x0 = e.touches[0].clientX), { passive: true });
    lb.addEventListener("touchend", (e) => { if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1)); x0 = null; });
    lb.addEventListener("click", (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener("close", () => opener?.focus({ preventScroll: true }));
  }
</script>
