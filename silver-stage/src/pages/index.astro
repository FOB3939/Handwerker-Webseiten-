---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import { getImage } from "astro:assets";
import { PHOTOS, ROOM_PHOTOS, type PhotoKey } from "../assets/photos";
import Icon from "../components/Icon.astro";
import Faq from "../components/Faq.astro";
import { ROOMS, CONTACT, PRICES, SITE, roomByKey, priceShown, euro } from "../config/site";
import { u } from "../lib/url";
const studio = roomByKey("tonstudio");
const keys = ["D", "F", "J", "K"];
// Wechselnde Titelbilder: je Bild ein Raum, Bildunterschrift verlinkt die Raumseite
const slides: { photo: PhotoKey; room: "tonstudio" | "stageroom" | "lightroom"; caption: string }[] = [
  { photo: "stageBuehneFront", room: "stageroom", caption: "Stageroom – Bühne, Licht und Konzertanlage" },
  { photo: "tonAufnahmeraum", room: "tonstudio", caption: "Tonstudio – Aufnahmeraum mit Blick in die Regie" },
  { photo: "lightBackline", room: "lightroom", caption: "Lightroom – Spiegelwand und farbiges Licht" },
  { photo: "stageVeniceBuehne", room: "stageroom", caption: "Stageroom – MIDAS Venice am Bühnenrand" },
];
// Bildstrecke mit Großansicht
const gallery: { photo: PhotoKey; shape: string }[] = [
  { photo: "stageVeniceBuehne", shape: "wide" },
  { photo: "lightSpots", shape: "tall" },
  { photo: "tonRegie", shape: "" },
  { photo: "tonMikrofon", shape: "" },
  { photo: "lightDrums", shape: "" },
  { photo: "yamahaPult", shape: "" },
  { photo: "stageRackFunk", shape: "" },
  { photo: "stagePultBlick", shape: "wide" },
  { photo: "lightBackline", shape: "" },
];
const large = Object.fromEntries(await Promise.all(gallery.map(async (g) => [g.photo, (await getImage({ src: PHOTOS[g.photo].src, width: 1672, format: "webp", quality: 78 })).src])));
// Konkrete Eckdaten statt Schlagworte (nur belegte Angaben aus site.ts)
const spec: Record<string, string> = { tonstudio: "32-Kanal-Analogpult", stageroom: "80 m² mit Bühne", lightroom: "55 m² mit Spiegelwand" };
// Einstiegspreis je Raum (günstigste Leistung pro Stunde) für die Preis-Vorschau
const fromPrice = Object.fromEntries(PRICES.groups.map((g) => {
  const hourly = g.items.filter((i) => i.unit === "pro Stunde").map((i) => priceShown(i)).filter((p): p is number => p !== null);
  return [g.room, hourly.length ? Math.min(...hourly) : null];
}));
const priceIsExample = !PRICES.confirmed && SITE.preview;
// Häufige Fragen aus den belegten Antworten der Raumseiten
const faq = [
  { q: "Was kostet eine Session?", a: "Das hängt von Raum, Dauer und Technik ab. Die Leistungen mit Preisen findest du auf der Preisseite; für dein Vorhaben bekommst du vorab ein konkretes Angebot." },
  { q: "Ist jemand für die Technik da?", a: roomByKey("tonstudio").faq[1].a },
  { q: "Kann ich die Bandprobe aufnehmen lassen?", a: roomByKey("stageroom").faq[1].a },
  { q: "Wie groß sind die Räume?", a: "Der Stageroom hat 80 m² mit Bühne, der Lightroom 55 m² mit Spiegelwand. Das Tonstudio ist ein akustisch optimierter Aufnahmeraum." },
  { q: "Wann kann ich kommen?", a: CONTACT.hoursNote },
];
---
<Base
  title="Silver Stage – Tonstudio & Proberäume in München-Sendling"
  description="Tonstudio, Proberaum mit Bühne und Raum für Tanz & Fotografie in München-Sendling. Musik aufnehmen, proben und gestalten – jetzt Session anfragen."
  intro
  current="/"
>
  <!-- Einstieg: wechselnde Fotos der Räume -->
  <section class="hero" aria-labelledby="hero-title" data-hero>
    <div class="slides" data-slides>
      {slides.map((sl, i) => (
        <figure class:list={["slide", { "is-active": i === 0, "seen": i === 0 }]} data-slide aria-hidden={i === 0 ? undefined : "true"}>
          <Photo name={sl.photo} eager={i === 0} sizes="100vw" />
        </figure>
      ))}
      <span class="shade" aria-hidden="true"></span>
    </div>
    <div class="wrap hero-inner">
      <h1 id="hero-title" class="rise"><span><span>Dein Sound.</span></span><span><span class="metal">Dein Raum.</span></span></h1>
      <p class="lead">Tonstudio, Bühne und Lichtraum unter einem Dach in München-Sendling.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={u("/kontakt/")}>Session anfragen</a>
        <a class="btn btn--ghost" href="#raeume">Räume ansehen</a>
      </div>
    </div>
    <div class="wrap hero-foot">
      <p class="caption" aria-live="polite">
        {slides.map((sl, i) => <a href={u(`/${sl.room}/`)} data-room={sl.room} data-caption hidden={i !== 0}><span class="dot" aria-hidden="true"></span>{sl.caption}</a>)}
      </p>
      <div class="ctrl" role="group" aria-label="Fotos im Startbereich">
        {slides.map((sl, i) => (
          <button type="button" class="seg" data-seg aria-label={`Foto ${i + 1} von ${slides.length}: ${sl.caption}`} aria-current={i === 0 ? "true" : undefined}><span></span></button>
        ))}
        <button type="button" class="pause" data-pause aria-pressed="false"><span class="visually-hidden" data-pause-label>Fotowechsel anhalten</span><span class="pause-ico" aria-hidden="true"></span></button>
      </div>
    </div>
  </section>

  <!-- Räume: aufklappende Lichtbahnen -->
  <section class="section rooms-sec" id="raeume" aria-labelledby="rooms-title">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 id="rooms-title">Drei Räume.<br />Drei Lichtstimmungen.</h2>
        <p class="lead">Jeder Raum hat sein eigenes Licht und seinen eigenen Zweck: aufnehmen im Tonstudio, proben auf der Bühne, tanzen und fotografieren im Lightroom.</p>
      </div>
      <ul class="lanes">
        {ROOMS.map((r, i) => (
          <li class:list={["lane", { "is-open": i === 0 }]} data-room={r.key} data-lane>
            <Photo name={ROOM_PHOTOS[r.key].hero} class="lane-photo" sizes="(min-width: 900px) 60vw, 100vw" decorative />
            <span class="lane-name" aria-hidden="true">{r.name}</span>
            <div class="lane-body">
              <p class="label">{r.kicker}</p>
              <h3><a href={u(r.path)}>{r.name}</a></h3>
              <p class="lane-short">{r.short}</p>
              <ul class="lane-facts">{r.facts.slice(0, 4).map((f) => <li>{f}</li>)}</ul>
              <div class="btn-row">
                <a class="btn btn--primary btn--sm" href={u(r.path)}>{r.name} ansehen</a>
                <a class="btn btn--ghost btn--sm" href={u(`/kontakt/?raum=${r.key}`)}>Anfragen</a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Studiotechnik als Rack -->
  <section class="section section--alt" aria-labelledby="tech-title" data-room="tonstudio">
    <div class="wrap tech">
      <div class="tech-text" data-reveal>
        <h2 id="tech-title">Analog, wo es klingt. Digital, wo es hilft.</h2>
        <p class="lead">Ein akustisch optimierter Aufnahmeraum mit Technik, die du nicht zu Hause stehen hast.</p>
        <figure class="tech-photo"><Photo name="tonRack" sizes="(min-width: 860px) 45vw, 100vw" /></figure>
        <a class="link-arrow" href={u("/tonstudio/")}>Zum Tonstudio</a>
      </div>
      <ul class="rack" aria-label="Ausstattung Tonstudio">
        {studio.facts.map((f, i) => (
          <li style={`--i:${i}`}>
            <span class="screw" aria-hidden="true"></span>
            <span class="unit">{f}</span>
            <span class="led" aria-hidden="true"></span>
            <span class="screw" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Bildstrecke: 3D-Tunnel beim Scrollen (nach 21st.dev „Perspective Tunnel Hero“, ohne React nachgebaut).
       Ohne JS oder bei reduzierter Bewegung bleibt es ein normales Bildraster. -->
  <section class="tunnel-sec" aria-labelledby="gal-title" data-tunnel>
    <div class="tunnel-sticky">
      <div class="wrap head tunnel-title" data-tunnel-title>
        <h2 id="gal-title">Einblicke</h2>
        <p class="lead">Bühne, Regie und Lichtraum, so wie du sie bei Silver Stage vorfindest. Tippe ein Bild an für die Großansicht.</p>
      </div>
      <ul class="bento wrap" data-tunnel-stage>
        {gallery.map((g) => (
          <li class={g.shape} data-card>
            <button type="button" class="zoom" data-zoom={large[g.photo]} data-alt={PHOTOS[g.photo].alt} aria-label={`Großansicht: ${PHOTOS[g.photo].alt}`}>
              <Photo name={g.photo} sizes="(min-width: 900px) 33vw, 100vw" decorative />
            </button>
          </li>
        ))}
      </ul>
      <p class="tunnel-hint" aria-hidden="true" data-tunnel-hint>Scrollen, um durch die Räume zu fliegen</p>
    </div>
    <dialog class="lightbox" data-lightbox aria-label="Großansicht">
      <form method="dialog"><button class="lb-close" aria-label="Großansicht schließen">×</button></form>
      <img alt="" data-lb-img />
      <p class="lb-cap" data-lb-cap></p>
    </dialog>
  </section>

  <!-- Ablauf (echte Reihenfolge) -->
  <section class="section" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title" class="steps-title" data-reveal>So kommst du zu deiner Session</h2>
      <ol class="steps">
        <li><span class="num" aria-hidden="true">1</span><h3>Vorhaben beschreiben</h3><p class="muted">Schreib uns, was du aufnehmen, proben oder gestalten möchtest – und wann.</p></li>
        <li><span class="num" aria-hidden="true">2</span><h3>Details abstimmen</h3><p class="muted">Wir klären Raum, Dauer, Technik und dein individuelles Angebot.</p></li>
        <li><span class="num" aria-hidden="true">3</span><h3>Termin bestätigen</h3><p class="muted">Sobald alles passt, bestätigen wir deinen Termin verbindlich.</p></li>
      </ol>
    </div>
  </section>

  <!-- Beat Stage -->
  <section class="teaser" aria-labelledby="teaser-title">
    <div class="wrap teaser-inner">
      <div class="keys" aria-hidden="true">
        {keys.map((k, i) => <span class="key" style={`--k:${i}`}>{k}</span>)}
      </div>
      <div class="teaser-text">
        <h2 id="teaser-title">Triffst du den Takt?</h2>
        <p class="lead">Beat Stage, unser Rhythmusspiel im Browser: vier Pads, 30 Sekunden, 100 BPM. Ohne Anmeldung – Ton erst, wenn du startest.</p>
        <a class="btn btn--primary" href={u("/beat-stage/")}>Beat Stage spielen</a>
      </div>
    </div>
  </section>

  <!-- Preise auf einen Blick -->
  <section class="section" aria-labelledby="prices-title">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 id="prices-title">Preise auf einen Blick</h2>
        <p class="lead">Stundenweise oder als ganzer Tag. Alle Leistungen und Preise stehen auf der Preisseite.</p>
      </div>
      <ul class="from-list">
        {ROOMS.map((r) => (
          <li data-room={r.key}>
            <a href={u("/preise/")} class="from-card">
              <span class="label">{r.kicker}</span>
              <span class="from-name">{r.name}</span>
              <span class="from-price">{fromPrice[r.key] === null ? "auf Anfrage" : <><small>ab</small> {euro(fromPrice[r.key]!)}{" "}<small>pro Stunde</small></>}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="from-foot">
        <a class="btn btn--primary" href={u("/preise/")}>Alle Leistungen und Preise</a>
        {priceIsExample && <p class="small muted">Vorschau: Beispielpreise, noch nicht vom Studio bestätigt.</p>}
      </div>
    </div>
  </section>

  <!-- Einwände vor der Anfrage klären -->
  <section class="section section--alt" aria-label="Häufige Fragen">
    <div class="wrap"><Faq items={faq} /></div>
  </section>

  <!-- Standort + Kontakt -->
  <section class="section visit" aria-labelledby="visit-title">
    <div class="wrap">
      <p class="label label--plain muted">So findest du uns</p>
      <h2 id="visit-title" class="addr metal">{CONTACT.street}</h2>
      <p class="city">{CONTACT.zip} {CONTACT.city}-Sendling</p>
      <div class="visit-grid">
        <div>
          <p class="lead">Erzähl uns von deinem Projekt – wir melden uns mit einem individuellen Angebot. {CONTACT.hoursNote}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={u("/kontakt/")}>Session anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.phoneHref}><Icon name="phone" />{CONTACT.phone}</a>
          <a class="btn btn--ghost" href={CONTACT.routeUrl} target="_blank" rel="noopener"><Icon name="pin" />Route planen<span class="visually-hidden"> (öffnet Google Maps in neuem Tab)</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Einstieg ---------- */
  .hero { position: relative; min-height: calc(100svh - 76px); display: grid; grid-template-rows: 1fr auto; overflow: hidden; background: #07080b; isolation: isolate; }
  .slides { position: absolute; inset: 0; z-index: -1; }
  .slide { position: absolute; inset: 0; margin: 0; opacity: 0; transition: opacity 1.4s var(--ease); }
  .slide.is-active { opacity: 1; }
  /* Weitere Fotos erst laden, kurz bevor sie gezeigt werden (lazy + display:none lädt nicht) */
  .slide:not(.seen) { display: none; }
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); }
  .slide.is-active :global(img) { animation: kenburns 9s cubic-bezier(0.2, 0.5, 0.3, 1) forwards; }
  @keyframes kenburns { from { transform: scale(1.12) translate3d(1.5%, 1%, 0); } to { transform: scale(1.02) translate3d(0, 0, 0); } }
  .shade { position: absolute; inset: 0; background:
      linear-gradient(90deg, rgb(7 8 11 / 0.86) 0%, rgb(7 8 11 / 0.55) 45%, rgb(7 8 11 / 0.12) 78%),
      linear-gradient(0deg, rgb(7 8 11 / 0.9) 0%, transparent 38%),
      linear-gradient(180deg, rgb(7 8 11 / 0.5) 0%, transparent 22%); }

  .hero-inner { align-self: end; display: grid; gap: 26px; justify-items: start; padding-block: clamp(96px, 16vh, 180px) clamp(32px, 6vh, 64px); }
  .hero h1 { font-size: clamp(3.4rem, 1.2rem + 9.6vw, 11rem); line-height: 0.9; font-weight: 300; letter-spacing: -0.045em; }
  .hero h1 > span { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .hero h1 > span > span { display: inline-block; }
  .js .rise > span > span { transform: translateY(110%); transition: transform 1.1s cubic-bezier(0.2, 0.75, 0.15, 1); }
  .js .rise > span:nth-child(2) > span { transition-delay: 0.12s; }
  .js .hero.ready .rise > span > span { transform: none; }
  .js .hero.no-rise .rise > span > span { transition: none; }
  .hero .lead { color: #d9dde4; max-width: 36ch; text-shadow: 0 1px 16px rgb(0 0 0 / 0.6); }

  .hero-foot { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 18px 26px; border-top: 1px solid rgb(242 243 245 / 0.18); }
  .caption { margin: 0; min-height: 44px; display: flex; align-items: center; }
  .caption a { display: inline-flex; align-items: center; gap: 10px; color: #e6e9ee; text-decoration: none; font-size: var(--step--1); min-height: 44px; }
  .caption a[hidden] { display: none; }
  .caption a:hover { text-decoration: underline; }
  .caption .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--room); box-shadow: 0 0 12px var(--room); }
  .ctrl { display: flex; align-items: center; gap: 6px; }
  .seg { width: 44px; height: 44px; padding: 0; background: none; border: 0; cursor: pointer; display: grid; align-items: center; }
  .seg span { display: block; height: 2px; background: rgb(242 243 245 / 0.28); border-radius: 2px; overflow: hidden; position: relative; }
  .seg span::after { content: ""; position: absolute; inset: 0; background: var(--ink); transform: scaleX(0); transform-origin: left; }
  .seg[aria-current="true"] span::after { animation: fill var(--slide, 6.5s) linear forwards; }
  .hero.paused .seg[aria-current="true"] span::after, .hero.static .seg[aria-current="true"] span::after { animation: none; transform: scaleX(1); }
  @keyframes fill { to { transform: scaleX(1); } }
  .pause { width: 44px; height: 44px; margin-left: 6px; border-radius: 50%; border: 1px solid rgb(242 243 245 / 0.3); background: rgb(7 8 11 / 0.4); color: var(--ink); cursor: pointer; display: grid; place-items: center; }
  .pause-ico { width: 10px; height: 12px; border-inline: 3px solid currentColor; }
  .hero.paused .pause-ico { width: 0; height: 0; border-inline: 0; border-left: 10px solid currentColor; border-block: 6px solid transparent; margin-left: 3px; }
  .hero.static .pause { display: none; }
  /* Reduzierte Bewegung: Fotos wechseln weiter per Überblenden (pausierbar), aber ohne Zoom */
  @media (prefers-reduced-motion: reduce) { .slide :global(img), .slide.is-active :global(img) { animation: none; transform: none; } .js .rise > span > span { transform: none; transition: none; } }
  @media (max-width: 640px) {
    .hero-inner .btn-row { flex-direction: column; align-items: flex-start; }
    .hero-foot { flex-direction: column; align-items: flex-start; gap: 4px; }
    .shade { background: linear-gradient(0deg, rgb(7 8 11 / 0.94) 12%, rgb(7 8 11 / 0.62) 60%, rgb(7 8 11 / 0.4) 100%); }
    .slide :global(img) { object-position: 50% 62%; }
  }

  /* ---------- Räume ---------- */
  .head { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: end; gap: 32px; margin-bottom: clamp(40px, 6vw, 72px); }
  @media (max-width: 860px) { .head { grid-template-columns: 1fr; } }

  .lanes { list-style: none; margin: 0; padding: 0; display: flex; gap: 12px; height: clamp(560px, 72vh, 700px); }
  .lane { position: relative; flex: 1; min-width: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); transition: flex-grow 0.7s var(--ease), border-color 0.4s; }
  .lane.is-open { flex-grow: 3.2; border-color: color-mix(in srgb, var(--room) 40%, transparent); }
  .lane :global(picture), .lane :global(.lane-photo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease), filter 0.6s; }
  .lane :global(.lane-photo) { filter: saturate(0.75) brightness(0.8); }
  .lane.is-open :global(.lane-photo) { filter: none; transform: scale(1.03); }
  .lane::before { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(180deg, color-mix(in srgb, var(--room) 18%, transparent), transparent 40%); mix-blend-mode: soft-light; }
  .lane-name { z-index: 1; text-shadow: 0 2px 20px rgb(0 0 0 / 0.7); position: absolute; left: 22px; bottom: 26px; writing-mode: vertical-rl; transform: rotate(180deg); font: 300 clamp(2.4rem, 1.6rem + 2vw, 3.6rem) / 1 var(--font-display); letter-spacing: -0.02em; color: var(--room); transition: opacity 0.3s; }
  .lane.is-open .lane-name { opacity: 0; }
  .lane-body { z-index: 2; position: absolute; inset: auto 0 0 0; display: grid; gap: 14px; justify-items: start; padding: clamp(24px, 3vw, 40px); background: linear-gradient(180deg, transparent, rgb(11 13 18 / 0.88) 34%); opacity: 0; transform: translateY(12px); transition: opacity 0.35s, transform 0.5s var(--ease); min-width: 420px; }
  .lane.is-open .lane-body { opacity: 1; transform: none; transition-delay: 0.25s; }
  .lane h3 { font: 300 var(--step-3) / 1 var(--font-display); letter-spacing: -0.03em; }
  .lane h3 a { text-decoration: none; }
  .lane h3 a::after { content: ""; position: absolute; inset: 0; z-index: 0; }
  .lane-body .btn-row, .lane-body .btn { position: relative; z-index: 1; }
  .lane-short { max-width: 44ch; color: var(--ink-2); }
  .lane-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lane-facts li { border: 1px solid var(--line-strong); border-radius: 99px; padding: 5px 12px; font-size: var(--step--1); background: rgb(13 15 20 / 0.5); }
  @media (max-width: 900px) {
    .lanes { flex-direction: column; height: auto; }
    .lane, .lane.is-open { flex: none; min-height: 460px; }
    .lane-name { display: none; }
    .lane-body, .lane.is-open .lane-body { opacity: 1; transform: none; min-width: 0; }
  }

  /* ---------- Rack ---------- */
  .tech { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .tech-text { display: grid; gap: 24px; justify-items: start; }
  .tech-photo { margin: 8px 0 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .tech-photo :global(img) { width: 100%; height: auto; display: block; }
  .rack { list-style: none; margin: 0; padding: 14px; display: grid; gap: 6px; border-radius: 10px; background: #08090c; border: 1px solid var(--line); box-shadow: inset 0 0 0 6px #111419; }
  .rack li { display: grid; grid-template-columns: 14px 1fr auto 14px; align-items: center; gap: 18px; min-height: 64px; padding: 0 14px; border-radius: 4px;
    background: linear-gradient(180deg, #2a2f38, #1b1f27 48%, #171a21 52%, #222731), repeating-linear-gradient(90deg, rgb(255 255 255 / 0.02) 0 1px, transparent 1px 3px);
    background-blend-mode: overlay; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), inset 0 -1px 0 rgb(0 0 0 / 0.6); }
  .screw { width: 10px; height: 10px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #9aa1ab, #3a3f48 70%); box-shadow: 0 1px 0 rgb(0 0 0 / 0.6); }
  .unit { font: 400 var(--step-1) / 1.2 var(--font-display); color: var(--ink); }
  .led { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 10px var(--amber), 0 0 2px #fff inset; animation: led calc(var(--beat) * 4) steps(1) 2; animation-delay: calc(var(--i) * var(--beat) * 0.5); }
  @keyframes led { 0%, 60% { opacity: 1; } 61%, 100% { opacity: 0.35; } }
  @media (max-width: 860px) { .tech { grid-template-columns: 1fr; } .rack li { gap: 12px; } }

  /* ---------- Bildstrecke ---------- */
  .tunnel-sec { padding-block: clamp(80px, 11vw, 160px); }
  .tunnel-hint { display: none; }
  /* Tunnel-Modus (per JS aktiviert) */
  .tunnel-sec.is-tunnel { height: 340vh; padding: 0; }
  .is-tunnel .tunnel-sticky { position: sticky; top: 0; height: 100svh; overflow: hidden; perspective: 1200px; display: grid; place-items: center;
    background: radial-gradient(circle at 50% 50%, rgb(139 125 255 / 0.12), transparent 65%), radial-gradient(rgb(242 243 245 / 0.06) 1px, transparent 1px) 0 0 / 28px 28px; }
  .is-tunnel .tunnel-title { position: relative; z-index: 0; display: grid; justify-items: center; text-align: center; grid-template-columns: 1fr; margin: 0; }
  .is-tunnel .tunnel-title h2 { font-size: clamp(3rem, 1rem + 8vw, 8.5rem); }
  .is-tunnel .tunnel-title .lead { max-width: 40ch; }
  .is-tunnel .bento { position: absolute; inset: 0; width: auto; display: block; transform-style: preserve-3d; pointer-events: none; }
  .is-tunnel .bento li { position: absolute; left: 50%; top: 50%; width: clamp(150px, 19vw, 280px); aspect-ratio: 4 / 5; opacity: 0; pointer-events: auto; }
  .is-tunnel .zoom { border-radius: 18px; box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.9); border-color: rgb(242 243 245 / 0.16); }
  .is-tunnel .zoom:hover { border-color: rgb(201 139 255 / 0.7); }
  .is-tunnel .tunnel-hint { display: block; position: absolute; bottom: 28px; left: 0; right: 0; text-align: center; font-size: var(--step--1); color: var(--ink-2); transition: opacity 0.4s; }
  @media (max-width: 760px) { .is-tunnel .bento li { width: clamp(130px, 38vw, 180px); } }
  .bento { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: clamp(180px, 20vw, 280px); gap: 12px; }
  .bento .wide { grid-column: span 2; }
  .bento .tall { grid-row: span 2; }
  .zoom { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: #000; cursor: zoom-in; }
  .zoom :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease), filter 0.5s; filter: saturate(0.9); }
  .zoom:hover :global(img), .zoom:focus-visible :global(img) { transform: scale(1.04); filter: none; }
  @media (max-width: 760px) { .bento { grid-template-columns: 1fr 1fr; grid-auto-rows: 160px; } .bento .tall { grid-row: span 1; } }
  .lightbox { width: min(96vw, 1400px); max-height: 94vh; padding: 0; border: 1px solid var(--line); border-radius: var(--radius); background: #050608; color: var(--ink); }
  .lightbox::backdrop { background: rgb(5 6 8 / 0.88); backdrop-filter: blur(6px); }
  .lightbox img { display: block; width: 100%; max-height: 80vh; object-fit: contain; }
  .lb-cap { padding: 14px 20px 18px; color: var(--ink-2); font-size: var(--step--1); }
  .lb-close { position: absolute; top: 10px; right: 10px; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line-strong); background: rgb(5 6 8 / 0.6); color: var(--ink); font-size: 1.6rem; line-height: 1; cursor: pointer; }

  /* ---------- Preise ---------- */
  .from-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .from-card { position: relative; display: grid; gap: 10px; padding: 28px; min-height: 220px; align-content: end; text-decoration: none; border: 1px solid var(--line); border-radius: var(--radius); background: radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--room) 16%, transparent), transparent 60%), var(--bg-2); transition: border-color 0.3s, transform 0.4s var(--ease); }
  .from-card:hover { border-color: color-mix(in srgb, var(--room) 55%, transparent); transform: translateY(-3px); }
  .from-name { font: 300 var(--step-3) / 1 var(--font-display); letter-spacing: -0.03em; }
  .from-price { font: 400 var(--step-2) / 1.1 var(--font-display); }
  .from-price small { font: 400 var(--step--1) / 1 var(--font-body); color: var(--ink-2); }
  .from-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 28px; }
  @media (max-width: 860px) { .from-list { grid-template-columns: 1fr; } .from-card { min-height: 0; } }

  /* ---------- Ablauf ---------- */
  .steps-title { max-width: 16ch; margin-bottom: clamp(40px, 6vw, 72px); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .steps li { display: grid; gap: 12px; align-content: start; }
  .steps .num { font: 200 clamp(5rem, 3rem + 6vw, 9rem) / 0.8 var(--font-display); color: transparent; -webkit-text-stroke: 1px var(--line-strong); margin-bottom: 12px; }
  .steps h3 { font: 400 var(--step-2) / 1.15 var(--font-display); }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; gap: 48px; } }

  /* ---------- Beat Stage ---------- */
  .teaser { background: radial-gradient(70% 120% at 25% 50%, rgb(201 139 255 / 0.14), transparent 60%), var(--bg-2); border-block: 1px solid var(--line); }
  .teaser-inner { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(40px, 6vw, 96px); padding-block: clamp(80px, 10vw, 140px); }
  .teaser-text { display: grid; gap: 24px; justify-items: start; }
  .keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(10px, 1.6vw, 18px); max-width: 520px; width: 100%; justify-self: center; }
  .key { aspect-ratio: 1; display: grid; place-items: center; border-radius: 18px; font: 500 clamp(1.6rem, 1rem + 2vw, 2.6rem) / 1 var(--font-display); color: var(--ink-2);
    background: linear-gradient(180deg, #232833, #161a22); border: 1px solid var(--line); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), 0 10px 0 -2px #090b0f, 0 12px 24px rgb(0 0 0 / 0.5);
    animation: hit calc(var(--beat) * 4) var(--ease) 2; animation-delay: calc(var(--k) * var(--beat)); }
  .key:nth-child(1) { --c: var(--amber); } .key:nth-child(2) { --c: var(--spot); } .key:nth-child(3) { --c: var(--magenta); } .key:nth-child(4) { --c: #8fd3ff; }
  @keyframes hit { 0% { color: #0d0f14; background: var(--c); box-shadow: 0 0 40px -4px var(--c), 0 4px 0 -2px #090b0f; transform: translateY(6px); } 25%, 100% { } }
  @media (prefers-reduced-motion: reduce) { .key { animation: none; } }
  @media (max-width: 760px) { .teaser-inner { grid-template-columns: 1fr; } .keys { justify-self: start; } }

  /* ---------- Besuch ---------- */
  .visit .addr { font-size: clamp(3rem, 1rem + 9vw, 10rem); line-height: 0.92; letter-spacing: -0.045em; margin-top: 18px; padding-bottom: 0.06em; }
  .city { font: 300 var(--step-2) / 1.2 var(--font-display); color: var(--ink-2); margin-top: 8px; }
  .visit-grid { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end; margin-top: clamp(40px, 6vw, 72px); padding-top: 32px; border-top: 1px solid var(--line); }
  @media (max-width: 960px) { .visit-grid { grid-template-columns: 1fr; } }
</style>

<script>
  // Startbereich: wechselnde Fotos (pausierbar, stoppt bei reduzierter Bewegung und verstecktem Tab)
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) {
    const slides = [...hero.querySelectorAll<HTMLElement>("[data-slide]")];
    const segs = [...hero.querySelectorAll<HTMLButtonElement>("[data-seg]")];
    const caps = [...hero.querySelectorAll<HTMLElement>("[data-caption]")];
    const pauseBtn = hero.querySelector<HTMLButtonElement>("[data-pause]")!;
    const pauseLabel = hero.querySelector<HTMLElement>("[data-pause-label]")!;
    let cur = 0, paused = false;
    const show = (n: number) => {
      cur = (n + slides.length) % slides.length;
      slides[cur].classList.add("seen");
      slides[(cur + 1) % slides.length].classList.add("seen"); // nächstes Foto vorladen
      slides.forEach((s, i) => { s.classList.toggle("is-active", i === cur); s.toggleAttribute("aria-hidden", i !== cur); });
      segs.forEach((b, i) => i === cur ? b.setAttribute("aria-current", "true") : b.removeAttribute("aria-current"));
      caps.forEach((c, i) => (c.hidden = i !== cur));
    };
    const setPaused = (p: boolean) => {
      paused = p; hero.classList.toggle("paused", p);
      pauseBtn.setAttribute("aria-pressed", String(p));
      pauseLabel.textContent = p ? "Fotowechsel fortsetzen" : "Fotowechsel anhalten";
    };
    // Weiter, sobald der Fortschrittsbalken des aktiven Fotos voll ist
    segs.forEach((b, i) => {
      b.addEventListener("click", () => show(i));
      b.querySelector("span")!.addEventListener("animationend", () => { if (!paused && i === cur) show(cur + 1); });
    });
    pauseBtn.addEventListener("click", () => setPaused(!paused));
    document.addEventListener("visibilitychange", () => { if (document.hidden && !paused) setPaused(true); });
    // Überschrift nach dem Intro einblenden
    const html = document.documentElement;
    const ready = () => requestAnimationFrame(() => hero.classList.add("ready"));
    // Mit Intro ist die Überschrift sofort da (das Intro ist die Einstiegsbewegung), ohne Intro steigt sie auf
    if (html.classList.contains("intro-play")) hero.classList.add("ready", "no-rise"); else ready();
    // Nächstes Foto vorladen, sobald die Seite steht
    addEventListener("load", () => setTimeout(() => slides[1]?.classList.add("seen"), 1500), { once: true });
  }
  // 3D-Tunnel: Fotos fliegen beim Scrollen auf dich zu (Seiten-Scroll, kein Scroll-Kapern)
  const tunnel = document.querySelector<HTMLElement>("[data-tunnel]");
  if (tunnel && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    tunnel.classList.add("is-tunnel");
    const cards = [...tunnel.querySelectorAll<HTMLElement>("[data-card]")];
    const title = tunnel.querySelector<HTMLElement>("[data-tunnel-title]")!;
    const hint = tunnel.querySelector<HTMLElement>("[data-tunnel-hint]")!;
    const N = cards.length, span = 0.55;
    const geo = cards.map((_, i) => {
      const a = i * 137.5 * (Math.PI / 180);
      return { cos: Math.cos(a), sin: Math.sin(a), rx: 0.28 + (i % 3) * 0.08, ry: 0.26 + (i % 2) * 0.09, rot: (i % 2 ? -1 : 1) * (3 + (i % 5) * 2), start: (i / N) * (1 - span) };
    });
    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    const ramp = (t: number, a: number, b: number, c: number, d: number) => (t < a ? 0 : t < b ? (t - a) / (b - a) : t < c ? 1 : t < d ? 1 - (t - c) / (d - c) : 0);
    let px = 0, py = 0, tx = 0, ty = 0, queued = false;
    const frame = () => {
      queued = false;
      const r = tunnel.getBoundingClientRect(), vh = innerHeight, vw = innerWidth, mobile = vw < 768;
      const p = clamp(-r.top / (r.height - vh));
      px += (tx - px) * 0.12; py += (ty - py) * 0.12;
      const far = mobile ? -1200 : -1700, near = mobile ? 350 : 500, pan = mobile ? 20 : 45;
      cards.forEach((c, i) => {
        const g = geo[i], t = clamp((p - g.start) / span);
        const z = far + (near - far) * t;
        const x = g.cos * vw * g.rx - px * pan, y = g.sin * vh * g.ry - py * pan;
        c.style.transform = `translate3d(calc(-50% + ${x.toFixed(1)}px), calc(-50% + ${y.toFixed(1)}px), ${z.toFixed(0)}px) rotateZ(${g.rot}deg)`;
        const o = ramp(t, 0, 0.18, 0.82, 0.98);
        c.style.opacity = o.toFixed(3);
        c.style.pointerEvents = o < 0.02 ? "none" : "auto"; // unsichtbar: nicht anklickbar, aber per Tastatur erreichbar
      });
      const ts = p < 0.5 ? 0.7 + p * 0.6 : 1 + (p - 0.5) * 0.7;
      title.style.transform = `scale(${ts.toFixed(3)})`;
      title.style.opacity = (p < 0.12 ? 0.25 + (p / 0.12) * 0.75 : p > 0.85 ? Math.max(0, 1 - (p - 0.85) / 0.15) : 1).toFixed(3);
      hint.style.opacity = String(p < 0.1 ? 1 : 0);
      if (Math.abs(tx - px) > 0.001 || Math.abs(ty - py) > 0.001) queue();
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(frame); } };
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    if (matchMedia("(pointer: fine)").matches) addEventListener("pointermove", (e) => { tx = (e.clientX / innerWidth - 0.5) * 2; ty = (e.clientY / innerHeight - 0.5) * 2; queue(); }, { passive: true });
    // Tastatur: fokussiertes Foto in Sichtweite scrollen
    cards.forEach((c, i) => c.addEventListener("focusin", () => {
      const r = tunnel.getBoundingClientRect(), top = scrollY + r.top, target = geo[i].start + span * 0.6;
      scrollTo({ top: top + target * (r.height - innerHeight), behavior: "instant" as ScrollBehavior });
    }));
    frame();
  }
  // Großansicht der Bildstrecke
  const lb = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  if (lb) {
    const img = lb.querySelector<HTMLImageElement>("[data-lb-img]")!, cap = lb.querySelector<HTMLElement>("[data-lb-cap]")!;
    let opener: HTMLElement | null = null;
    document.querySelectorAll<HTMLButtonElement>("[data-zoom]").forEach((b) => b.addEventListener("click", () => {
      opener = b; img.src = b.dataset.zoom!; img.alt = b.dataset.alt!; cap.textContent = b.dataset.alt!; lb.showModal();
    }));
    lb.addEventListener("click", (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener("close", () => opener?.focus());
  }
  // Raumbahnen: Zeiger oder Fokus öffnet eine Bahn, sie bleibt offen bis zur nächsten
  const lanes = [...document.querySelectorAll<HTMLElement>("[data-lane]")];
  const open = (l: HTMLElement) => lanes.forEach((x) => x.classList.toggle("is-open", x === l));
  lanes.forEach((l) => {
    l.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") open(l); });
    l.addEventListener("focusin", () => open(l));
    l.addEventListener("click", () => open(l));
  });
</script>
