---
import Base from "../layouts/Base.astro";
import Light from "../components/Light.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import { ROOMS, CONTACT, roomByKey } from "../config/site";
import { u } from "../lib/url";
const studio = roomByKey("tonstudio");
const keys = ["D", "F", "J", "K"];
---
<Base
  title="Silver Stage – Tonstudio & Proberäume in München-Sendling"
  description="Tonstudio, Proberaum mit Bühne und Raum für Tanz & Fotografie in München-Sendling. Musik aufnehmen, proben und gestalten – jetzt Session anfragen."
  intro
  current="/"
>
  <!-- Einstieg: die Bühne im Takt -->
  <section class="hero" aria-labelledby="hero-title" data-hero>
    <div class="hero-light" aria-hidden="true">
      <span class="spot"></span>
      <span class="hero-arcs"><Logo variant="signet" title="" /></span>
    </div>
    <div class="wrap hero-inner">
      <p class="where">Tonstudio und Proberäume in München-Sendling</p>
      <h1 id="hero-title" class="metal">Dein Sound.<br />Dein Raum.</h1>
      <p class="lead">Aufnehmen, proben, tanzen, fotografieren – drei Räume unter einem Dach in der Flößergasse.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={u("/kontakt/")}>Session anfragen</a>
        <a class="btn btn--ghost" href="#raeume">Räume ansehen</a>
      </div>
    </div>
    <nav class="wrap hero-rooms" aria-label="Die drei Räume">
      {ROOMS.map((r) => (
        <a href={u(r.path)} data-room={r.key}>
          <span class="bar" aria-hidden="true"></span>
          <span class="rname">{r.name}</span>
          <span class="rwhat">{r.kicker}{r.area ? `, ${r.area}` : ""}</span>
        </a>
      ))}
    </nav>
  </section>

  <!-- Räume: aufklappende Lichtbahnen -->
  <section class="section rooms-sec" id="raeume" aria-labelledby="rooms-title">
    <div class="wrap">
      <div class="head" data-reveal>
        <h2 id="rooms-title">Drei Räume.<br />Drei Lichtstimmungen.</h2>
        <p class="lead">Jeder Raum hat sein eigenes Licht – und seinen eigenen Zweck. Fahr mit der Maus darüber oder tippe einen Raum an.</p>
      </div>
      <ul class="lanes">
        {ROOMS.map((r, i) => (
          <li class:list={["lane", { "is-open": i === 0 }]} data-room={r.key} data-lane>
            <Light room={r.key} class="lane-light" at="center" />
            <span class="lane-name" aria-hidden="true">{r.name}</span>
            <div class="lane-body">
              <p class="label">{r.kicker}</p>
              <h3><a href={u(r.path)}>{r.name}</a></h3>
              <p class="lane-short">{r.short}</p>
              <ul class="lane-facts">{r.facts.slice(0, 4).map((f) => <li>{f}</li>)}</ul>
              <div class="btn-row">
                <a class="btn btn--primary btn--sm" href={u(r.path)}>{r.name} ansehen</a>
                <a class="btn btn--ghost btn--sm" href={u(`/kontakt/?raum=${r.key}`)}>Anfragen</a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Studiotechnik als Rack -->
  <section class="section section--alt" aria-labelledby="tech-title" data-room="tonstudio">
    <div class="wrap tech">
      <div class="tech-text" data-reveal>
        <h2 id="tech-title">Analog, wo es klingt. Digital, wo es hilft.</h2>
        <p class="lead">Ein akustisch optimierter Aufnahmeraum mit Technik, die du nicht zu Hause stehen hast.</p>
        <a class="link-arrow" href={u("/tonstudio/")}>Zum Tonstudio</a>
      </div>
      <ul class="rack" aria-label="Ausstattung Tonstudio">
        {studio.facts.map((f, i) => (
          <li style={`--i:${i}`}>
            <span class="screw" aria-hidden="true"></span>
            <span class="unit">{f}</span>
            <span class="led" aria-hidden="true"></span>
            <span class="screw" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Ablauf (echte Reihenfolge) -->
  <section class="section" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title" class="steps-title" data-reveal>So kommst du zu deiner Session</h2>
      <ol class="steps">
        <li><span class="num" aria-hidden="true">1</span><h3>Vorhaben beschreiben</h3><p class="muted">Schreib uns, was du aufnehmen, proben oder gestalten möchtest – und wann.</p></li>
        <li><span class="num" aria-hidden="true">2</span><h3>Details abstimmen</h3><p class="muted">Wir klären Raum, Dauer, Technik und dein individuelles Angebot.</p></li>
        <li><span class="num" aria-hidden="true">3</span><h3>Termin bestätigen</h3><p class="muted">Sobald alles passt, bestätigen wir deinen Termin verbindlich.</p></li>
      </ol>
    </div>
  </section>

  <!-- Beat Stage -->
  <section class="teaser" aria-labelledby="teaser-title">
    <div class="wrap teaser-inner">
      <div class="keys" aria-hidden="true">
        {keys.map((k, i) => <span class="key" style={`--k:${i}`}>{k}</span>)}
      </div>
      <div class="teaser-text">
        <h2 id="teaser-title">Triffst du den Takt?</h2>
        <p class="lead">Beat Stage, unser Rhythmusspiel im Browser: vier Pads, 30 Sekunden, 100 BPM. Ohne Anmeldung – Ton erst, wenn du startest.</p>
        <a class="btn btn--primary" href={u("/beat-stage/")}>Beat Stage spielen</a>
      </div>
    </div>
  </section>

  <!-- Standort + Kontakt -->
  <section class="section visit" aria-labelledby="visit-title">
    <div class="wrap">
      <p class="label label--plain muted">So findest du uns</p>
      <h2 id="visit-title" class="addr metal">{CONTACT.street}</h2>
      <p class="city">{CONTACT.zip} {CONTACT.city}-Sendling</p>
      <div class="visit-grid">
        <div>
          <p class="lead">Erzähl uns von deinem Projekt – wir melden uns mit einem individuellen Angebot. {CONTACT.hoursNote}</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href={u("/kontakt/")}>Session anfragen</a>
          <a class="btn btn--ghost" href={CONTACT.phoneHref}><Icon name="phone" />{CONTACT.phone}</a>
          <a class="btn btn--ghost" href={CONTACT.routeUrl} target="_blank" rel="noopener"><Icon name="pin" />Route planen<span class="visually-hidden"> (öffnet Google Maps in neuem Tab)</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Einstieg ---------- */
  .hero { position: relative; min-height: calc(100svh - 76px); display: grid; grid-template-rows: 1fr auto; overflow: hidden; background: radial-gradient(90% 70% at 72% 40%, #1a1f2b 0%, var(--bg) 70%); }
  .hero-light { position: absolute; inset: 0; pointer-events: none; }
  .spot { position: absolute; inset: 0; background: radial-gradient(520px circle at var(--mx, 72%) var(--my, 42%), rgb(230 236 247 / 0.11), transparent 70%); transition: background-position 0.2s; }
  .hero-arcs { position: absolute; width: min(104vh, 80vw); aspect-ratio: 1; right: max(-18vw, -260px); top: 44%; transform: translateY(-50%); color: var(--silver); }
  .hero-arcs :global(svg) { width: 100%; height: 100%; overflow: visible; }
  .hero-arcs :global(path) { vector-effect: non-scaling-stroke; stroke-width: 3px; stroke: var(--silver); opacity: 0.22; animation: beat var(--beat) cubic-bezier(0.15, 0.7, 0.3, 1) infinite; }
  .hero-arcs :global(path[data-ring="1"]) { animation-delay: 0.05s; }
  .hero-arcs :global(path[data-ring="2"]) { animation-delay: 0.1s; }
  .hero-arcs :global(path[data-ring="3"]) { animation-delay: 0.15s; }
  .hero-arcs :global(path[data-group="0"]) { stroke: var(--amber); }
  .hero-arcs :global(path[data-group="1"]) { stroke: var(--magenta); }
  .hero-arcs :global(path[data-group="2"]) { stroke: var(--spot); }
  .hero-arcs :global(.signet-dot) { r: 3.2px; fill: var(--ink); filter: drop-shadow(0 0 18px #fff); }
  .hero-arcs :global(svg) { filter: drop-shadow(0 0 22px rgb(230 236 247 / 0.25)); }
  @keyframes beat { 0% { opacity: 0.85; } 60%, 100% { opacity: 0.2; } }
  @media (prefers-reduced-motion: reduce) { .hero-arcs :global(path) { animation: none; opacity: 0.45; } }

  .hero-inner { position: relative; z-index: 2; align-self: center; display: grid; gap: 26px; justify-items: start; padding-block: clamp(64px, 12vh, 140px) 48px; }
  .where { font: 500 var(--step-0) / 1.3 var(--font-display); color: var(--silver); }
  .hero h1 { font-size: clamp(3.4rem, 1.2rem + 9.6vw, 11rem); line-height: 0.9; font-weight: 300; letter-spacing: -0.045em; padding-bottom: 0.06em; }
  .hero .lead { color: var(--ink-2); max-width: 40ch; }

  .hero-rooms { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .hero-rooms a { position: relative; display: grid; gap: 4px; padding: 22px 24px 26px 0; text-decoration: none; }
  .hero-rooms a + a { padding-left: 24px; border-left: 1px solid var(--line); }
  .bar { position: absolute; top: -1px; left: 0; width: 56px; height: 2px; background: var(--room); box-shadow: 0 0 16px var(--room); transition: width 0.5s var(--ease); }
  .hero-rooms a + a .bar { left: 24px; }
  .hero-rooms a:hover .bar, .hero-rooms a:focus-visible .bar { width: calc(100% - 24px); }
  .rname { font: 400 var(--step-2) / 1.1 var(--font-display); letter-spacing: -0.01em; }
  .rwhat { color: var(--ink-2); font-size: var(--step--1); }
  @media (max-width: 640px) {
    /* feste Zeilen, damit der Schriftwechsel nichts verschiebt */
    .where { min-height: 2.6em; }
    .hero-inner .btn-row { flex-direction: column; align-items: flex-start; }
    .hero-rooms { grid-template-columns: 1fr; }
    .hero-rooms a, .hero-rooms a + a { padding: 16px 0; border-left: 0; border-top: 1px solid var(--line); display: flex; align-items: baseline; justify-content: space-between; }
    .hero-rooms a + a .bar { left: 0; }
    .hero-arcs { width: 130vw; right: -92vw; top: 22%; transform: none; opacity: 0.6; }
  }

  /* ---------- Räume ---------- */
  .head { display: grid; grid-template-columns: 1.1fr 0.9fr; align-items: end; gap: 32px; margin-bottom: clamp(40px, 6vw, 72px); }
  @media (max-width: 860px) { .head { grid-template-columns: 1fr; } }

  .lanes { list-style: none; margin: 0; padding: 0; display: flex; gap: 12px; height: clamp(560px, 72vh, 700px); }
  .lane { position: relative; flex: 1; min-width: 0; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); transition: flex-grow 0.7s var(--ease), border-color 0.4s; }
  .lane.is-open { flex-grow: 3.2; border-color: color-mix(in srgb, var(--room) 40%, transparent); }
  .lane :global(.lane-light) { position: absolute; inset: 0; --size: 120%; --cx: 50%; }
  .lane-name { position: absolute; left: 22px; bottom: 26px; writing-mode: vertical-rl; transform: rotate(180deg); font: 300 clamp(2.4rem, 1.6rem + 2vw, 3.6rem) / 1 var(--font-display); letter-spacing: -0.02em; color: var(--room); transition: opacity 0.3s; }
  .lane.is-open .lane-name { opacity: 0; }
  .lane-body { position: absolute; inset: auto 0 0 0; display: grid; gap: 14px; justify-items: start; padding: clamp(24px, 3vw, 40px); background: linear-gradient(180deg, transparent, rgb(11 13 18 / 0.88) 34%); opacity: 0; transform: translateY(12px); transition: opacity 0.35s, transform 0.5s var(--ease); min-width: 420px; }
  .lane.is-open .lane-body { opacity: 1; transform: none; transition-delay: 0.25s; }
  .lane h3 { font: 300 var(--step-3) / 1 var(--font-display); letter-spacing: -0.03em; }
  .lane h3 a { text-decoration: none; }
  .lane h3 a::after { content: ""; position: absolute; inset: 0; z-index: 0; }
  .lane-body .btn-row, .lane-body .btn { position: relative; z-index: 1; }
  .lane-short { max-width: 44ch; color: var(--ink-2); }
  .lane-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lane-facts li { border: 1px solid var(--line-strong); border-radius: 99px; padding: 5px 12px; font-size: var(--step--1); background: rgb(13 15 20 / 0.5); }
  @media (max-width: 900px) {
    .lanes { flex-direction: column; height: auto; }
    .lane, .lane.is-open { flex: none; min-height: 460px; }
    .lane-name { display: none; }
    .lane-body, .lane.is-open .lane-body { opacity: 1; transform: none; min-width: 0; }
  }

  /* ---------- Rack ---------- */
  .tech { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .tech-text { display: grid; gap: 24px; justify-items: start; }
  .rack { list-style: none; margin: 0; padding: 14px; display: grid; gap: 6px; border-radius: 10px; background: #08090c; border: 1px solid var(--line); box-shadow: inset 0 0 0 6px #111419; }
  .rack li { display: grid; grid-template-columns: 14px 1fr auto 14px; align-items: center; gap: 18px; min-height: 64px; padding: 0 14px; border-radius: 4px;
    background: linear-gradient(180deg, #2a2f38, #1b1f27 48%, #171a21 52%, #222731), repeating-linear-gradient(90deg, rgb(255 255 255 / 0.02) 0 1px, transparent 1px 3px);
    background-blend-mode: overlay; box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), inset 0 -1px 0 rgb(0 0 0 / 0.6); }
  .screw { width: 10px; height: 10px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #9aa1ab, #3a3f48 70%); box-shadow: 0 1px 0 rgb(0 0 0 / 0.6); }
  .unit { font: 400 var(--step-1) / 1.2 var(--font-display); color: var(--ink); }
  .led { width: 8px; height: 8px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 10px var(--amber), 0 0 2px #fff inset; animation: led calc(var(--beat) * 4) steps(1) infinite; animation-delay: calc(var(--i) * var(--beat) * 0.5); }
  @keyframes led { 0%, 60% { opacity: 1; } 61%, 100% { opacity: 0.35; } }
  @media (max-width: 860px) { .tech { grid-template-columns: 1fr; } .rack li { gap: 12px; } }

  /* ---------- Ablauf ---------- */
  .steps-title { max-width: 16ch; margin-bottom: clamp(40px, 6vw, 72px); }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .steps li { display: grid; gap: 12px; align-content: start; }
  .steps .num { font: 200 clamp(5rem, 3rem + 6vw, 9rem) / 0.8 var(--font-display); color: transparent; -webkit-text-stroke: 1px var(--line-strong); margin-bottom: 12px; }
  .steps h3 { font: 400 var(--step-2) / 1.15 var(--font-display); }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; gap: 48px; } }

  /* ---------- Beat Stage ---------- */
  .teaser { background: radial-gradient(70% 120% at 25% 50%, rgb(201 139 255 / 0.14), transparent 60%), var(--bg-2); border-block: 1px solid var(--line); }
  .teaser-inner { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: clamp(40px, 6vw, 96px); padding-block: clamp(80px, 10vw, 140px); }
  .teaser-text { display: grid; gap: 24px; justify-items: start; }
  .keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(10px, 1.6vw, 18px); max-width: 520px; width: 100%; justify-self: center; }
  .key { aspect-ratio: 1; display: grid; place-items: center; border-radius: 18px; font: 500 clamp(1.6rem, 1rem + 2vw, 2.6rem) / 1 var(--font-display); color: var(--ink-2);
    background: linear-gradient(180deg, #232833, #161a22); border: 1px solid var(--line); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), 0 10px 0 -2px #090b0f, 0 12px 24px rgb(0 0 0 / 0.5);
    animation: hit calc(var(--beat) * 4) var(--ease) infinite; animation-delay: calc(var(--k) * var(--beat)); }
  .key:nth-child(1) { --c: var(--amber); } .key:nth-child(2) { --c: var(--spot); } .key:nth-child(3) { --c: var(--magenta); } .key:nth-child(4) { --c: #8fd3ff; }
  @keyframes hit { 0% { color: #0d0f14; background: var(--c); box-shadow: 0 0 40px -4px var(--c), 0 4px 0 -2px #090b0f; transform: translateY(6px); } 25%, 100% { } }
  @media (prefers-reduced-motion: reduce) { .key { animation: none; } }
  @media (max-width: 760px) { .teaser-inner { grid-template-columns: 1fr; } .keys { justify-self: start; } }

  /* ---------- Besuch ---------- */
  .visit .addr { font-size: clamp(3rem, 1rem + 9vw, 10rem); line-height: 0.92; letter-spacing: -0.045em; margin-top: 18px; padding-bottom: 0.06em; }
  .city { font: 300 var(--step-2) / 1.2 var(--font-display); color: var(--ink-2); margin-top: 8px; }
  .visit-grid { display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end; margin-top: clamp(40px, 6vw, 72px); padding-top: 32px; border-top: 1px solid var(--line); }
  @media (max-width: 960px) { .visit-grid { grid-template-columns: 1fr; } }
</style>

<script>
  // Lichtkegel folgt dem Zeiger (nur Maus, nicht bei reduzierter Bewegung)
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero && matchMedia("(pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      hero.style.setProperty("--mx", `${((e.clientX - r.left) / r.width) * 100}%`);
      hero.style.setProperty("--my", `${((e.clientY - r.top) / r.height) * 100}%`);
    });
  }
  // Raumbahnen: Zeiger oder Fokus öffnet eine Bahn, sie bleibt offen bis zur nächsten
  const lanes = [...document.querySelectorAll<HTMLElement>("[data-lane]")];
  const open = (l: HTMLElement) => lanes.forEach((x) => x.classList.toggle("is-open", x === l));
  lanes.forEach((l) => {
    l.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") open(l); });
    l.addEventListener("focusin", () => open(l));
    l.addEventListener("click", () => open(l));
  });
</script>
