---
// Gestaltete Bildfläche als Platzhalter, bis freigegebene Fotos des Studios vorliegen (siehe docs/MEDIEN.md).
// Keine KI-Fotos und keine angeblich echten Aufnahmen: reine Vektor-Illustration mit sichtbarem Hinweis.
// Echte Fotos später über die Prop `src` einsetzen – dann entfällt der Hinweis.
interface Props {
  kind: "studio" | "stage" | "light" | "lounge" | "detail";
  label?: string;           // Hinweistext
  ratio?: string;           // CSS aspect-ratio, z. B. "16 / 10"
  class?: string;
  src?: string; alt?: string; // echtes Foto (wenn freigegeben)
  eager?: boolean;
}
const { kind, label, ratio = "16 / 10", class: cls, src, alt = "", eager = false } = Astro.props;
const labels: Record<Props["kind"], string> = {
  studio: "Platzhalter · Foto Tonstudio mit Mischpult folgt",
  stage: "Platzhalter · Foto Stageroom mit Bühne folgt",
  light: "Platzhalter · Foto Lightroom mit Spiegelwand folgt",
  lounge: "Platzhalter · Foto Lounge folgt",
  detail: "Platzhalter · Equipment-Detailfoto folgt",
};
const id = `v${Math.random().toString(36).slice(2, 8)}`;
---
<figure class:list={["visual", `visual--${kind}`, cls]} style={`aspect-ratio:${ratio}`}>
  {src ? (
    <img src={src} alt={alt} loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : "auto"} />
  ) : (
    <>
      <svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <defs>
          <radialGradient id={`${id}-glow`} cx="0.5" cy="0.35" r="0.7"><stop offset="0" stop-color="#2a2a38" /><stop offset="1" stop-color="#0b0b0d" /></radialGradient>
          <linearGradient id={`${id}-beam`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f3f1ec" stop-opacity="0.32" /><stop offset="1" stop-color="#f3f1ec" stop-opacity="0" /></linearGradient>
          <linearGradient id={`${id}-violet`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8b7dff" /><stop offset="0.55" stop-color="#3d2f9a" /><stop offset="1" stop-color="#d14fa8" /></linearGradient>
          <linearGradient id={`${id}-fade`} x1="0" y1="0" x2="0" y2="1"><stop offset="0.45" stop-color="#101112" stop-opacity="0" /><stop offset="1" stop-color="#101112" stop-opacity="0.9" /></linearGradient>
          <filter id={`${id}-blur`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="40" /></filter>
        </defs>
        <rect width="1600" height="1000" fill={`url(#${id}-glow)`} />
        {kind === "studio" && (
          <g>
            <ellipse cx="1180" cy="260" rx="380" ry="200" fill="#8b7dff" opacity="0.32" filter={`url(#${id}-blur)`} />
            <ellipse cx="300" cy="200" rx="260" ry="160" fill="#c9a36a" opacity="0.16" filter={`url(#${id}-blur)`} />
            {/* Akustikpaneele */}
            {Array.from({ length: 9 }, (_, i) => <rect x={120 + i * 150} y="90" width="120" height="250" rx="4" fill="#16161c" stroke="#26262f" />)}
            {/* Monitorboxen */}
            <rect x="330" y="330" width="120" height="170" rx="8" fill="#0c0c0f" stroke="#2c2c35" /><circle cx="390" cy="450" r="34" fill="#141419" stroke="#34343e" /><circle cx="390" cy="370" r="14" fill="#141419" stroke="#34343e" />
            <rect x="1150" y="330" width="120" height="170" rx="8" fill="#0c0c0f" stroke="#2c2c35" /><circle cx="1210" cy="450" r="34" fill="#141419" stroke="#34343e" /><circle cx="1210" cy="370" r="14" fill="#141419" stroke="#34343e" />
            {/* Mischpult in Perspektive */}
            <path d="M80 1000 L300 560 L1300 560 L1520 1000 Z" fill="#17171c" stroke="#30303a" />
            {Array.from({ length: 32 }, (_, i) => {
              const t = i / 31, xTop = 330 + t * 940, xBot = 150 + t * 1300;
              return <g>
                <line x1={xTop} y1="590" x2={xBot} y2="985" stroke="#24242c" stroke-width="2" />
                <circle cx={xTop + (xBot - xTop) * 0.12} cy={590 + 395 * 0.12} r={4 + t * 0.5} fill={i % 7 === 3 ? "#8b7dff" : "#6b6f78"} />
                <circle cx={xTop + (xBot - xTop) * 0.25} cy={590 + 395 * 0.25} r="5" fill="#4a4d55" />
                <rect x={xTop + (xBot - xTop) * (0.55 + (i % 5) * 0.06) - 7} y={590 + 395 * (0.55 + (i % 5) * 0.06) - 4} width="14" height="8" rx="2" fill="#c6cbd2" />
              </g>;
            })}
            {Array.from({ length: 12 }, (_, i) => <rect x={640 + i * 28} y={575 - (i % 6) * 6} width="16" height={8 + (i % 6) * 6} fill={i > 8 ? "#d18a4f" : "#7ad08a"} opacity="0.85" />)}
          </g>
        )}
        {kind === "stage" && (
          <g>
            <ellipse cx="800" cy="720" rx="640" ry="140" fill="#8b7dff" opacity="0.18" filter={`url(#${id}-blur)`} />
            {[380, 800, 1220].map((x, i) => <path d={`M${x - 26} 40 L${x + 26} 40 L${x + 260} 780 L${x - 260} 780 Z`} fill={`url(#${id}-beam)`} opacity={i === 1 ? 0.9 : 0.6} />)}
            {[380, 800, 1220].map((x) => <rect x={x - 34} y="22" width="68" height="34" rx="6" fill="#26262e" />)}
            <rect x="0" y="40" width="1600" height="14" fill="#1b1b22" />
            {/* Bühne */}
            <path d="M120 760 L1480 760 L1600 900 L0 900 Z" fill="#1d1d24" />
            <rect x="0" y="900" width="1600" height="100" fill="#0e0e11" />
            <path d="M120 760 L1480 760" stroke="#c6cbd2" stroke-opacity="0.4" stroke-width="3" />
            {/* Mikrofonstativ, Verstärker, Drumset-Silhouette */}
            <path d="M800 760 L800 520 M800 520 L860 480" stroke="#3a3a45" stroke-width="8" stroke-linecap="round" /><circle cx="866" cy="476" r="12" fill="#4a4a56" />
            <rect x="300" y="620" width="190" height="140" rx="8" fill="#141418" stroke="#33333d" /><rect x="320" y="640" width="150" height="20" rx="3" fill="#24242b" />
            <ellipse cx="1180" cy="700" rx="90" ry="60" fill="#141418" stroke="#33333d" /><ellipse cx="1060" cy="640" rx="55" ry="18" fill="#2a2a32" /><ellipse cx="1300" cy="620" rx="60" ry="14" fill="#c6cbd2" opacity="0.35" />
          </g>
        )}
        {kind === "light" && (
          <g>
            <rect width="1600" height="1000" fill={`url(#${id}-violet)`} opacity="0.55" />
            <ellipse cx="420" cy="260" rx="420" ry="260" fill="#8b7dff" opacity="0.6" filter={`url(#${id}-blur)`} />
            <ellipse cx="1260" cy="420" rx="380" ry="300" fill="#d14fa8" opacity="0.45" filter={`url(#${id}-blur)`} />
            <ellipse cx="820" cy="820" rx="560" ry="200" fill="#2b5bd6" opacity="0.4" filter={`url(#${id}-blur)`} />
            {/* Spiegelwand */}
            {Array.from({ length: 7 }, (_, i) => <rect x={110 + i * 200} y="140" width="186" height="620" fill="#ffffff" opacity={0.05 + (i % 2) * 0.03} stroke="#ffffff" stroke-opacity="0.22" />)}
            {Array.from({ length: 7 }, (_, i) => <path d={`M${150 + i * 200} 170 L${210 + i * 200} 170 L${130 + i * 200} 730 L${118 + i * 200} 730 Z`} fill="#fff" opacity="0.06" />)}
            <rect x="0" y="760" width="1600" height="240" fill="#121016" opacity="0.85" />
            <path d="M0 760 L1600 760" stroke="#ffffff" stroke-opacity="0.25" stroke-width="2" />
            {/* hängende PA */}
            <rect x="160" y="40" width="70" height="120" rx="6" fill="#0d0c10" opacity="0.9" /><rect x="1370" y="40" width="70" height="120" rx="6" fill="#0d0c10" opacity="0.9" />
          </g>
        )}
        {kind === "lounge" && (
          <g>
            <ellipse cx="1150" cy="300" rx="320" ry="260" fill="#c9a36a" opacity="0.28" filter={`url(#${id}-blur)`} />
            <ellipse cx="350" cy="420" rx="300" ry="200" fill="#8b7dff" opacity="0.18" filter={`url(#${id}-blur)`} />
            <path d="M1150 80 L1150 260" stroke="#4a4a52" stroke-width="3" /><path d="M1090 260 L1210 260 L1180 320 L1120 320 Z" fill="#e2c48a" opacity="0.9" />
            <rect x="300" y="560" width="900" height="200" rx="40" fill="#1c1b20" stroke="#2f2e36" /><rect x="340" y="480" width="820" height="140" rx="36" fill="#232229" stroke="#34333b" />
            <rect x="0" y="820" width="1600" height="180" fill="#0e0d10" />
            <rect x="1280" y="640" width="160" height="120" rx="8" fill="#17161b" stroke="#2f2e36" />
          </g>
        )}
        {kind === "detail" && (
          <g>
            <ellipse cx="800" cy="500" rx="520" ry="320" fill="#8b7dff" opacity="0.2" filter={`url(#${id}-blur)`} />
            {/* Röhrenmikrofon / Großmembran-Silhouette */}
            <rect x="700" y="160" width="200" height="420" rx="100" fill="#1e1f25" stroke="#c6cbd2" stroke-opacity="0.5" stroke-width="3" />
            {Array.from({ length: 14 }, (_, i) => <line x1="720" y1={210 + i * 18} x2="880" y2={210 + i * 18} stroke="#c6cbd2" stroke-opacity="0.25" stroke-width="2" />)}
            <rect x="760" y="600" width="80" height="120" rx="10" fill="#2a2b31" /><path d="M640 400 Q640 760 800 760 Q960 760 960 400" fill="none" stroke="#3a3b44" stroke-width="10" />
            <path d="M800 760 L800 940" stroke="#3a3b44" stroke-width="12" />
          </g>
        )}
        <rect width="1600" height="1000" fill={`url(#${id}-fade)`} />
      </svg>
      <figcaption class="ph-tag">{label ?? labels[kind]}</figcaption>
    </>
  )}
</figure>

<style>
  .visual { position: relative; margin: 0; overflow: hidden; background: #0b0b0d; border-radius: var(--radius); isolation: isolate; }
  .visual > svg, .visual > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease); }
  :global(.zoomable:hover) .visual > svg, :global(.zoomable:hover) .visual > img { transform: scale(1.04); }
</style>
