---
// Markenintro (5 s) – progressive Verbesserung:
// Phasen: Punkt 0–0,7 s · Wellen 0,9–2,5 s · Wortmarke 2,4–3,3 s · Lichtzug 3–4 s · Übergang 4,3–5 s.
// Bei Änderung von INTRO.durationMs die Ausblend-Zeiten (4,3 s) hier mitziehen.
// • Startet nur, wenn JS läuft, keine reduzierte Bewegung gewünscht ist und es in dieser Sitzung noch nicht lief.
// • Der Seiteninhalt ist darunter bereits vollständig gerendert; das Intro blockiert weder Laden noch Rendern.
// • „Intro überspringen“ ist sofort sichtbar und fokussierbar, Escape/Scrollen überspringt ebenfalls.
// Dauer und Speicher-Schlüssel: src/config/site.ts → INTRO.
import Logo from "./Logo.astro";
import { INTRO } from "../config/site";
import { getImage } from "astro:assets";
import { PHOTOS } from "../assets/photos";
// Hintergrundfoto: Mischpult mit Blick auf die Bühne – gestochen scharf. Darauf gehen die Lichter des Pults an
// (Leuchtpunkte aus intro-leds.ts, von vorne nach hinten „steigend“), danach erscheint das Logo.
const bgS = await getImage({ src: PHOTOS.stagePultBlick.src, width: 1280, format: "webp", quality: 72 });
const bgL = await getImage({ src: PHOTOS.stagePultBlick.src, width: 1672, format: "webp", quality: 78 });
---
<script is:inline define:vars={{ key: INTRO.storageKey }}>
  // Einmal pro Sitzung. Ohne Sitzungsspeicher (z. B. eingebettete Vorschau) läuft es bei jedem Aufruf.
  // Bei „Bewegung reduzieren“ läuft eine ruhige Variante (nur Ein-/Ausblenden, keine Bewegung).
  var seen = null;
  try { seen = sessionStorage.getItem(key); sessionStorage.setItem(key, "1"); } catch (e) {}
  // „Intro abspielen“ in der Vorschauleiste setzt einen Merker in window.name
  var name = window.name || "";
  if (name.indexOf("ss-intro") > -1) { seen = null; window.name = name.split(" ").filter(function (t) { return t !== "ss-intro"; }).join(" "); }
  if (!seen) {
    document.documentElement.classList.add("intro-play");
    if (matchMedia("(prefers-reduced-motion: reduce)").matches && name.indexOf("ss-fx-force") < 0) document.documentElement.classList.add("intro-calm");
  }
</script>
<div class="intro" data-intro data-duration={INTRO.durationMs} role="region" aria-label="Intro">
  <!-- lazy: lädt nur, wenn das Intro wirklich läuft (sonst ist der Container display:none) -->
  <div class="board" aria-hidden="true">
    <img class="intro-photo" src={bgS.src} srcset={`${bgS.src} 1280w, ${bgL.src} 1672w`} sizes="100vw" width="1672" height="941" alt="" loading="lazy" decoding="async" onload="this.classList.add('is-loaded')" />
    <div class="leds" data-leds></div>
    <span class="scan"></span>
  </div>
  <div class="vignette" aria-hidden="true"></div>
  <div class="stagelight" aria-hidden="true"></div>
  <div class="logo-wrap" aria-hidden="true" data-intro-logo>
    <Logo animated class="intro-logo" title="" />
    <span class="sweep"></span>
  </div>
  <button class="skip btn btn--ghost btn--sm" type="button" data-intro-skip>Intro überspringen</button>
</div>

<style>
  .intro { display: none; }
  :global(html.intro-play) .intro {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 120;
  }
  /* Hintergrund blendet ab 4,3 s aus und gibt das Hero frei, während das Logo zum Header gleitet */
  :global(html.intro-play) .intro::before { content: ""; position: absolute; inset: 0; background: #0a0a0c; animation: fade-out 0.7s var(--ease) 4.3s forwards; }
  :global(html.intro-play) .logo-wrap { animation: fade-out 0.2s linear 4.8s forwards; }
  :global(html.intro-play) .skip { animation: fade-out 0.3s linear 4.4s forwards; }
  /* Foto hinter dem Logo: blendet weich ein, zoomt langsam, geht mit dem Hintergrund ab 4,3 s */
  /* Pult deckt den Bildschirm ab (wie object-fit: cover), damit die Leuchtpunkte genau auf den Tasten sitzen */
  .board { position: absolute; left: 50%; top: 50%; width: max(100vw, 100vh * 1672 / 941); aspect-ratio: 1672 / 941; translate: -50% -50%; transform: scale(1.08); }
  :global(html.intro-play) .board { animation: photo-zoom 5s cubic-bezier(0.2, 0.5, 0.3, 1) forwards, fade-out 0.7s var(--ease) 4.3s forwards; }
  .intro-photo { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; filter: brightness(0.16) saturate(0.5); transition: opacity 0.5s ease-out; }
  .intro-photo:global(.is-loaded) { opacity: 1; }
  /* Strom an: das Pult wird von vorne nach hinten hell, die Farben kommen */
  :global(html.intro-play) .intro-photo { animation: power 2.4s cubic-bezier(0.3, 0.1, 0.3, 1) 0.4s forwards; }
  @keyframes power { 60% { filter: brightness(0.5) saturate(1.05); } 100% { filter: brightness(0.72) saturate(1.15) contrast(1.05); } }
  .leds { position: absolute; inset: 0; mix-blend-mode: screen; }
  .leds :global(i) { position: absolute; left: var(--x); top: var(--y); width: var(--w); aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; opacity: 0; scale: 0.4;
    background: radial-gradient(closest-side, #fff 0%, var(--c) 32%, color-mix(in srgb, var(--c) 40%, transparent) 60%, transparent 100%);
    animation: led-on 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.4) var(--t) forwards; }
  .leds :global(i.warm) { width: calc(var(--w) * 2.2); }
  @keyframes led-on { 0% { opacity: 0; scale: 0.4; } 45% { opacity: 1; scale: 1.35; } 100% { opacity: var(--o, 0.9); scale: 1; } }
  /* Lichtkante, die über das Pult nach hinten wandert */
  .scan { position: absolute; left: 0; right: 0; height: 22%; top: 100%; opacity: 0; will-change: transform; mix-blend-mode: screen; pointer-events: none;
    background: linear-gradient(0deg, transparent, rgb(230 236 247 / 0.16) 50%, transparent); }
  :global(html.intro-play) .scan { animation: scan 2s cubic-bezier(0.4, 0, 0.3, 1) 0.45s forwards; }
  @keyframes scan { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translateY(-318%); opacity: 0; } }
  .vignette { position: absolute; inset: 0; background: radial-gradient(42% 30% at 50% 48%, rgb(10 10 12 / 0.55), transparent 100%), radial-gradient(80% 70% at 50% 50%, transparent 40%, rgb(10 10 12 / 0.75) 100%); }
  :global(html.intro-play) .vignette { animation: fade-out 0.7s var(--ease) 4.3s forwards; }
  @keyframes photo-zoom { to { transform: scale(1.02); } }
  .stagelight { position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(28% 34% at 50% 46%, rgb(139 125 255 / 0.28), transparent 70%), radial-gradient(18% 22% at 40% 40%, rgb(209 79 168 / 0.14), transparent 70%);
    opacity: 0; animation: light-in 1.6s ease-out 0.6s forwards, fade-out 0.6s var(--ease) 4.3s forwards; }
  .logo-wrap { position: relative; width: min(78vw, 640px); color: var(--ink); transform-origin: center; }
  .logo-wrap :global(.intro-logo) { width: 100%; height: auto; overflow: visible; }
  /* Phase 1: Punkt wird sichtbar */
  .logo-wrap :global(.intro-logo .signet-dot) { opacity: 0; transform: scale(0.4); transform-box: fill-box; transform-origin: center; animation: dot-in 0.7s var(--ease) 0.1s forwards; filter: drop-shadow(0 0 14px rgb(198 203 210 / 0.8)); }
  /* Phase 2: Schallwellen zeichnen sich rhythmisch auf (innen → außen, alle drei Gruppen gleichzeitig) */
  .logo-wrap :global(.intro-logo path[pathLength]) { stroke-dasharray: 1; stroke-dashoffset: 1; opacity: 0; animation: wave-draw 0.55s var(--ease) forwards; }
  .logo-wrap :global(.intro-logo path[data-ring="0"]) { animation-delay: 0.9s; }
  .logo-wrap :global(.intro-logo path[data-ring="1"]) { animation-delay: 1.25s; }
  .logo-wrap :global(.intro-logo path[data-ring="2"]) { animation-delay: 1.6s; }
  .logo-wrap :global(.intro-logo path[data-ring="3"]) { animation-delay: 1.95s; }
  /* Phase 3: Wortmarke erscheint, kurzer Lichtzug */
  .logo-wrap :global(.intro-logo .wordmark) { opacity: 0; clip-path: inset(0 100% 0 0); animation: word-in 0.9s var(--ease) 2.4s forwards; }
  .sweep { position: absolute; inset: 20% auto 20% 0; width: 14%; background: linear-gradient(100deg, transparent, rgb(255 255 255 / 0.22), transparent); mix-blend-mode: screen; filter: blur(6px); transform: translateX(-120%) skewX(-16deg); opacity: 0; animation: sweep 1s ease-in-out 3s forwards; pointer-events: none; }
  .skip { position: absolute; right: var(--pad); bottom: calc(var(--pad) + env(safe-area-inset-bottom, 0px)); background: rgb(16 17 18 / 0.6); }
  /* Ruhige Variante bei reduzierter Bewegung: Foto und fertiges Logo blenden ein und aus, nichts bewegt sich */
  :global(html.intro-calm) .board { transform: none; animation: fade-out 0.7s ease 4.3s forwards; }
  :global(html.intro-calm) .intro-photo { animation: none; filter: brightness(0.72) saturate(1.1); }
  :global(html.intro-calm) .leds :global(i) { animation: none; opacity: 0.85; scale: 1; }
  :global(html.intro-calm) .scan { display: none; }
  :global(html.intro-calm) .logo-wrap { animation: calm-in 0.9s ease 0.2s both, fade-out 0.6s ease 4.3s forwards; }
  :global(html.intro-calm) .logo-wrap :global(.intro-logo *) { animation: none !important; opacity: 1 !important; stroke-dashoffset: 0 !important; transform: none !important; clip-path: none !important; }
  :global(html.intro-calm) .sweep { display: none; }
  @keyframes calm-in { from { opacity: 0; } }
  @keyframes dot-in { to { opacity: 1; transform: none; } }
  @keyframes wave-draw { 0% { opacity: 1; } 100% { opacity: 1; stroke-dashoffset: 0; } }
  @keyframes word-in { to { opacity: 1; clip-path: inset(0 0 0 0); } }
  @keyframes light-in { to { opacity: 1; } }
  @keyframes sweep { 0% { opacity: 0; transform: translateX(-120%) skewX(-16deg); } 20% { opacity: 1; } 100% { opacity: 0; transform: translateX(520%) skewX(-16deg); } }
  @keyframes fade-out { to { opacity: 0; } }
  :global(html.intro-done) .intro { display: none !important; }
  /* Übergabe an das Header-Logo: während des Intros ausgeblendet, danach weich sichtbar */
  :global(html.intro-play .site-header .brand-logo) { opacity: 0; }
  :global(html.intro-done .site-header .brand-logo) { animation: fade-in 0.35s ease-out; }
  @keyframes fade-in { from { opacity: 0; } }
</style>

<script>
  import { LEDS } from "./intro-leds";
  const intro = document.querySelector<HTMLElement>("[data-intro]");
  const root = document.documentElement;
  if (intro && root.classList.contains("intro-play")) {
    const duration = Number(intro.dataset.duration) || 3000;
    const logo = intro.querySelector<HTMLElement>("[data-intro-logo]")!;
    // Pult-Lichter: vorne (unten im Bild) zuerst, dann Reihe für Reihe nach hinten – erst beim Abspielen erzeugt
    const leds = intro.querySelector<HTMLElement>("[data-leds]");
    if (leds) {
      const frag = document.createDocumentFragment();
      for (const [x, y, w, c, warm] of LEDS) {
        const i = document.createElement("i");
        if (warm) i.className = "warm";
        const t = 0.5 + ((100 - y) / 58) * 1.7 + Math.random() * 0.18; // y≈100 → 0,5 s, y≈42 → 2,2 s
        i.style.cssText = `--x:${x}%;--y:${y}%;--w:${w}%;--c:${c};--t:${t.toFixed(2)}s;--o:${warm ? 0.95 : 0.55}`;
        frag.append(i);
      }
      leds.append(frag);
    }
    let finished = false;
    const finish = () => {
      if (finished) return; finished = true;
      root.classList.remove("intro-play"); root.classList.add("intro-done");
      removeEventListener("keydown", onKey); removeEventListener("wheel", finish); removeEventListener("touchmove", finish);
      // Fokus nur zurückgeben, wenn er im Intro lag – nichts verschieben, was der Nutzer gewählt hat
      if (intro.contains(document.activeElement)) document.querySelector<HTMLElement>("#inhalt")?.focus({ preventScroll: true });
    };
    const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") finish(); };
    addEventListener("keydown", onKey);
    addEventListener("wheel", finish, { passive: true });
    addEventListener("touchmove", finish, { passive: true });
    intro.querySelector("[data-intro-skip]")!.addEventListener("click", finish);

    // Phase 4 (ab 4,3 s): Logo gleitet räumlich ruhig an die Position des Header-Logos
    setTimeout(() => {
      if (finished || root.classList.contains("intro-calm")) return; // ruhige Variante: kein Gleiten
      const target = document.querySelector<SVGElement>(".site-header .brand-logo");
      if (!target || !logo.animate) return;
      const a = logo.getBoundingClientRect(), b = target.getBoundingClientRect();
      if (!b.width) return; // Header-Logo nicht sichtbar
      const s = b.height / (a.height || 1);
      const dx = b.left - a.left - (a.width - a.width * s) / 2, dy = b.top - a.top - (a.height - a.height * s) / 2;
      logo.animate([{ transform: "none" }, { transform: `translate(${dx}px, ${dy}px) scale(${s})` }], { duration: 650, easing: "cubic-bezier(.65,0,.35,1)", fill: "forwards" });
    }, duration - 700);
    setTimeout(finish, duration);
  }
</script>
