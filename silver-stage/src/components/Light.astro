---
// Lichtstimmung eines Raums: grafische Fläche aus Lichtkegel und Schallbögen des Signets in der Lichtfarbe des Raums.
// Bewusst abstrakt – sie gibt sich nicht als Foto aus. Echte Fotos (sobald freigegeben) über `src` einsetzen.
import Logo from "./Logo.astro";
interface Props {
  room?: "tonstudio" | "stageroom" | "lightroom" | "silver";
  class?: string;
  pulse?: boolean;      // Bögen pulsieren im Takt (100 BPM)
  at?: "right" | "center" | "left";
  src?: string; alt?: string;
}
const { room = "silver", class: cls, pulse = false, at = "right", src, alt = "" } = Astro.props;
---
<div class:list={["light", `light--${at}`, { "light--pulse": pulse }, cls]} data-room={room === "silver" ? undefined : room}>
  {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : (
    <>
      <span class="cone" aria-hidden="true"></span>
      <span class="arcs" aria-hidden="true"><Logo variant="signet" title="" /></span>
      <span class="grain" aria-hidden="true"></span>
    </>
  )}
</div>

<style>
  .light { position: relative; overflow: hidden; isolation: isolate; background: radial-gradient(120% 90% at 50% 120%, color-mix(in srgb, var(--room) 14%, transparent), transparent 60%), #0b0d12; }
  .light > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cone { position: absolute; inset: -10% -10% 0; background:
      conic-gradient(from 180deg at var(--cx, 70%) -8%, transparent 0deg 164deg, color-mix(in srgb, var(--room) 34%, transparent) 172deg, color-mix(in srgb, var(--room) 52%, transparent) 180deg, color-mix(in srgb, var(--room) 34%, transparent) 188deg, transparent 196deg 360deg);
    filter: blur(28px); opacity: 0.75; mix-blend-mode: screen; }
  .cone::after { content: ""; position: absolute; left: calc(var(--cx, 70%) - 30%); width: 60%; bottom: 4%; height: 24%; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--room) 45%, transparent), transparent); filter: blur(10px); }
  .arcs { position: absolute; width: var(--size, 78%); aspect-ratio: 1; left: calc(var(--cx, 70%) - var(--size, 78%) / 2); top: 50%; transform: translateY(-50%); color: var(--room); opacity: 0.9; }
  .arcs :global(svg) { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 0 18px color-mix(in srgb, var(--room) 55%, transparent)); }
  .arcs :global(path) { vector-effect: non-scaling-stroke; stroke-width: 2.5px; opacity: 0.55; }
  .arcs :global(path[data-ring="0"]) { opacity: 0.95; }
  .arcs :global(path[data-ring="1"]) { opacity: 0.75; }
  .arcs :global(.signet-dot) { r: 3.2px; }
  .grain { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgb(13 15 20 / 0.85)); }
  .light--center { --cx: 50%; }
  .light--left { --cx: 30%; }

  .light--pulse .arcs :global(path) { animation: ring var(--beat) cubic-bezier(0.2, 0.6, 0.3, 1) 8 both; }
  .light--pulse .arcs :global(path[data-ring="1"]) { animation-delay: 0.06s; }
  .light--pulse .arcs :global(path[data-ring="2"]) { animation-delay: 0.12s; }
  .light--pulse .arcs :global(path[data-ring="3"]) { animation-delay: 0.18s; }
  @keyframes ring { 0% { opacity: 1; } 70%, 100% { opacity: 0.4; } }
  @media (prefers-reduced-motion: reduce) { :global(html:not(.fx-force)) .light--pulse .arcs :global(path) { animation: none; } }
</style>
