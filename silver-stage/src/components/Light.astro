---
// Druckfläche mit dem Signet als Platzhalter, wo kein Foto vorliegt (z. B. Lounge). Bewusst grafisch –
// sie gibt sich nicht als Foto aus. Echte Fotos (sobald freigegeben) über `src` einsetzen.
import Logo from "./Logo.astro";
interface Props { room?: "tonstudio" | "stageroom" | "lightroom" | "silver"; class?: string; src?: string; alt?: string; at?: string; pulse?: boolean }
const { room = "silver", class: cls, src, alt = "" } = Astro.props;
---
<div class:list={["light", cls]} data-room={room === "silver" ? undefined : room}>
  {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : <span class="arcs" aria-hidden="true"><Logo variant="signet" title="" /></span>}
</div>
<style>
  .light { position: relative; overflow: hidden; display: grid; place-items: center; background: var(--paper-2); color: var(--ink);
    background-image: radial-gradient(circle, rgb(28 26 33 / 0.22) 0 0.8px, transparent 1.3px); background-size: 6px 6px; }
  .light[data-room] { background-color: var(--room); color: var(--on-room); }
  .light > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .arcs { width: min(62%, 280px); aspect-ratio: 1; }
  .arcs :global(svg) { width: 100%; height: 100%; overflow: visible; }
</style>
