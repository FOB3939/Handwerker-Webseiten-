---
import Base from "../layouts/Base.astro";
import PageHero from "./PageHero.astro";
import Photo from "./Photo.astro";
import { ROOM_PHOTOS } from "../assets/photos";
import Faq from "./Faq.astro";
import PriceTable from "./PriceTable.astro";
import { ROOMS, SITE, type RoomKey, roomByKey } from "../config/site";
import { u } from "../lib/url";
interface Props { room: RoomKey }
const r = roomByKey(Astro.props.room);
const others = ROOMS.filter((x) => x.key !== r.key);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: new URL(u("/"), SITE.url).href },
    { "@type": "ListItem", position: 2, name: r.name, item: new URL(u(r.path), SITE.url).href },
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: r.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<Base title={r.seoTitle} description={r.seoDescription} current={r.path} jsonLd={jsonLd}>
  <PageHero kicker={r.kicker} title={r.title} lead={r.lead} room={r.key} photo={ROOM_PHOTOS[r.key].hero}
    cta={{ label: `${r.name} anfragen`, href: u(`/kontakt/?raum=${r.key}`) }}
    cta2={{ label: "Ausstattung", href: "#ausstattung" }}
    facts={r.area ? [r.area, "Preise auf Anfrage"] : ["Preise auf Anfrage"]} />

  <section class="section" aria-labelledby="uses-title" data-room={r.key}>
    <div class="wrap split">
      <h2 id="uses-title">Wofür du {r.article} {r.name} nutzt</h2>
      <ul class="uses">
        {r.uses.map((x) => <li><span class="swatch" aria-hidden="true"></span><h3>{x.title}</h3><p class="muted">{x.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--sheet" id="ausstattung" aria-labelledby="eq-title" data-room={r.key}>
    <div class="wrap split">
      <div class="eq-text">
        <h2 id="eq-title">Was dich erwartet</h2>
        <p class="small muted">Angaben laut bisheriger Website des Studios – vor dem Livegang mit dem Betreiber abgeglichen.</p>
      </div>
      <ul class="eq" aria-label={`Ausstattung ${r.name}`}>
        {r.facts.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>

  <section class="section gal-sec" aria-labelledby="gal-title">
    <div class="wrap">
      <h2 id="gal-title" class="gal-title">So sieht der {r.name} aus</h2>
      <ul class:list={["gal", `gal--${ROOM_PHOTOS[r.key].gallery.length}`]}>
        {ROOM_PHOTOS[r.key].gallery.map((k) => <li><figure><Photo name={k} sizes="(min-width: 860px) 50vw, 100vw" /></figure></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--sheet" aria-labelledby="price-title">
    <div class="wrap split">
      <div class="price-intro">
        <h2 id="price-title">Leistungen und Preise</h2>
        <p class="lead">Das Angebot richtet sich nach Dauer, Nutzung und Technik. Beschreib dein Vorhaben, wir melden uns mit einem konkreten Vorschlag.</p>
        <a class="link" href={u("/preise/")}>Alle Preise ansehen</a>
      </div>
      <PriceTable room={r.key} />
    </div>
  </section>

  <section class="section"><div class="wrap"><Faq items={r.faq} /></div></section>

  <section class="section more-sec" aria-labelledby="more-title">
    <div class="wrap">
      <h2 id="more-title" class="more-title">Auch bei Silver Stage</h2>
      <ul class="more">
        {others.map((o) => (
          <li data-room={o.key}><a href={u(o.path)} class="more-card inked">
            <span class="more-body"><span class="more-name">{o.name}</span><span class="more-meta">{o.kicker}{o.area ? `, ${o.area}` : ""}</span><span class="more-short">{o.short}</span></span>
            <span class="more-photo plate"><Photo name={ROOM_PHOTOS[o.key].hero} sizes="(min-width: 860px) 25vw, 100vw" decorative /></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .split { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr); gap: clamp(28px, 5vw, 80px); align-items: start; }
  .uses { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .uses li { display: grid; grid-template-columns: auto minmax(0, 0.9fr) minmax(0, 1.3fr); gap: 8px 20px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--rule-strong); }
  .uses .swatch { width: 18px; height: 18px; align-self: center; }
  .uses h3 { font-size: var(--step-1); font-stretch: 108%; font-weight: 780; min-width: 0; overflow-wrap: anywhere; }
  .eq-text { display: grid; gap: 16px; }
  .eq { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .eq li { display: flex; align-items: center; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--rule-strong); font: 750 var(--step-1) / 1.2 var(--font-display); font-stretch: 108%; }
  .eq li::before { content: ""; width: 12px; height: 12px; flex: none; background: var(--room); box-shadow: inset 0 0 0 1px rgb(28 26 33 / 0.3); }
  .gal-title { margin-bottom: clamp(28px, 4vw, 48px); max-width: 14ch; }
  .gal { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1.4fr 1fr; grid-auto-rows: clamp(200px, 22vw, 320px); gap: 10px; }
  .gal li:first-child { grid-row: span 2; }
  .gal--2 li:first-child { grid-row: span 1; }
  .gal--2 { grid-template-columns: 1fr 1fr; }
  .gal figure { margin: 0; height: 100%; overflow: hidden; }
  .gal :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .price-intro { display: grid; gap: 20px; justify-items: start; }
  .more-title { margin-bottom: clamp(24px, 3vw, 40px); }
  .more { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .more-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); min-height: 300px; text-decoration: none; }
  .more-body { display: grid; gap: 10px; align-content: start; padding: clamp(20px, 3vw, 32px); }
  .more-name { font: 880 var(--step-3) / 0.95 var(--font-display); font-stretch: 125%; letter-spacing: -0.03em; }
  .more-meta { font-weight: 700; }
  .more-short { color: var(--on-room-2); }
  .more-card:hover .more-name { text-decoration: underline; text-decoration-thickness: 4px; text-underline-offset: 8px; }
  .more-photo { position: relative; min-height: 220px; }
  .more-photo :global(img) { position: absolute; inset: 0; }
  @media (max-width: 860px) {
    .split, .more { grid-template-columns: 1fr; }
    .gal { grid-template-columns: 1fr; }
    .gal li:first-child { grid-row: span 1; }
  }
  @media (max-width: 560px) {
    .uses li { grid-template-columns: auto 1fr; }
    .uses p { grid-column: 2; }
    .more-card { grid-template-columns: 1fr; }
    .more-photo { order: -1; min-height: 180px; }
  }
</style>
