---
import Base from "../layouts/Base.astro";
import PageHero from "./PageHero.astro";
import Photo from "./Photo.astro";
import { ROOM_PHOTOS } from "../assets/photos";
import Faq from "./Faq.astro";
import PriceTable from "./PriceTable.astro";
import Icon from "./Icon.astro";
import { ROOMS, SITE, type RoomKey, roomByKey } from "../config/site";
import { u } from "../lib/url";
interface Props { room: RoomKey }
const r = roomByKey(Astro.props.room);
const others = ROOMS.filter((x) => x.key !== r.key);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: new URL(u("/"), SITE.url).href },
    { "@type": "ListItem", position: 2, name: r.name, item: new URL(u(r.path), SITE.url).href },
  ] },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: r.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---
<Base title={r.seoTitle} description={r.seoDescription} current={r.path} jsonLd={jsonLd}>
  <PageHero kicker={r.kicker} title={r.title} lead={r.lead} room={r.key} photo={ROOM_PHOTOS[r.key].hero}
    cta={{ label: `${r.name} anfragen`, href: u(`/kontakt/?raum=${r.key}`) }}
    cta2={{ label: "Ausstattung", href: "#ausstattung" }}
    facts={r.area ? [r.area, "Preise auf Anfrage"] : ["Preise auf Anfrage"]} />

  <section class="section" aria-labelledby="uses-title" data-room={r.key}>
    <div class="wrap">
      <h2 id="uses-title" class="h2">Wofür du {r.article} {r.name} nutzt</h2>
      <ul class="uses">
        {r.uses.map((x, i) => <li><span class="tick" aria-hidden="true"></span><h3>{x.title}</h3><p class="muted">{x.text}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--alt" id="ausstattung" aria-labelledby="eq-title" data-room={r.key}>
    <div class="wrap eq">
      <div class="eq-text" data-reveal>
        <h2 id="eq-title" class="h2">Was dich erwartet</h2>
        <p class="small muted">Angaben laut bisheriger Website des Studios – vor dem Livegang mit dem Betreiber abgeglichen.</p>
      </div>
      <ul class="rack" aria-label={`Ausstattung ${r.name}`}>
        {r.facts.map((f, i) => <li style={`--i:${i}`}><span class="screw" aria-hidden="true"></span><span class="unit">{f}</span><span class="led" aria-hidden="true"></span><span class="screw" aria-hidden="true"></span></li>)}
      </ul>
    </div>
  </section>


  <section class="section gal-sec" aria-labelledby="gal-title">
    <div class="wrap">
      <h2 id="gal-title" class="h2">So sieht der {r.name} aus</h2>
      <ul class:list={["gal", `gal--${ROOM_PHOTOS[r.key].gallery.length}`]}>
        {ROOM_PHOTOS[r.key].gallery.map((k) => <li><figure><Photo name={k} sizes="(min-width: 860px) 50vw, 100vw" /></figure></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="price-title">
    <div class="wrap price">
      <div class="price-intro">
        <h2 id="price-title" class="h2">Leistungen und Preise</h2>
        <p class="lead">Das Angebot richtet sich nach Dauer, Nutzung und Technik. Beschreib dein Vorhaben, wir melden uns mit einem konkreten Vorschlag.</p>
        <a class="link-arrow" href={u("/preise/")}>Alle Preise ansehen</a>
      </div>
      <PriceTable room={r.key} />
    </div>
  </section>

  <section class="section"><div class="wrap"><Faq items={r.faq} /></div></section>

  <section class="section section--alt" aria-labelledby="more-title">
    <div class="wrap">
      <h2 id="more-title" class="h2">Auch bei Silver Stage</h2>
      <ul class="more">
        {others.map((o) => (
          <li data-room={o.key}><a href={u(o.path)} class="more-card">
            <Photo name={ROOM_PHOTOS[o.key].hero} class="more-photo" sizes="(min-width: 860px) 50vw, 100vw" decorative />
            <span class="more-body"><span class="label">{o.kicker}{o.area ? `, ${o.area}` : ""}</span><span class="more-name">{o.name}</span><span class="muted">{o.short}</span></span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .h2 { margin: 0 0 clamp(32px, 5vw, 56px); max-width: 16ch; }
  .uses { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .uses li { display: grid; gap: 12px; align-content: start; }
  .tick { width: 40px; height: 2px; background: var(--room); box-shadow: 0 0 14px var(--room); margin-bottom: 14px; }
  .uses h3 { font: 400 var(--step-2) / 1.1 var(--font-display); }
  .eq { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .eq .h2 { margin-bottom: 20px; }
  .rack { list-style: none; margin: 0; padding: 14px; display: grid; gap: 6px; border-radius: 10px; background: #08090c; border: 1px solid var(--line); box-shadow: inset 0 0 0 6px #111419; }
  .rack li { display: grid; grid-template-columns: 14px 1fr auto 14px; align-items: center; gap: 18px; min-height: 60px; padding: 0 14px; border-radius: 4px;
    background: linear-gradient(180deg, #2a2f38, #1b1f27 48%, #171a21 52%, #222731); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.1), inset 0 -1px 0 rgb(0 0 0 / 0.6); }
  .screw { width: 10px; height: 10px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #9aa1ab, #3a3f48 70%); }
  .unit { font: 400 var(--step-1) / 1.2 var(--font-display); }
  .led { width: 8px; height: 8px; border-radius: 50%; background: var(--room); box-shadow: 0 0 10px var(--room); }
  .price { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 32px; align-items: start; }
  .price .h2 { margin-bottom: 0; }
  .price-intro { display: grid; gap: 20px; justify-items: start; }
  .more { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .more-card { position: relative; display: grid; align-content: end; min-height: 340px; text-decoration: none; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: border-color 0.3s; }
  .more-card:hover { border-color: color-mix(in srgb, var(--room) 50%, transparent); }
  .more-card :global(picture), .more-card :global(.more-photo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .more-card:hover :global(.more-photo) { transform: scale(1.04); }
  .more-card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(7 8 11 / 0.92) 10%, rgb(7 8 11 / 0.2) 70%); }
  .more-body { z-index: 1; }
  .gal { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1.4fr 1fr; grid-auto-rows: clamp(200px, 22vw, 320px); gap: 12px; }
  .gal li:first-child { grid-row: span 2; }
  .gal--2 li:first-child { grid-row: span 1; }
  .gal--2 { grid-template-columns: 1fr 1fr; }
  .gal figure { margin: 0; height: 100%; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .gal :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .more-body { position: relative; display: grid; gap: 10px; padding: 28px; }
  .more-name { font: 300 var(--step-3) / 1 var(--font-display); letter-spacing: -0.03em; }
  @media (max-width: 860px) {
    .uses, .eq, .price, .more, .gal { grid-template-columns: 1fr; }
    .gal li:first-child { grid-row: span 1; }
    .rack li { gap: 12px; }
  }
</style>
