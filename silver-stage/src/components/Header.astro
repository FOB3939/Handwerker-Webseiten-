---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { NAV, QUICK_NAV, CONTACT } from "../config/site";
import { u, isCurrent } from "../lib/url";
interface Props { current?: string }
const { current } = Astro.props;
---
<div class="topbar">
  <div class="wrap topbar-inner">
    <p class="top-contact"><a href={CONTACT.phoneHref}><Icon name="phone" />{CONTACT.phone}</a><span class="top-addr">{CONTACT.street}, {CONTACT.zip} {CONTACT.city}-Sendling</span></p>
    <nav aria-label="Schnellzugriff">
      <ul class="top-links">
        {QUICK_NAV.map((q) => <li><a href={u(q.href)} aria-current={isCurrent(current, q.href) ? "page" : undefined}>{q.label}</a></li>)}
      </ul>
    </nav>
  </div>
</div>
<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={u("/")} aria-label="Silver Stage – Startseite">
      <Logo class="brand-logo" />
    </a>
    <nav class="nav" aria-label="Hauptnavigation">
      <ul class="nav-list">
        {NAV.map((item) => item.children ? (
          <li class="has-sub" data-sub>
            <button class="nav-link sub-toggle" type="button" aria-expanded="false" aria-controls="sub-raeume">
              {item.label}<Icon name="chevron" class="chev" />
            </button>
            <ul class="sub" id="sub-raeume">
              {item.children.map((c) => (
                <li data-room={c.href.replace(/\//g, "")}><a href={u(c.href)} aria-current={isCurrent(current, c.href) ? "page" : undefined}><span class="swatch" aria-hidden="true"></span><span>{c.label}</span><small>{c.note}</small></a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><a class="nav-link" href={u(item.href)} aria-current={isCurrent(current, item.href) ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--sm header-cta" href={u("/kontakt/")}>Session anfragen</a>
    <a class="btn btn--sm mobile-quick" href={u("/kontakt/")}>Anfragen</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      <Icon name="menu" /><span class="visually-hidden">Menü öffnen</span>
    </button>
  </div>
  <div class="mobile" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menü" hidden data-mobile>
    <div class="mobile-top">
      <a href={u("/")} class="brand" aria-label="Silver Stage – Startseite"><Logo class="brand-logo" /></a>
      <button class="menu-btn" type="button" data-menu-close><Icon name="close" /><span class="visually-hidden">Menü schließen</span></button>
    </div>
    <ul class="mobile-list">
      <li><a href={u("/leistungen/")}>Leistungen <small>Was du buchen kannst</small></a></li>
      <li data-room="tonstudio"><a href={u("/tonstudio/")}><span class="mname"><span class="swatch" aria-hidden="true"></span>Tonstudio</span> <small>Aufnehmen</small></a></li>
      <li data-room="stageroom"><a href={u("/stageroom/")}><span class="mname"><span class="swatch" aria-hidden="true"></span>Stageroom</span> <small>Proberaum mit Bühne</small></a></li>
      <li data-room="lightroom"><a href={u("/lightroom/")}><span class="mname"><span class="swatch" aria-hidden="true"></span>Lightroom</span> <small>Tanz, Gesang & Foto</small></a></li>
      <li><a href={u("/preise/")}>Preise <small>Leistungen und Preise</small></a></li>
      <li><a href={u("/beat-stage/")}>Beat Stage <small>Das Rhythmusspiel</small></a></li>
      <li><a href={u("/ueber-uns/")}>Über uns</a></li>
      <li><a href={u("/kontakt/")}>Kontakt</a></li>
    </ul>
    <p class="mobile-legal"><a href={u("/impressum/")}>Impressum</a><a href={u("/datenschutz/")}>Datenschutz</a></p>
    <a class="btn mobile-cta" href={u("/kontakt/")}>Session anfragen</a>
  </div>
</header>

<style>
  /* Kurzleiste ganz oben: Telefon, Adresse und die wichtigsten Seiten – am Handy als wischbare Zeile */
  .topbar { background: var(--paper-2); border-bottom: 1px solid var(--rule); font-size: 0.86rem; }
  .topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 44px; }
  .top-contact { margin: 0; display: flex; align-items: center; gap: 18px; color: var(--ink-2); white-space: nowrap; }
  .top-contact a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--ink); font-weight: 600; text-decoration: none; }
  .top-contact a:hover { text-decoration: underline; }
  .top-contact :global(svg) { width: 15px; height: 15px; }
  .top-links { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .top-links a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 10px; color: var(--ink-2); text-decoration: none; white-space: nowrap; }
  .top-links a:hover, .top-links a[aria-current="page"] { color: var(--ink); text-decoration: underline; text-underline-offset: 6px; }
  @media (max-width: 1020px) {
    .top-contact { display: none; }
    .topbar nav { width: 100%; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; mask: linear-gradient(90deg, #000 85%, transparent); }
    .topbar nav::-webkit-scrollbar { display: none; }
    .top-links { gap: 0; }
    .top-links li:first-child a { padding-left: 0; }
    .top-links a { padding: 0 12px; font-size: 0.9rem; color: var(--ink); }
  }
  @media (max-width: 1180px) and (min-width: 1021px) { .top-addr { display: none; } }
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--paper); border-bottom: 2px solid var(--ink); }
  .bar { display: flex; align-items: center; gap: 20px; min-height: 72px; }
  .brand { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); text-decoration: none; margin-right: auto; }
  .brand :global(.brand-logo) { height: 32px; width: auto; }
  .nav-list { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav-link { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 12px; background: none; border: 0; color: var(--ink); font: 600 0.98rem / 1 var(--font-body); text-decoration: none; cursor: pointer; }
  .nav-link:hover, .sub-toggle[aria-expanded="true"] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 8px; }
  .nav-link[aria-current="page"] { box-shadow: inset 0 -4px 0 var(--yellow); }
  .chev { width: 14px; height: 14px; transition: transform 0.25s var(--ease); }
  .sub-toggle[aria-expanded="true"] .chev { transform: rotate(180deg); }
  .has-sub { position: relative; }
  .sub { position: absolute; top: calc(100% + 12px); left: -8px; min-width: 300px; list-style: none; margin: 0; padding: 8px; background: var(--paper-3); border: 2px solid var(--ink); box-shadow: 0 18px 36px -12px rgb(28 26 33 / 0.35); opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity 0.18s, transform 0.25s var(--ease), visibility 0.18s; }
  .has-sub.open .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; transition: opacity 0.18s, transform 0.25s var(--ease), visibility 0s; }
  .sub a { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; align-items: center; padding: 12px 12px; text-decoration: none; }
  .sub a:hover, .sub a[aria-current="page"] { background: var(--room); color: var(--on-room); }
  .sub a:hover small, .sub a[aria-current="page"] small { color: var(--on-room-2); }
  .sub .swatch { width: 14px; height: 14px; }
  .sub span:not(.swatch) { font: 750 1.1rem / 1.2 var(--font-display); font-stretch: 112%; }
  .sub small { grid-column: 2; color: var(--ink-2); font-size: 0.84rem; }
  .menu-btn { display: none; width: 48px; height: 48px; place-items: center; background: var(--paper); border: 2px solid var(--ink); border-radius: 3px; color: var(--ink); cursor: pointer; }
  .menu-btn :global(svg) { width: 22px; height: 22px; }
  .mobile { position: fixed; inset: 0; z-index: 100; background: var(--paper); padding: 0 var(--pad) 28px; display: flex; flex-direction: column; overflow-y: auto; }
  .mobile[hidden] { display: none; }
  .mobile-top { display: flex; align-items: center; justify-content: space-between; min-height: 72px; border-bottom: 2px solid var(--ink); }
  .mobile-list { list-style: none; margin: 8px 0 24px; padding: 0; }
  .mobile-list a { display: flex; flex-direction: column; gap: 2px; padding: 14px 0; border-bottom: 1px solid var(--rule); text-decoration: none; font: 800 clamp(1.5rem, 1.1rem + 2vw, 2rem) / 1.05 var(--font-display); font-stretch: 118%; letter-spacing: -0.02em; }
  .mname { display: inline-flex; align-items: center; gap: 12px; }
  .mname .swatch { width: 0.6em; height: 0.6em; }
  .mobile-list small { font: 400 0.92rem / 1.3 var(--font-body); letter-spacing: 0; color: var(--ink-2); }
  .mobile-legal { display: flex; gap: 20px; margin: -8px 0 20px; }
  .mobile-legal a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink-2); }
  .mobile-cta { margin-top: auto; }
  .mobile-quick { display: none; }
  @media (max-width: 1100px) and (min-width: 1021px) { .nav-link { padding: 0 8px; font-size: 0.94rem; } .bar { gap: 12px; } }
  @media (max-width: 1020px) {
    .nav, .header-cta { display: none; }
    .menu-btn { display: grid; }
    .mobile-quick { display: inline-flex; --h: 46px; padding: 0 16px; }
    .bar { gap: 10px; min-height: 64px; }
    .brand :global(.brand-logo) { height: 26px; }
  }
  @media (max-width: 370px) { .brand :global(.brand-logo) { height: 22px; } .mobile-quick { padding: 0 12px; } }
</style>

<script>
  // Untermenü „Räume“: Klick/Tastatur, Escape schließt
  document.querySelectorAll<HTMLElement>("[data-sub]").forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>(".sub-toggle")!;
    const set = (open: boolean) => { li.classList.toggle("open", open); btn.setAttribute("aria-expanded", String(open)); };
    btn.addEventListener("click", () => set(btn.getAttribute("aria-expanded") !== "true"));
    li.addEventListener("keydown", (e) => { if (e.key === "Escape") { set(false); btn.focus(); } });
    li.addEventListener("focusout", (e) => { if (!li.contains(e.relatedTarget as Node)) set(false); });
    document.addEventListener("click", (e) => { if (!li.contains(e.target as Node)) set(false); });
  });

  // Mobiles Menü: Fokus im Dialog halten, Escape schließt, Fokus zurück zum Auslöser
  const panel = document.querySelector<HTMLElement>("[data-mobile]");
  const opener = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closer = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  if (panel && opener && closer) {
    const focusables = () => [...panel.querySelectorAll<HTMLElement>("a, button")];
    const close = () => { panel.hidden = true; opener.setAttribute("aria-expanded", "false"); document.body.style.overflow = ""; opener.focus(); };
    opener.addEventListener("click", () => { panel.hidden = false; opener.setAttribute("aria-expanded", "true"); document.body.style.overflow = "hidden"; closer.focus(); });
    closer.addEventListener("click", close);
    panel.addEventListener("keydown", (e) => {
      if (e.key === "Escape") return close();
      if (e.key !== "Tab") return;
      const f = focusables(), first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
    matchMedia("(min-width: 1021px)").addEventListener("change", (m) => { if (m.matches && !panel.hidden) close(); });
  }
</script>
