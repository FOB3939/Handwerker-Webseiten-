---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = "Häufige Fragen" } = Astro.props;
---
<div class="faq">
  <h2 class="faq-title">{title}</h2>
  <div class="items">
    {items.map((f) => (
      <details>
        <summary><span>{f.q}</span><span class="plus" aria-hidden="true"></span></summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</div>
<style>
  .faq { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: clamp(24px, 4vw, 64px); }
  .faq-title { font-size: var(--step-3); }
  .items { border-top: 2px solid var(--ink); }
  details { border-bottom: 1px solid var(--rule-strong); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 24px; min-height: 64px; padding: 16px 0; cursor: pointer; font: 750 var(--step-1) / 1.25 var(--font-display); font-stretch: 106%; }
  summary::-webkit-details-marker { display: none; }
  summary:hover span:first-child { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .plus { position: relative; width: 28px; height: 28px; flex: none; border: 2px solid var(--ink); border-radius: 3px; }
  .plus::before, .plus::after { content: ""; position: absolute; left: 6px; right: 6px; top: 11px; height: 2px; background: var(--ink); transition: transform 0.3s var(--ease); }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus { background: var(--yellow); }
  details[open] .plus::after { transform: rotate(0deg); }
  details p { padding: 0 0 22px; color: var(--ink-2); max-width: 62ch; }
  @media (max-width: 860px) { .faq { grid-template-columns: 1fr; gap: 20px; } }
</style>
