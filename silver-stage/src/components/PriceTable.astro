---
// Leistungen und Preise eines Raums (Daten: PRICES in src/config/site.ts)
import { PRICES, SITE, priceShown, euro, roomByKey, type RoomKey } from "../config/site";
import { u } from "../lib/url";
interface Props { room: RoomKey; heading?: "h2" | "h3"; compact?: boolean }
const { room, heading = "h3", compact = false } = Astro.props;
const group = PRICES.groups.find((g) => g.room === room)!;
const r = roomByKey(room);
const H = heading;
const isExample = !PRICES.confirmed && SITE.preview;
---
<article class:list={["ptable", { compact }]} data-room={room}>
  <header class="pt-head">
    <H class="pt-title">{r.name}</H>
    <a class="pt-link" href={u(r.path)}>Raum ansehen</a>
  </header>
  <ul class="pt-list">
    {group.items.map((it) => {
      const p = priceShown(it);
      return (
        <li>
          <span class="pt-name">{it.name}<small>{it.detail}</small></span>
          <span class="pt-price">
            {p === null ? <strong>auf Anfrage</strong> : <><span class="from">ab</span> <strong>{euro(p)}</strong><small>{it.unit}</small></>}
            {isExample && <span class="pt-tag">Beispielpreis</span>}
          </span>
        </li>
      );
    })}
  </ul>
  <a class="btn btn--sm pt-cta" href={u(`/kontakt/?raum=${room}`)}>{r.name} anfragen</a>
</article>

<style>
  .ptable { display: grid; gap: 16px; align-content: start; padding: 0 0 clamp(18px, 2.5vw, 28px); background: var(--paper-3); border: 2px solid var(--ink); box-shadow: 0 20px 40px -26px rgb(28 26 33 / 0.5); }
  .pt-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 16px; padding: 18px clamp(18px, 2.5vw, 28px); background: var(--room); color: var(--on-room); }
  .pt-title { font: 880 var(--step-2) / 1 var(--font-display); font-stretch: 122%; letter-spacing: -0.02em; }
  .pt-link { font-weight: 650; color: inherit; min-height: 44px; display: inline-flex; align-items: center; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .pt-list { list-style: none; margin: 0; padding: 0 clamp(18px, 2.5vw, 28px); }
  .pt-list li { display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--rule-strong); }
  .pt-list li:last-child { border-bottom: 0; }
  .pt-name { display: grid; gap: 2px; font: 750 1.1rem / 1.25 var(--font-display); font-stretch: 106%; }
  .pt-name small { font: 400 var(--step--1) / 1.4 var(--font-body); color: var(--ink-2); }
  .pt-price { display: grid; justify-items: end; text-align: right; gap: 2px; }
  .pt-price strong { font: 880 var(--step-2) / 1 var(--font-display); font-stretch: 112%; font-variant-numeric: tabular-nums; }
  .from, .pt-price small { font-size: var(--step--1); color: var(--ink-2); }
  .pt-tag { margin-top: 4px; font-size: 12px; font-weight: 650; color: var(--ink); border: 1.5px dashed var(--ink); padding: 1px 8px; }
  .pt-cta { justify-self: start; margin: 4px clamp(18px, 2.5vw, 28px) 0; }
  .compact .pt-list li { padding: 10px 0; }
  @media (max-width: 480px) { .pt-list li { grid-template-columns: 1fr; } .pt-price { justify-items: start; text-align: left; } }
</style>
