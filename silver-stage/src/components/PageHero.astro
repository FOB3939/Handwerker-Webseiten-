---
// Einstieg der Unterseiten als Plakat: Raumseiten stehen ganz in ihrer Druckfarbe, das Foto als Druckplatte.
// Seiten ohne Raum (z. B. Über uns) stehen auf Papier und zeigen das Foto in Farbe.
import Light from "./Light.astro";
import Photo from "./Photo.astro";
import type { PhotoKey } from "../assets/photos";
interface Props { kicker: string; title: string; lead: string; room?: "tonstudio" | "stageroom" | "lightroom" | "silver"; cta?: { label: string; href: string }; cta2?: { label: string; href: string }; facts?: string[]; photo?: PhotoKey }
const { kicker, title, lead, room = "silver", cta, cta2, facts = [], photo } = Astro.props;
const isRoom = room !== "silver";
const chips = isRoom ? [kicker, ...facts] : facts;
---
<section class:list={["phero", { inked: isRoom }]} data-room={isRoom ? room : undefined}>
  <div class="wrap grid">
    <div class="text">
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      {(cta || cta2) && (
        <div class="btn-row">
          {cta && <a class="btn" href={cta.href}>{cta.label}</a>}
          {cta2 && <a class="btn btn--ghost" href={cta2.href}>{cta2.label}</a>}
        </div>
      )}
      {chips.length > 0 && <ul class="chips" aria-label="Kurz gesagt">{chips.map((f) => <li>{f}</li>)}</ul>}
    </div>
    <div class:list={["media", { plate: isRoom }]}>
      {photo ? <Photo name={photo} eager sizes="(min-width: 900px) 45vw, 100vw" /> : <Light room={room} class="phero-light" />}
    </div>
  </div>
</section>
<style>
  .phero { padding-block: clamp(40px, 6vw, 88px); border-bottom: 2px solid var(--ink); }
  .phero.inked { border-bottom-color: #1c1a21; }
  .grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: end; }
  .text { display: grid; gap: 22px; justify-items: start; }
  h1 { font-size: clamp(2.3rem, 0.9rem + 4.2vw, 4.8rem); font-weight: 860; font-stretch: 112%; line-height: 0.92; letter-spacing: -0.03em; max-width: 14ch; hyphens: auto; overflow-wrap: break-word; }
  .text { min-width: 0; }
  .lead { color: inherit; max-width: 40ch; }
  .media { position: relative; aspect-ratio: 4 / 4.6; max-height: 70svh; width: 100%; overflow: hidden; box-shadow: 0 26px 48px -26px rgb(28 26 33 / 0.6); }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .media :global(.phero-light) { position: absolute; inset: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 4px 0 0; padding: 0; }
  .chips li { border: 1.5px solid currentColor; padding: 6px 12px; font-weight: 650; font-size: var(--step--1); }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .media { aspect-ratio: 16 / 10; order: -1; }
  }
</style>
