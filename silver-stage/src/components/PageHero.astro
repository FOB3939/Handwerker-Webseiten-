---
// Einstieg der Unterseiten: großes Bild mit dunklem Verlauf, Label, H1, Nutzenaussage, Aktionen
import Visual from "./Visual.astro";
import Icon from "./Icon.astro";
interface Props { kicker: string; title: string; lead: string; visual: "studio" | "stage" | "light" | "lounge" | "detail"; cta?: { label: string; href: string }; cta2?: { label: string; href: string }; facts?: string[] }
const { kicker, title, lead, visual, cta, cta2, facts = [] } = Astro.props;
---
<section class="phero">
  <div class="bg"><Visual kind={visual} ratio="auto" class="full" eager /></div>
  <div class="wrap inner">
    <p class="label">{kicker}</p>
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    {(cta || cta2) && (
      <div class="btn-row">
        {cta && <a class="btn btn--primary" href={cta.href}>{cta.label}<Icon name="arrow" /></a>}
        {cta2 && <a class="btn btn--ghost" href={cta2.href}>{cta2.label}</a>}
      </div>
    )}
    {facts.length > 0 && <ul class="chips">{facts.map((f) => <li>{f}</li>)}</ul>}
  </div>
</section>
<style>
  .phero { position: relative; min-height: min(78vh, 760px); display: flex; align-items: flex-end; overflow: hidden; }
  .bg { position: absolute; inset: 0; }
  .bg :global(.full) { position: absolute; inset: 0; border-radius: 0; aspect-ratio: auto !important; height: 100%; }
  .bg::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgb(16 17 18 / 0.35) 0%, rgb(16 17 18 / 0.55) 45%, #101112 100%); pointer-events: none; }
  .bg :global(.ph-tag) { top: 14px; bottom: auto; z-index: 3; }
  .inner { position: relative; z-index: 2; display: grid; gap: 24px; padding-block: clamp(120px, 18vh, 200px) clamp(56px, 8vw, 96px); }
  h1 { max-width: 16ch; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 8px 0 0; padding: 0; }
  .chips li { border: 1px solid var(--line-strong); border-radius: 99px; padding: 6px 14px; font-size: var(--step--1); color: var(--ink); background: rgb(16 17 18 / 0.4); }
</style>
