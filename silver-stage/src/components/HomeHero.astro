---
// Startbereich im Stil der Raumseiten: Pult-Foto, große Überschrift, Aktionen.
// Effekt: Nach dem Laden geht das Pult „an“ – das Foto wird hell, eine Lichtkante zieht nach hinten und die
// Tasten/Kappen im Foto leuchten Reihe für Reihe auf (gleiche Leuchtpunkte wie im Intro, intro-leds.ts).
// Einmalig, danach bleiben die Lichter an; keine Endlos-Animation.
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
import { CONTACT } from "../config/site";
import { u } from "../lib/url";
---
<section class="hero" aria-labelledby="hero-title" data-hero data-room="stageroom">
  <div class="photos" data-slides>
    <div class="board">
      <Photo name="stagePultBlick" eager sizes="100vw" />
      <div class="leds" aria-hidden="true" data-hero-leds></div>
      <span class="scan" aria-hidden="true"></span>
    </div>
    <span class="shade" aria-hidden="true"></span>
  </div>

  <div class="wrap hero-inner">
    <p class="where ld" style="--d:0s">Tonstudio &amp; Proberäume in München-Sendling</p>
    <h1 id="hero-title" class="hero-title"><span><span class="shine">Dein Sound.</span></span><span><span class="shine shine--2">Dein Raum.</span></span></h1>
    <div class="btn-row hero-cta ld" style="--d:.35s">
      <a class="btn btn--primary" href={u("/kontakt/")}>Session anfragen</a>
      <a class="btn btn--ghost" href={CONTACT.phoneHref}><Icon name="phone" />{CONTACT.phone}</a>
    </div>
    <a class="hero-next ld" style="--d:.5s" href="#raumwahl">Welcher Raum passt zu dir?</a>
  </div>
</section>

<style>
  .hero { position: relative; min-height: min(calc(100svh - 76px), 900px); display: flex; align-items: flex-end; overflow: hidden; background: #07080b; isolation: isolate; border-bottom: 1px solid var(--line); }

  /* ---------- Pult-Foto mit Leuchtpunkten ---------- */
  /* Das Foto deckt den Bereich ab wie object-fit: cover – als Kasten im Seitenverhältnis des Fotos, damit die
     Leuchtpunkte (in % des Fotos) genau auf den Tasten sitzen. */
  .photos { position: absolute; inset: 0; z-index: -1; container-type: size; }
  .board { position: absolute; left: 50%; top: 50%; width: max(100cqw, 100cqh * 1672 / 941); aspect-ratio: 1672 / 941; translate: -50% -50%; }
  .board :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .shade { position: absolute; inset: 0; background:
      linear-gradient(90deg, rgb(7 8 11 / 0.82) 0%, rgb(7 8 11 / 0.4) 55%, rgb(7 8 11 / 0.08) 100%),
      linear-gradient(0deg, rgb(7 8 11 / 0.9) 0%, transparent 48%); }
  /* Strom an: Foto startet gedimmt und wird hell, sobald die Lichter loslaufen */
  :global(.js) .hero .board :global(img) { filter: brightness(0.35) saturate(0.6); transition: filter 1.8s cubic-bezier(0.3, 0.1, 0.3, 1); }
  :global(.js) .hero.power .board :global(img) { filter: none; }
  .leds { position: absolute; inset: 0; pointer-events: none; }
  .leds :global(i) { position: absolute; left: var(--x); top: var(--y); width: var(--w); aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; opacity: 0; scale: 0.4;
    background: radial-gradient(closest-side, #fff 0%, var(--c) 32%, color-mix(in srgb, var(--c) 40%, transparent) 60%, transparent 100%); }
  .leds :global(i.warm) { width: calc(var(--w) * 2.2); }
  .hero.power .leds :global(i) { animation: led-on 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.4) var(--t) forwards; }
  @keyframes led-on { 0% { opacity: 0; scale: 0.4; } 45% { opacity: 1; scale: 1.35; } 100% { opacity: var(--o, 0.9); scale: 1; } }
  .scan { position: absolute; left: 0; right: 0; top: 100%; height: 22%; opacity: 0; mix-blend-mode: screen; pointer-events: none; will-change: transform;
    background: linear-gradient(0deg, transparent, rgb(230 236 247 / 0.16) 50%, transparent); }
  .hero.power .scan { animation: scan 2s cubic-bezier(0.4, 0, 0.3, 1) 0.05s forwards; }
  @keyframes scan { 0% { transform: translateY(0); opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { transform: translateY(-318%); opacity: 0; } }

  /* ---------- Text ---------- */
  .hero-inner { display: grid; gap: 26px; justify-items: start; padding-block: clamp(120px, 18vh, 200px) clamp(48px, 7vw, 88px); }
  .where { margin: 0; display: inline-flex; align-items: center; gap: 10px; color: var(--amber); font: 500 var(--step-0) / 1.3 var(--font-body); text-shadow: 0 1px 12px rgb(0 0 0 / 0.6); }
  .where::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 12px var(--amber); }
  .hero h1 { font-size: clamp(3.2rem, 0.6rem + 8vw, 9rem); line-height: 0.9; font-weight: 300; letter-spacing: -0.045em; filter: drop-shadow(0 6px 30px rgb(0 0 0 / 0.55)); margin: 0; }
  .hero h1 > span { display: block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; white-space: nowrap; }
  .hero h1 > span > span { display: inline-block; }
  .shine { transform-origin: left center; background: linear-gradient(105deg, transparent 42%, rgb(255 255 255 / 0.85) 50%, transparent 58%), linear-gradient(176deg, #ffffff 0%, #dfe3e8 38%, #8f97a3 58%, #e6e9ed 82%, #b9bfc8 100%); background-size: 260% 100%, 100% 100%; background-repeat: no-repeat; background-position: 100% 0, 0 0; -webkit-background-clip: text; background-clip: text; color: transparent; }
  .shine--2 { background-image: linear-gradient(105deg, transparent 42%, rgb(255 255 255 / 0.85) 50%, transparent 58%), linear-gradient(176deg, #f4f6f9 0%, #c6cbd2 40%, #7d8591 60%, #dfe3e8 84%, #a9b0bb 100%); }
  @media (forced-colors: active) { .shine { color: CanvasText; background: none; } }
  :global(.js) .hero.title-in .shine { animation: track-in 1.3s cubic-bezier(0.2, 0.7, 0.15, 1) both, shimmer 2.4s ease-in-out 1.3s 1; }
  :global(.js) .hero.title-in .shine--2 { animation-delay: 0.15s, 1.5s; }
  @keyframes track-in { from { transform: scale(1.12); filter: blur(14px); opacity: 0; } to { transform: none; filter: blur(0); opacity: 1; } }
  @keyframes shimmer { 0% { background-position: 100% 0, 0 0; } 100% { background-position: 0% 0, 0 0; } }
  :global(.js) .hero .ld { opacity: 0; transform: translateY(18px); transition: opacity 0.8s var(--ease), transform 0.8s var(--ease); transition-delay: var(--d, 0s); }
  :global(.js) .hero.title-in .ld { opacity: 1; transform: none; }
  .hero-next { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: #e6e9ee; text-decoration: none; font-size: var(--step--1); }
  .hero-next::after { content: ""; width: 8px; height: 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-3px) rotate(45deg); }
  .hero-next:hover { color: #fff; text-decoration: underline; text-underline-offset: 6px; }

  @media (max-width: 640px) {
    .hero { min-height: calc(100svh - 120px); }
    .hero-inner { padding-block: 96px 32px; gap: 22px; }
    .hero-cta { width: 100%; flex-direction: column; align-items: stretch !important; }
    .hero-cta .btn { width: 100%; }
    .shade { background: linear-gradient(0deg, rgb(7 8 11 / 0.94) 22%, rgb(7 8 11 / 0.5) 62%, rgb(7 8 11 / 0.25) 100%); }
  }
  /* Ruhige Variante: Pult hell, Lichter an, keine Bewegung */
  @media (prefers-reduced-motion: reduce) {
    :global(html:not(.fx-force)) .hero .board :global(img) { filter: none; transition: none; }
    :global(html:not(.fx-force)) .hero .leds :global(i) { animation: none; opacity: var(--o, 0.85); scale: 1; }
    :global(html:not(.fx-force)) .hero .scan { display: none; }
  }
</style>

<script>
  import { LEDS } from "./intro-leds";
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const leds = hero?.querySelector<HTMLElement>("[data-hero-leds]");
  if (hero && leds) {
    // Leuchtpunkte erzeugen: vorne (unten im Bild) zuerst, dann Reihe für Reihe nach hinten.
    // Alle warmen Tasten, von den Drehknöpfen nur jeder zweite – spart Rechenzeit beim Laden.
    const frag = document.createDocumentFragment();
    for (const [x, y, w, c, warm] of LEDS.filter((l, n) => l[4] || n % 2 === 0)) {
      const i = document.createElement("i");
      if (warm) i.className = "warm";
      const t = 0.15 + ((100 - y) / 58) * 1.6 + Math.random() * 0.16;
      i.style.cssText = `--x:${x}%;--y:${y}%;--w:${w}%;--c:${c};--t:${t.toFixed(2)}s;--o:${warm ? 0.95 : 0.5}`;
      frag.append(i);
    }

    // Ladefolge: Überschrift und Pult gehen gemeinsam an – nach dem Intro, sonst sofort
    const html = document.documentElement;
    const start = () => requestAnimationFrame(() => {
      hero.classList.add("title-in");
      leds.append(frag); // erst jetzt einfügen, damit das Laden der Seite nicht belastet wird
      setTimeout(() => hero.classList.add("power"), 250);
    });
    if (html.classList.contains("intro-play") && !html.classList.contains("intro-done")) {
      new MutationObserver((_, o) => { if (html.classList.contains("intro-done")) { o.disconnect(); start(); } }).observe(html, { attributes: true, attributeFilter: ["class"] });
    } else start();
  }
</script>
