---
// Startbereich als Konzertplakat: Überschrift, Druckplatte (Foto in der Raumfarbe) und darunter das „Line-up“ –
// die drei Räume wie Acts auf einem Plakat. Ein Act wählt den Raum: Druckplatte, Farbe und der Überblick
// darunter (#programm) wechseln. Die einzige Bewegung ohne Zutun: die Platte wird einmal „gedruckt“ (Rakelzug).
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
import type { PhotoKey } from "../assets/photos";
import { CONTACT } from "../config/site";
import { u } from "../lib/url";

type RoomKey = "tonstudio" | "stageroom" | "lightroom";
interface Channel { key: RoomKey; name: string; path: string; photo: PhotoKey; alt: string; spec: string; use: string; price: string }
interface Props { channels: Channel[]; start?: RoomKey }
const { channels, start = "stageroom" } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title" data-hero data-room={start}>
  <div class="wrap hero-grid">
    <div class="copy">
      <h1 id="hero-title" class="hero-title"><span>Dein Sound.</span> <span>Dein Raum.</span></h1>
      <p class="lead">Aufnehmen, proben und gestalten mitten in Sendling – mit jahrelanger Erfahrung im Studio und auf der Bühne.</p>
      <div class="btn-row hero-cta">
        <a class="btn" href={u("/kontakt/")}>Session anfragen</a>
        <a class="btn btn--ghost" href={CONTACT.phoneHref}><Icon name="phone" />{CONTACT.phone}</a>
      </div>
    </div>

    <div class="plates" data-slides>
      {channels.map((c) => (
        <figure class:list={["plate", "shot", { "is-on": c.key === start, seen: c.key === start }]} data-room={c.key} data-shot={c.key} aria-hidden={c.key === start ? undefined : "true"}>
          <Photo name={c.photo} eager={c.key === start} sizes="(min-width: 900px) 46vw, 100vw" decorative={c.key !== start} />
        </figure>
      ))}
      <div class="cap" id="hero-out" aria-live="polite">
        {channels.map((c) => (
          <p class="cap-room" data-out={c.key} hidden={c.key !== start}>
            <span>Im Bild: <strong>{c.name}</strong></span>
            <a href={u(c.path)}>{c.name} ansehen</a>
          </p>
        ))}
      </div>
    </div>
  </div>

  <div class="wrap bill">
    <p class="bill-q" id="bill-q">Welchen Raum brauchst du?</p>
    <div class="acts" role="group" aria-labelledby="bill-q">
      {channels.map((c) => (
        <button type="button" class="act" data-ch={c.key} data-room={c.key} aria-pressed={c.key === start ? "true" : "false"} aria-controls="hero-out programm">
          <span class="act-name">{c.name}</span>
          <span class="act-use">{c.use}, {c.spec}</span>
          <span class="act-price">{c.price}</span>
        </button>
      ))}
    </div>
  </div>

  <ul class="wrap facts" aria-label="Kurz zu Silver Stage">
    <li><strong>Mitten in Sendling</strong>{CONTACT.street}, {CONTACT.zip} {CONTACT.city}</li>
    <li><strong>Jahrelange Erfahrung</strong>in Aufnahme und Live-Sound</li>
    <li><strong>3 Räume</strong>unter einem Dach</li>
  </ul>
</section>

<style>
  .hero { position: relative; padding-top: clamp(28px, 5vw, 64px); }
  .hero-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 28px); align-items: end; }
  .copy { grid-column: 1 / span 7; grid-row: 1; position: relative; z-index: 2; display: grid; gap: 22px; justify-items: start; padding-bottom: clamp(8px, 2vw, 24px); }
  .hero-title { font-size: clamp(2.6rem, 0.9rem + 5.5vw, 5.6rem); font-weight: 860; font-stretch: 114%; line-height: 0.88; letter-spacing: -0.035em; mix-blend-mode: multiply; }
  .hero-title span { display: block; white-space: nowrap; }
  .lead { color: var(--ink); max-width: 34ch; }
  .plates { z-index: 1; grid-column: 8 / -1; grid-row: 1; position: relative; aspect-ratio: 4 / 4.4; max-height: min(64svh, 600px); width: 100%; justify-self: end; }
  .shot { position: absolute; inset: 0 0 52px 0; margin: 0; display: none; }
  .shot.seen { display: block; }
  .shot.is-on { z-index: 2; }
  .shot.was { z-index: 1; }
  .shot:not(.is-on):not(.was) { visibility: hidden; }
  .shot :global(img) { position: absolute; inset: 0; }
  /* Rakelzug: die neue Farbe wird von oben nach unten durchgezogen */
  .shot.pull { animation: pull 0.75s var(--ease) both; }
  @keyframes pull { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  .cap { position: absolute; left: 0; right: 0; bottom: 0; height: 52px; display: flex; align-items: center; border-bottom: 2px solid var(--ink); }
  .cap-room { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 16px; width: 100%; font-size: var(--step--1); }
  .cap-room[hidden] { display: none; }
  .cap-room strong { font-weight: 700; }
  .cap-room a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 650; text-decoration-thickness: 2px; text-underline-offset: 5px; }

  /* Line-up */
  .bill { margin-top: clamp(28px, 4vw, 48px); }
  .bill-q { font: 700 0.95rem / 1.2 var(--font-body); margin-bottom: 12px; }
  .acts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .act { min-width: 0; position: relative; display: grid; gap: 4px; align-content: start; text-align: left; padding: 22px clamp(14px, 2vw, 24px) 20px; min-height: 132px; border: 0; background: transparent; color: var(--ink); font: inherit; cursor: pointer; transition: background-color 0.25s var(--ease), color 0.25s var(--ease); }
  .act + .act { border-left: 2px solid var(--ink); }
  .act::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 8px; background: var(--room); transition: height 0.35s var(--ease); }
  .act:hover::before { height: 14px; }
  .act[aria-pressed="true"] { background: var(--room); color: var(--on-room); }
  .act[aria-pressed="true"]::before { height: 0; }
  .act:focus-visible { outline: 3px solid var(--ink); outline-offset: -6px; }
  .act[data-room="lightroom"]:focus-visible[aria-pressed="true"] { outline-color: #fff; }
  .act-name { font: 860 clamp(1.5rem, 0.6rem + 2.6vw, 3rem) / 1 var(--font-display); font-stretch: 122%; overflow-wrap: anywhere; letter-spacing: -0.03em; margin-top: 6px; }
  .act-use { font-weight: 650; }
  .act-price { font-size: var(--step--1); color: var(--ink-2); }
  .act[aria-pressed="true"] .act-price { color: var(--on-room-2); }

  .facts { list-style: none; padding: 18px 0 0; margin-top: 0; margin-bottom: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 24px; font-size: var(--step--1); color: var(--ink-2); }
  .facts li { display: grid; gap: 2px; }
  .facts strong { color: var(--ink); font: 750 1rem / 1.2 var(--font-display); font-stretch: 112%; }

  @media (max-width: 900px) {
    .copy { grid-column: 1 / -1; }
    .plates { grid-column: 1 / -1; grid-row: 2; aspect-ratio: 16 / 11; max-height: none; margin-top: 28px; }
  }
  @media (max-width: 720px) {
    .acts { grid-template-columns: 1fr; }
    .act + .act { border-left: 0; border-top: 2px solid var(--ink); }
    .act { min-height: 0; padding: 16px 16px 14px; }
    .act::before { height: 0; top: auto; bottom: 0; left: 0; right: auto; width: 10px; height: 100%; }
    .act:hover::before { height: 100%; }
    .act { padding-left: 26px; }
    .facts { grid-template-columns: 1fr; }
    .hero-cta { width: 100%; }
    .hero-cta .btn { flex: 1 1 100%; }
  }
  @media (max-width: 420px) { .hero-title { font-stretch: 108%; font-size: clamp(2.3rem, 0.6rem + 9.2vw, 3rem); } }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) {
    const acts = [...hero.querySelectorAll<HTMLButtonElement>("[data-ch]")];
    const shots = [...hero.querySelectorAll<HTMLElement>("[data-shot]")];
    const outs = [...hero.querySelectorAll<HTMLElement>("[data-out]")];
    const prog = document.querySelector<HTMLElement>("[data-programm]");
    const calm = () => matchMedia("(prefers-reduced-motion: reduce)").matches && !document.documentElement.classList.contains("fx-force");
    let current = hero.dataset.room!;
    const pull = (f: HTMLElement) => { if (calm()) return; f.classList.remove("pull"); void f.offsetWidth; f.classList.add("pull"); };
    const pick = (key: string) => {
      if (key === current) return;
      const prev = shots.find((f) => f.dataset.shot === current);
      current = key; hero.dataset.room = key;
      acts.forEach((s) => s.setAttribute("aria-pressed", String(s.dataset.ch === key)));
      shots.forEach((f) => {
        const on = f.dataset.shot === key;
        f.classList.toggle("is-on", on); f.classList.toggle("was", f === prev);
        f.toggleAttribute("aria-hidden", !on);
        if (on) { f.classList.add("seen"); pull(f); }
      });
      setTimeout(() => prev?.classList.remove("was"), 800);
      outs.forEach((o) => (o.hidden = o.dataset.out !== key));
      if (prog) {
        prog.dataset.room = key;
        prog.querySelectorAll<HTMLElement>("[data-prog]").forEach((p) => (p.hidden = p.dataset.prog !== key));
      }
    };
    acts.forEach((s) => {
      s.addEventListener("click", () => pick(s.dataset.ch!));
      // Foto schon beim Darüberfahren/Fokus vorladen, damit der Wechsel ohne Lücke ist
      const warm = () => shots.find((f) => f.dataset.shot === s.dataset.ch)?.classList.add("seen");
      s.addEventListener("pointerenter", warm); s.addEventListener("focus", warm);
    });
    // Pfeiltasten wandern zwischen den Acts
    hero.querySelector(".acts")?.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key, i = acts.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0 || !["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(k)) return;
      e.preventDefault(); acts[(i + (k === "ArrowRight" || k === "ArrowDown" ? 1 : -1) + acts.length) % acts.length].focus();
    });
    // Einmaliger Druck der ersten Platte, sobald das Intro (falls es läuft) vorbei ist
    const html = document.documentElement;
    const first = () => { const f = shots.find((x) => x.dataset.shot === current); if (f) pull(f); };
    if (html.classList.contains("intro-play") && !html.classList.contains("intro-done")) {
      new MutationObserver((_, o) => { if (html.classList.contains("intro-done")) { o.disconnect(); first(); } }).observe(html, { attributes: true, attributeFilter: ["class"] });
    } else first();
    addEventListener("load", () => setTimeout(() => shots.forEach((f) => f.classList.add("seen")), 2500), { once: true });
  }
</script>
