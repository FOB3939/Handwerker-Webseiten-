---
// Kopf der Unterseiten: gelbes Flyer-Feld, H1 in Plakatschrift, Einleitung, optional Foto im Papierrahmen
import Img from "./Img.astro";
import type { ImageKey } from "../assets/img";
interface Props { title: string; lead?: string; image?: ImageKey }
const { title, lead, image } = Astro.props;
---
<section class:list={["phead", "on-sun", { "phead--img": image }]}>
  <div class="wrap inner">
    <div class="txt">
      <h1 set:html={title} />
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {image && <div class="pic frame"><Img name={image} sizes="(min-width: 900px) 38vw, 100vw" eager note /></div>}
  </div>
</section>
<div class="fold" aria-hidden="true"></div>
<style>
  .inner { display: grid; grid-template-columns: 1fr; gap: 32px; align-items: end; padding-block: clamp(44px, 6vw, 88px) clamp(48px, 7vw, 96px); }
  .phead--img .inner { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); align-items: center; }
  .txt { display: grid; gap: 20px; justify-items: start; }
  h1 { font-size: var(--step-4); line-height: 0.95; max-width: 14ch; }
  .lead { color: var(--ink-soft); }
  .pic { aspect-ratio: 4 / 3; transform: rotate(1.5deg); }
  @media (max-width: 860px) { .phead--img .inner { grid-template-columns: 1fr; } .pic { transform: none; } }
</style>
