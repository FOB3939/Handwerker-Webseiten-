---
// Text-Wortmarke bis zum Original-Logo (kein aus KI-Bildern ausgeschnittenes Logo).
// Zweifarbig wie ein Flyer-Druck: „Pizza“ klein in Textschrift, „Freechoice“ in der fetten Plakatschrift.
interface Props { class?: string; size?: "sm" | "lg" | "xl" }
const { class: cls, size = "sm" } = Astro.props;
---
<span class:list={["wm", `wm--${size}`, cls]}><span class="wm-pizza">Pizza</span><span class="wm-name">Freechoice</span></span>
<style>
  .wm { display: inline-flex; flex-direction: column; align-items: flex-start; line-height: 1; white-space: nowrap; }
  .wm-pizza { font: 800 0.42em / 1 var(--font-body); letter-spacing: 0.02em; margin: 0 0 0.12em 0.08em; }
  .wm-name { font-family: var(--font-display); font-size: 1em; letter-spacing: -0.015em; }
  .wm--sm { font-size: 1.7rem; }
  .wm--lg { font-size: clamp(2.6rem, 1.6rem + 5vw, 5rem); }
  .wm--xl { font-size: min(11.5rem, calc((min(100vw, var(--wrap)) - 2 * var(--pad)) / 6.4)); }
</style>
