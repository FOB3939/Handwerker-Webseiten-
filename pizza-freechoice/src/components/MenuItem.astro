---
// Ein Eintrag der Speisekarte im Flyer-Stil: Sortenname, Beschreibung, Größen mit Punktführer zum Preis.
import Img from "./Img.astro";
import { euro } from "../config/site";
import type { Product } from "../config/menu";
interface Props { p: Product; withImage?: boolean; headingLevel?: "h2" | "h3" }
const { p, withImage = false, headingLevel = "h3" } = Astro.props;
const H = headingLevel;
---
<article class:list={["item", { "item--img": withImage && p.image }]} data-item data-search={`${p.name} ${p.description}`.toLowerCase()} data-cat={p.category}>
  {withImage && p.image && <div class="pic frame"><Img name={p.image} sizes="(min-width: 900px) 140px, 96px" /></div>}
  <div class="body">
    <div class="top">
      <H class="name">{p.name}</H>
      {p.demo && <span class="badge">Demo-Eintrag</span>}
    </div>
    <p class="desc muted">{p.description}</p>
    <ul class="variants" aria-label={`Größen und Preise für ${p.name}`}>
      {p.variants.map((v) => <li><span class="v">{v.label}{v.sizeCm ? ` · ${v.sizeCm} cm` : ""}</span><span class="dots" aria-hidden="true"></span><strong>{euro(v.priceCents)}{p.demo && <span class="visually-hidden"> (Demopreis)</span>}</strong></li>)}
    </ul>
    <p class="meta">{p.allergens ? `Allergene: ${p.allergens.join(", ")}` : "Allergene und Zusatzstoffe: noch nicht bestätigt"}</p>
  </div>
</article>
<style>
  .item { display: grid; gap: 18px; padding: 22px 0 24px; border-bottom: 2px dashed var(--rule); }
  .item--img { grid-template-columns: 128px minmax(0, 1fr); align-items: start; }
  .pic { aspect-ratio: 1; padding: 5px; transform: rotate(-2deg); }
  .body { display: grid; gap: 8px; min-width: 0; }
  .top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }
  .name { font-size: var(--step-2); line-height: 1.02; }
  .desc { font-size: var(--step--1); line-height: 1.5; max-width: 52ch; }
  .variants { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 4px; max-width: 30rem; }
  .variants li { display: flex; align-items: baseline; gap: 8px; }
  .v { font-weight: 600; }
  .dots { flex: 1; min-width: 24px; border-bottom: 3px dotted rgb(43 26 16 / 0.45); transform: translateY(-4px); }
  .variants strong { font: 700 1.12rem / 1 var(--font-body); color: var(--tomato); white-space: nowrap; }
  .meta { font-size: 0.82rem; color: var(--ink-soft); }
  @media (max-width: 480px) { .item--img { grid-template-columns: 84px minmax(0, 1fr); gap: 14px; } }
</style>
