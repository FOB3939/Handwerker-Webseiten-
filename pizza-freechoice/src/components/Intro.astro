---
// Pizza-Intro (~3 s), einmal pro Sitzung, überspringbar (Knopf, Escape, Scrollen/Wischen).
// 0–0,7 s Stempelring zeichnet sich · 0,7–1,7 s drei Zutatenformen fliegen ein · 1,7–2,8 s Wortmarke · bis 3 s ausblenden.
// Liegt über der fertig geladenen Seite (blockiert weder Laden noch Bestellweg). Bei reduzierter Bewegung: kein Intro.
import Wordmark from "./Wordmark.astro";
---
<script is:inline>
  (function () {
    var seen = null;
    try { seen = sessionStorage.getItem("pf-intro"); sessionStorage.setItem("pf-intro", "1"); }
    catch (e) { seen = window.__pfIntro || null; window.__pfIntro = "1"; } // ohne Sitzungsspeicher (z. B. eingebettete Vorschau)
    if (location.hash === "#intro") seen = null; // Vorschau: Intro erneut abspielen
    if (!seen && !matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("intro-play");
  })();
</script>
<div class="intro" data-intro>
  <div class="stage" aria-hidden="true">
    <svg class="pie" viewBox="0 0 200 200">
      <circle class="ring" cx="100" cy="100" r="80" pathLength="1" />
      <circle class="ring ring--in" cx="100" cy="100" r="68" pathLength="1" />
      <g class="topping t1"><circle cx="72" cy="80" r="11" fill="#2b1a10" /><circle cx="72" cy="80" r="3.6" fill="#ffc52e" /></g>
      <g class="topping t2"><path d="M108 64c11 2 21 10 25 21" stroke="#b8261b" stroke-width="9" stroke-linecap="round" fill="none" /></g>
      <g class="topping t3"><circle cx="96" cy="126" r="10" fill="none" stroke="#6f7f16" stroke-width="5.5" /></g>
    </svg>
    <div class="mark"><Wordmark size="lg" /></div>
  </div>
  <button class="skip" type="button" data-intro-skip tabindex="-1">Überspringen</button>
</div>
<style>
  .intro { display: none; }
  /* Gelber Flyer-Karton: Stempelring, Zutaten, Wortmarke wird „aufgedruckt“, dann rollt der Karton nach oben weg */
  :global(html.intro-play) .intro { display: grid; place-items: center; position: fixed; inset: 0; z-index: 200; background: var(--sun); color: var(--espresso); animation: out 0.5s cubic-bezier(0.7, 0, 0.3, 1) 2.5s forwards; }
  .stage { display: grid; justify-items: center; gap: 14px; }
  .pie { width: min(52vw, 250px); overflow: visible; }
  .ring { fill: none; stroke: var(--tomato); stroke-width: 5; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 0.7s cubic-bezier(0.6, 0, 0.3, 1) 0.05s forwards; }
  .ring--in { stroke-width: 2; stroke-dasharray: 0.012 0.018; stroke-dashoffset: 0; opacity: 0; animation: fade 0.4s ease-out 0.45s forwards; }
  .topping { opacity: 0; transform-box: fill-box; transform-origin: center; animation: drop 0.55s cubic-bezier(0.3, 1.4, 0.5, 1) forwards; }
  .t1 { --dx: -90px; --dy: -70px; animation-delay: 0.75s; }
  .t2 { --dx: 100px; --dy: -60px; animation-delay: 0.95s; }
  .t3 { --dx: -20px; --dy: 110px; animation-delay: 1.15s; }
  .mark { clip-path: inset(0 100% 0 0); transform: translateY(8px) scale(1.04); filter: blur(4px); animation: print 0.6s var(--ease) 1.65s forwards; }
  .skip { position: absolute; right: 20px; bottom: calc(20px + env(safe-area-inset-bottom, 0px)); min-height: 44px; padding: 0 18px; border-radius: 999px; border: 2px solid var(--espresso); background: transparent; color: var(--espresso); font: 700 0.95rem / 1 var(--font-body); cursor: pointer; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes drop { from { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(-40deg) scale(0.6); } to { opacity: 1; transform: none; } }
  @keyframes print { to { clip-path: inset(0 -10% 0 0); transform: none; filter: none; } }
  @keyframes out { to { transform: translateY(-100%); visibility: hidden; } }
  :global(html.intro-done) .intro { display: none !important; }
</style>
<script>
  const root = document.documentElement, intro = document.querySelector<HTMLElement>("[data-intro]");
  if (intro && root.classList.contains("intro-play")) {
    const skip = intro.querySelector<HTMLButtonElement>("[data-intro-skip]")!;
    skip.tabIndex = 0;
    let done = false;
    const finish = () => {
      if (done) return; done = true;
      root.classList.remove("intro-play"); root.classList.add("intro-done");
      removeEventListener("keydown", onKey); removeEventListener("wheel", finish); removeEventListener("touchmove", finish);
    };
    const onKey = (e: KeyboardEvent) => { if (e.key === "Escape") finish(); };
    addEventListener("keydown", onKey);
    addEventListener("wheel", finish, { passive: true });
    addEventListener("touchmove", finish, { passive: true });
    skip.addEventListener("click", finish);
    setTimeout(finish, 3000);
  }
</script>
