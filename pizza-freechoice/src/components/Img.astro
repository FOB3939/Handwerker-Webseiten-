---
// Bild aus src/assets/img: WebP (bei diesen Motiven kleiner als AVIF) + JPEG-Fallback, feste Maße (kein Layoutsprung), nie hochskaliert.
// In der Vorschau optional mit Hinweis, dass das Motiv KI-bearbeitet/-inszeniert ist.
import { Picture } from "astro:assets";
import { IMAGES, type ImageKey } from "../assets/img";
import { SITE } from "../config/site";
interface Props { name: ImageKey; class?: string; sizes?: string; eager?: boolean; decorative?: boolean; note?: boolean }
const { name, class: cls, sizes = "100vw", eager = false, decorative = false, note = false } = Astro.props;
const img = IMAGES[name];
const widths = [480, 800, 1200, 1672].filter((w) => w <= img.src.width);
---
<Picture src={img.src} alt={decorative ? "" : img.alt} widths={widths} sizes={sizes} formats={["webp"]} fallbackFormat="jpg" quality={70}
  loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} decoding="async" class={cls} />
{note && SITE.preview && <span class="img-note">{img.status === "ki-bearbeitet" ? "Entwurfsbild, KI-bearbeitet – wird durch Originalfoto ersetzt" : "Illustratives Motiv (KI-inszeniert)"}</span>}
