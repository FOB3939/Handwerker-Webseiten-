---
// Feste Bestell-Leiste am Handy. Body bekommt unten Platz (--mbar), damit nichts verdeckt wird.
import Icon from "./Icon.astro";
import { u } from "../lib/url";
---
<nav class="mbar on-dark" aria-label="Schnellzugriff">
  <a class="btn btn--ghost" href={u("/speisekarte/")}><Icon name="list" />Speisekarte</a>
  <a class="btn btn--sun" href={u("/bestellen/")}><Icon name="bag" />Jetzt bestellen</a>
</nav>
<style>
  .mbar { display: none; }
  @media (max-width: 760px) {
    :global(:root) { --mbar: calc(78px + env(safe-area-inset-bottom, 0px)); }
    :global(.site-footer) { padding-bottom: calc(24px + var(--mbar)) !important; }
    .mbar { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 1.25fr; gap: 10px;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); border-top: 3px solid var(--sun); box-shadow: 0 -10px 24px -16px rgb(43 26 16 / 0.6); }
    .mbar .btn { --h: 52px; padding: 0 12px; }
  }
</style>
