---
// Feste Bestell-Leiste am Handy. Body bekommt unten Platz (--mbar), damit nichts verdeckt wird.
import Icon from "./Icon.astro";
import { u } from "../lib/url";
---
<nav class="mbar" aria-label="Schnellzugriff">
  <a class="btn btn--ghost" href={u("/speisekarte/")}><Icon name="list" />Speisekarte</a>
  <a class="btn btn--primary" href={u("/bestellen/")}><Icon name="bag" />Jetzt bestellen</a>
</nav>
<style>
  .mbar { display: none; }
  @media (max-width: 760px) {
    :global(:root) { --mbar: calc(76px + env(safe-area-inset-bottom, 0px)); }
    :global(body) { padding-bottom: var(--mbar); }
    .mbar { position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 1.25fr; gap: 10px;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); background: rgb(33 26 22 / 0.96); color: var(--cream);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-top: 1px solid var(--line-dark); }
    .mbar .btn { --h: 52px; padding: 0 12px; }
  }
</style>
