---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";
import Bon from "../components/Bon.astro";
import MenuItem from "../components/MenuItem.astro";
import { getImage } from "astro:assets";
import { IMAGES } from "../assets/img";
import { SITE, BUSINESS, address, OPEN } from "../config/site";
import { visibleProducts } from "../config/menu";
import { u } from "../lib/url";

// Einstieg mit Art Direction: quer (04) ab 761 px, hochkant (05) darunter
const set = async (src: any, widths: number[], q: number) => (await Promise.all(widths.filter((w) => w <= src.width).map(async (w) => `${(await getImage({ src, width: w, format: "webp", quality: q })).src} ${w}w`))).join(", ");
const dk = IMAGES.heroDesktop.src, mb = IMAGES.heroMobil.src;
const hero = {
  // WebP ist bei diesen Motiven kleiner als AVIF (gemessen) → nur WebP + JPEG-Fallback
  dWebp: await set(dk, [960, 1280, 1672], 64),
  mWebp: await set(mb, [480, 760, 1000], 56),
  fallback: (await getImage({ src: dk, width: 1280, format: "jpg", quality: 70 })).src,
};
const items = visibleProducts(SITE.preview).slice(0, 3);
const adr = address();
const steps = [
  { t: "Aussuchen", d: "Stöber in der Speisekarte und wähle Sorte und Größe." },
  { t: "Bestellweg öffnen", d: "Über „Jetzt bestellen“ gelangst du zum Bestellweg – online oder per Telefon, sobald freigeschaltet." },
  { t: "Liefern lassen oder abholen", d: "Je nach Angebot bringt der Heimservice deine Pizza, oder du holst sie im Laden ab." },
];
---
<Base title="Pizza Freechoice – Pizza Heimservice" description="Pizza Freechoice: Speisekarte ansehen, Lieblingspizza aussuchen und bestellen – Heimservice und Abholung." current="/" intro jsonld>
  <!-- Einstieg: gelber Flyer-Karton mit Foto im Papierrahmen und Bestellbon -->
  <section class="hero on-sun" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-txt">
        <h1 id="hero-title">Dein Pizza-Moment.</h1>
        <p class="lead hero-lead">Entdecke unsere Speisekarte und finde deine nächste Lieblingspizza.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={u("/bestellen/")}><Icon name="bag" />Jetzt bestellen</a>
          <a class="btn btn--ghost" href={u("/speisekarte/")}>Speisekarte ansehen</a>
        </div>
      </div>
      <div class="hero-pic frame">
        <picture>
          <source media="(max-width: 760px)" type="image/webp" srcset={hero.mWebp} sizes="calc(100vw - 40px)" />
          <source type="image/webp" srcset={hero.dWebp} sizes="(min-width: 1280px) 640px, 52vw" />
          <img src={hero.fallback} width={dk.width} height={dk.height} alt={IMAGES.heroDesktop.alt} fetchpriority="high" decoding="async" />
        </picture>
        {SITE.preview && <span class="img-note">Illustratives Motiv (KI-inszeniert)</span>}
      </div>
      <div class="hero-bon" aria-label="Lieferung und Abholung" role="group"><Bon /></div>
    </div>
  </section>
  <div class="fold" aria-hidden="true"></div>

  <!-- Menüvorschau wie auf dem Lieferzettel -->
  <section class="section menu" aria-labelledby="menu-title">
    <div class="wrap menu-grid">
      <div class="menu-side">
        <h2 id="menu-title">Such dir was aus.</h2>
        <div class="menu-pic frame"><Img name="pizzaDraufsicht" sizes="(min-width: 1000px) 420px, 90vw" note /></div>
        <a class="btn btn--ghost" href={u("/speisekarte/")}>Ganze Speisekarte</a>
      </div>
      <div class="menu-list">
        {SITE.preview && <p class="notice"><Icon name="info" /><span><strong>Vorschau:</strong> Die aktuelle Speisekarte liegt noch nicht vor. Die Einträge unten sind Demo-Daten mit Beispielpreisen.</span></p>}
        {items.map((p) => <MenuItem p={p} />)}
      </div>
    </div>
  </section>

  <!-- Bildband mit aufgelegtem Flyer-Feld -->
  <section class="band" aria-labelledby="band-title">
    <Img name="pizzaDetail" class="band-img" sizes="100vw" decorative />
    {SITE.preview && <span class="img-note">Illustratives Motiv (KI-inszeniert)</span>}
    <div class="wrap band-inner">
      <div class="band-card on-sun">
        <h2 id="band-title">Free Choice heißt: Du hast die Wahl.</h2>
        <p>Klassiker oder voll belegt, Mittagspause oder Pizzaabend mit Freunden – such dir aus, worauf du heute Lust hast.</p>
      </div>
    </div>
  </section>

  <!-- Ablauf -->
  <section class="section steps-sec on-dark" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title">In drei Schritten zur Pizza.</h2>
      <ol class="steps">
        {steps.map((s, i) => <li><span class="num" aria-hidden="true">{i + 1}</span><h3>{s.t}</h3><p class="muted">{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- Über uns + Kontakt -->
  <section class="section on-kraft" aria-labelledby="about-title">
    <div class="wrap about">
      <div class="about-pic frame"><Img name="ladenAussen" sizes="(min-width: 900px) 50vw, 100vw" note /></div>
      <div class="about-txt">
        <h2 id="about-title">Der Laden mit dem gelben Schild.</h2>
        <p class="lead muted">Pizza Freechoice ist ein Pizza-Heimservice. Erkennst du schon von Weitem: am gelben Schild über dem Schaufenster.</p>
        <dl class="facts">
          <div><dt>Adresse</dt><dd>{adr ?? <span class="open">{OPEN}</span>}</dd></div>
          <div><dt>Telefon</dt><dd>{BUSINESS.phone && BUSINESS.phoneHref ? <a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a> : <span class="open">{OPEN}</span>}</dd></div>
          <div><dt>Öffnungszeiten</dt><dd>{BUSINESS.hours ? BUSINESS.hours.map((h) => <span class="hrow">{h.day}: {h.time}</span>) : <span class="open">{OPEN}</span>}</dd></div>
        </dl>
        <div class="btn-row">
          <a class="btn btn--ghost" href={u("/ueber-uns/")}>Mehr über uns</a>
          <a class="btn btn--ghost" href={u("/kontakt/")}>Kontakt &amp; Anfahrt</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Abschluss -->
  <section class="final on-sun" aria-labelledby="final-title">
    <div class="wrap final-inner">
      <h2 id="final-title">Hunger bekommen?</h2>
      <div class="btn-row">
        <a class="btn btn--primary" href={u("/bestellen/")}><Icon name="bag" />Jetzt bestellen</a>
        <a class="btn btn--ghost" href={u("/speisekarte/")}>Speisekarte ansehen</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Einstieg ---------- */
  .hero { overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); grid-template-rows: auto auto; column-gap: clamp(28px, 4vw, 64px);
    padding-block: clamp(40px, 5vw, 72px) clamp(48px, 6vw, 88px); align-items: start; }
  .hero-txt { grid-column: 1; grid-row: 1; display: grid; gap: 24px; justify-items: start; padding-top: clamp(8px, 2vw, 28px); }
  .hero h1 { font-size: clamp(3.4rem, 1.6rem + 5.4vw, 6rem); line-height: 0.88; letter-spacing: -0.02em; max-width: 7ch; }
  .hero-lead { color: var(--ink-soft); max-width: 30ch; }
  .hero-pic { grid-column: 2; grid-row: 1 / span 2; aspect-ratio: 5 / 5.6; transform: rotate(1.6deg); margin-right: calc(-1 * clamp(0px, 3vw, 40px)); }
  .hero-pic img { object-position: 74% 50%; }
  .hero-bon { grid-column: 1; grid-row: 2; align-self: end; max-width: 460px; margin-top: 36px; position: relative; z-index: 1; }
  @media (max-width: 1100px) and (min-width: 761px) {
    .hero-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); padding-block: 28px 40px; }
    .hero-txt { grid-row: 1; padding-top: 0; gap: 18px; }
    .hero h1 { font-size: clamp(3rem, 1rem + 11vw, 4.4rem); }
    .hero .btn-row { width: 100%; }
    .hero .btn-row .btn { flex: 1 1 100%; }
    .hero-pic { grid-column: 1; grid-row: 2; aspect-ratio: 4 / 4.2; margin: 28px 0 0; transform: rotate(-1.2deg); }
    .hero-pic img { object-position: 50% 82%; }
    .hero-bon { grid-row: 3; max-width: none; margin-top: -36px; margin-inline: 10px; }
  }

  /* ---------- Menüvorschau ---------- */
  .menu-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .menu-side { display: grid; gap: 28px; justify-items: start; position: sticky; top: 110px; }
  .menu-side h2 { font-size: var(--step-4); line-height: 0.92; max-width: 7ch; }
  .menu-pic { width: min(100%, 420px); aspect-ratio: 1; transform: rotate(-2.5deg); }
  .menu-list .notice { margin-bottom: 8px; }
  @media (max-width: 1000px) { .menu-grid { grid-template-columns: 1fr; } .menu-side { position: static; } .menu-pic { width: min(100%, 360px); } }

  /* ---------- Bildband ---------- */
  .band { position: relative; isolation: isolate; overflow: hidden; background: var(--espresso); }
  .band :global(.band-img) { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; }
  .band .img-note { left: auto; right: 12px; }
  .band-inner { display: flex; align-items: flex-end; min-height: clamp(460px, 52vw, 720px); padding-block: clamp(40px, 6vw, 80px); }
  .band-card { display: grid; gap: 16px; max-width: 560px; padding: clamp(24px, 3vw, 40px); border-radius: var(--r); box-shadow: var(--shadow-print); transform: rotate(-1.2deg); }
  .band-card h2 { font-size: var(--step-3); line-height: 0.95; }
  .band-card p { color: var(--ink-soft); font-size: var(--step-1); line-height: 1.45; }
  @media (max-width: 760px) { .band-inner { min-height: 0; padding-top: 240px; } .band-card { transform: none; } }

  /* ---------- Ablauf: Lieferweg als gestrichelte Route ---------- */
  .steps-sec h2 { color: var(--sun); max-width: 16ch; }
  .steps { list-style: none; margin: clamp(36px, 5vw, 64px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; position: relative; }
  .steps::before { content: ""; position: absolute; left: 0; right: 12%; top: 44px; border-top: 3px dashed rgb(255 197 46 / 0.55); }
  .steps li { position: relative; display: grid; gap: 10px; align-content: start; }
  .num { display: grid; place-items: center; width: 88px; height: 88px; border-radius: 50%; background: var(--sun); color: var(--espresso); font: 400 2.8rem / 1 var(--font-display); margin-bottom: 12px; box-shadow: 0 0 0 8px var(--espresso); }
  .steps h3 { font-size: var(--step-2); color: var(--ink-on-dark); }
  .steps p { max-width: 34ch; }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; gap: 28px; }
    .steps::before { left: 42px; right: auto; top: 0; bottom: 0; border-top: 0; border-left: 3px dashed rgb(255 197 46 / 0.55); }
    .steps li { grid-template-columns: 88px 1fr; column-gap: 20px; }
    .num { grid-row: span 2; margin: 0; }
  }

  /* ---------- Über uns ---------- */
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 80px); align-items: center; }
  .about-pic { aspect-ratio: 4 / 3; transform: rotate(-1.5deg); }
  .about-txt { display: grid; gap: 20px; justify-items: start; }
  .facts { margin: 4px 0; display: grid; width: 100%; }
  .facts div { display: grid; grid-template-columns: 150px 1fr; gap: 12px; padding: 10px 0; border-bottom: 2px dotted var(--rule); }
  .facts dt { font-weight: 700; }
  .facts dd { margin: 0; }
  .hrow { display: block; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } .about-pic { transform: none; } .facts div { grid-template-columns: 1fr; gap: 2px; } }

  /* ---------- Abschluss ---------- */
  .final .btn-row { justify-content: center; }
  .final-inner { display: grid; justify-items: center; text-align: center; gap: 28px; padding-block: clamp(72px, 10vw, 140px); }
  .final h2 { font-size: clamp(3rem, 1.2rem + 5.6vw, 6rem); line-height: 0.9; }
</style>
