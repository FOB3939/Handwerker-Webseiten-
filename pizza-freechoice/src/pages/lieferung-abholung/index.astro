---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import { DELIVERY, BUSINESS, address, euro, OPEN } from "../../config/site";
import { u } from "../../lib/url";
const val = (v: string | null) => v ?? OPEN;
const rows = [
  { k: "Liefergebiet", v: val(DELIVERY.area) },
  { k: "Lieferkosten", v: DELIVERY.feeCents == null ? OPEN : DELIVERY.feeCents === 0 ? "ohne Liefergebühr" : euro(DELIVERY.feeCents) },
  { k: "Mindestbestellwert", v: DELIVERY.minOrderCents == null ? OPEN : euro(DELIVERY.minOrderCents) },
  { k: "Zahlungsarten", v: DELIVERY.payment ? DELIVERY.payment.join(", ") : OPEN },
];
const adr = address();
---
<Base title="Lieferung & Abholung – Pizza Freechoice" description="Lieferung und Abholung bei Pizza Freechoice: Liefergebiet, Lieferkosten, Mindestbestellwert, Abholzeiten und Ablauf." current="/lieferung-abholung/">
  <PageHead title="Zu dir nach Hause oder zum Mitnehmen." lead="Pizza Freechoice ist ein Pizza-Heimservice. Hier findest du die Bedingungen für Lieferung und Abholung." image="abholung" />
  <section class="section section--tight">
    <div class="wrap cols">
      <article class="box">
        <h2>Lieferung</h2>
        <dl>
          {rows.map((r) => <div><dt>{r.k}</dt><dd class:list={{ open: r.v === OPEN }}>{r.v}</dd></div>)}
        </dl>
      </article>
      <article class="box">
        <h2>Abholung</h2>
        <dl>
          <div><dt>Abholen möglich</dt><dd class:list={{ open: DELIVERY.pickup == null }}>{DELIVERY.pickup == null ? OPEN : DELIVERY.pickup ? "ja" : "nein"}</dd></div>
          <div><dt>Adresse</dt><dd class:list={{ open: !adr }}>{adr ?? OPEN}</dd></div>
          <div><dt>Abholzeiten</dt><dd class:list={{ open: !BUSINESS.hours }}>{BUSINESS.hours ? BUSINESS.hours.map((h) => <span class="h">{h.day}: {h.time}</span>) : OPEN}</dd></div>
        </dl>
      </article>
    </div>
    <div class="wrap flow">
      <h2>Ablauf</h2>
      <ol>
        <li><span>Pizza in der <a href={u("/speisekarte/")}>Speisekarte</a> aussuchen.</span></li>
        <li><span>Über <a href={u("/bestellen/")}>Jetzt bestellen</a> den Bestellweg öffnen.</span></li>
        <li><span>Lieferung oder Abholung wählen – je nach Angebot des Bestellwegs.</span></li>
      </ol>
      <p class="muted small">Lieferzeiten hängen von Tageszeit und Auslastung ab; wir nennen hier keine pauschale Zeit.</p>
    </div>
  </section>
</Base>
<style>
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 40px); }
  .box { padding: clamp(24px, 3vw, 36px); border-radius: var(--r); background: var(--paper); border: 2px solid var(--espresso); display: grid; gap: 14px; align-content: start; }
  .box h2 { font-size: var(--step-3); }
  dl { margin: 0; display: grid; }
  dl div { display: grid; grid-template-columns: 190px 1fr; gap: 12px; padding: 12px 0; border-bottom: 2px dotted var(--rule); }
  dt { font-weight: 700; }
  dd { margin: 0; }
  .h { display: block; }
  .flow { margin-top: clamp(40px, 6vw, 72px); display: grid; gap: 14px; }
  .flow h2 { font-size: var(--step-2); }
  .flow ol { list-style: none; counter-reset: f; margin: 0; padding: 0; display: grid; gap: 10px; max-width: 720px; }
  .flow li { counter-increment: f; display: grid; grid-template-columns: 44px 1fr; align-items: center; gap: 14px; }
  .flow li::before { content: counter(f); display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--sun); font: 400 1.3rem / 1 var(--font-display); }
  .flow a { font-weight: 700; display: inline-block; padding-block: 6px; }
  .small { font-size: var(--step--1); }
  @media (max-width: 820px) { .cols { grid-template-columns: 1fr; } dl div { grid-template-columns: 1fr; gap: 2px; } }
</style>
