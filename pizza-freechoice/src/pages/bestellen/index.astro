---
// Bestellen: nur echte Bestellwege. Externer Anbieter mit bestätigter URL, sonst Telefon (wenn bestätigt).
// Ohne beides: klarer Hinweis, KEIN vorgetäuschter Warenkorb oder Checkout.
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Icon from "../../components/Icon.astro";
import { SITE, BUSINESS, ORDER } from "../../config/site";
import { u } from "../../lib/url";
const hasOnline = !!ORDER.url, hasPhone = !!(BUSINESS.phone && BUSINESS.phoneHref);
---
<Base title="Bestellen – Pizza Freechoice" description="So bestellst du bei Pizza Freechoice: online beim Bestellanbieter oder per Telefon – Lieferung oder Abholung." current="/bestellen/">
  <PageHead title="Jetzt bestellen." lead="Wähle deinen Bestellweg. Du brauchst kein Kundenkonto bei uns." />
  <section class="section section--tight">
    <div class="wrap ways">
      <article class="way way--main">
        <Icon name="bag" class="way-ico" />
        <h2>Online bestellen</h2>
        {hasOnline ? (
          <>
            <p class="muted">Du wechselst zu {ORDER.provider ?? "unserem Bestellanbieter"}. Dort stellst du deine Bestellung zusammen und bezahlst; es gelten die Preise und Bedingungen des Anbieters.</p>
            <a class="btn btn--primary" href={ORDER.url!} rel="noopener" target="_blank"><Icon name="external" />Zu {ORDER.provider ?? "Bestellanbieter"}<span class="visually-hidden"> (öffnet neuen Tab)</span></a>
          </>
        ) : (
          <>
            <p class="muted">Der Online-Bestellweg ist noch nicht freigeschaltet.</p>
            {SITE.preview && <p class="notice"><span><strong>Vorschau:</strong> Hier erscheint der Knopf zum tatsächlichen Bestellanbieter (z. B. Lieferando oder ein eigener Shop), sobald die bestätigte Bestell-URL vorliegt. Es wird nichts bestellt oder bezahlt.</span></p>}
          </>
        )}
      </article>
      <article class="way">
        <Icon name="phone" class="way-ico" />
        <h2>Per Telefon</h2>
        {hasPhone ? (
          <>
            <p class="muted">Ruf uns an und gib deine Bestellung direkt durch.</p>
            <a class="btn btn--ghost" href={BUSINESS.phoneHref!}><Icon name="phone" />{BUSINESS.phone}</a>
          </>
        ) : (
          <p class="muted">Die Telefonnummer wird nach Bestätigung ergänzt.</p>
        )}
      </article>
    </div>
    <div class="wrap more">
      <h2>Bevor du bestellst</h2>
      <ul>
        <li><a href={u("/speisekarte/")}>Speisekarte ansehen</a> – Sorten, Größen und Preise</li>
        <li><a href={u("/lieferung-abholung/")}>Lieferung &amp; Abholung</a> – Liefergebiet, Kosten und Abholzeiten</li>
        <li><a href={u("/allergene-zusatzstoffe/")}>Allergene &amp; Zusatzstoffe</a></li>
      </ul>
    </div>
  </section>
</Base>
<style>
  .ways { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 40px); align-items: start; }
  .way { display: grid; gap: 14px; align-content: start; justify-items: start; padding: clamp(24px, 3vw, 36px); border-radius: var(--r); background: var(--paper); border: 2px solid var(--espresso); }
  .way--main { background: var(--sun); box-shadow: var(--shadow-print); transform: rotate(-0.8deg); }
  .way h2 { font-size: var(--step-3); }
  .way--main .muted { color: var(--ink-soft); }
  .way :global(.way-ico) { width: 30px; height: 30px; padding: 10px; border-radius: 50%; background: var(--espresso); color: var(--sun); box-sizing: content-box; }
  .way .notice { margin-top: 4px; }
  .more { margin-top: clamp(40px, 6vw, 72px); display: grid; gap: 14px; }
  .more h2 { font-size: var(--step-2); }
  .more ul { list-style: none; margin: 0; padding: 0; display: grid; max-width: 720px; }
  .more li { padding: 8px 0; border-bottom: 2px dotted var(--rule); }
  .more a { font-weight: 700; display: inline-flex; align-items: center; min-height: 32px; }
  @media (max-width: 820px) { .ways { grid-template-columns: 1fr; } .way--main { transform: none; } }
</style>
