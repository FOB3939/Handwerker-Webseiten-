---
// Vorher/Nachher-Vergleich: Schieberegler (Tastatur: Pfeiltasten), ohne JS stehen beide Bilder nebeneinander
import Img from "./Img.astro";
import type { ImageKey } from "../assets/img";
interface Props { before: ImageKey; after: ImageKey; label: string; ratio?: string }
const { before, after, label, ratio = "4 / 5" } = Astro.props;
---
<figure class="ba" data-ba style={`--ratio:${ratio}`}>
  <div class="stage">
    <div class="img img--after"><Img name={after} sizes="(min-width: 900px) 45vw, 100vw" /></div>
    <div class="img img--before" data-before><Img name={before} sizes="(min-width: 900px) 45vw, 100vw" /></div>
    <span class="chip chip--b" aria-hidden="true">Vorher</span><span class="chip chip--a" aria-hidden="true">Nachher</span>
    <span class="handle" aria-hidden="true" data-handle></span>
    <input class="range" type="range" min="0" max="100" value="50" aria-label={`${label}: Vorher-Nachher-Regler`} data-range />
  </div>
  <figcaption class="muted">{label}</figcaption>
</figure>
<style>
  .ba { margin: 0; display: grid; gap: 12px; }
  .stage { position: relative; aspect-ratio: var(--ratio); overflow: hidden; border-radius: var(--r-photo); background: var(--putz-2); --p: 50%; }
  .img { position: absolute; inset: 0; }
  .img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .img--before { clip-path: inset(0 calc(100% - var(--p)) 0 0); }
  .chip { position: absolute; top: 12px; padding: 6px 10px; border-radius: var(--r-tag); background: var(--white); color: var(--ink); font: 750 0.92rem / 1 var(--display); pointer-events: none; box-shadow: 0 2px 8px rgb(21 32 26 / 0.2); }
  .chip::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 7px; border-radius: 50%; background: var(--ruecklauf); vertical-align: 1px; }
  .chip--a::before { background: var(--vorlauf); }
  .chip--b { left: 12px; } .chip--a { right: 12px; }
  .handle { position: absolute; top: 0; bottom: 0; left: var(--p); width: 4px; margin-left: -2px; background: var(--brass); pointer-events: none; box-shadow: 0 0 0 1px rgb(21 32 26 / 0.35); }
  /* Messing-Handrad als Griff */
  .handle::after { content: ""; position: absolute; top: 50%; left: 50%; width: 52px; height: 52px; translate: -50% -50%; border-radius: 50%;
    background: radial-gradient(circle, var(--ink) 0 5px, var(--brass) 5px 9px, transparent 9px), conic-gradient(from 0deg, transparent 0 40deg, var(--brass) 40deg 50deg, transparent 50deg 130deg, var(--brass) 130deg 140deg, transparent 140deg 220deg, var(--brass) 220deg 230deg, transparent 230deg 310deg, var(--brass) 310deg 320deg, transparent 320deg);
    box-shadow: inset 0 0 0 6px var(--brass), inset 0 0 0 8px var(--brass-dk), 0 4px 14px rgb(0 0 0 / 0.35); transform: rotate(var(--a, 0deg)); }
  .range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .stage:has(.range:focus-visible) { outline: 3px solid var(--ruecklauf); outline-offset: 3px; }
  figcaption { font-size: var(--step--1); }
</style>
<script>
  document.querySelectorAll<HTMLElement>("[data-ba]").forEach((ba) => {
    const stage = ba.querySelector<HTMLElement>(".stage")!, r = ba.querySelector<HTMLInputElement>("[data-range]")!;
    const set = () => { stage.style.setProperty("--p", `${r.value}%`); stage.style.setProperty("--a", `${(+r.value - 50) * 3.6}deg`); };
    r.addEventListener("input", set); set();
  });
</script>
