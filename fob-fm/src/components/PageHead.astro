---
// Seitenkopf der Unterseiten: große Überschrift auf Putz, abgeschlossen von der Doppelleitung Vorlauf/Rücklauf
interface Props { title: string; lead?: string }
const { title, lead } = Astro.props;
---
<section class="phead">
  <div class="wrap inner">
    <h1>{title}</h1>
    {lead && <p class="lead muted">{lead}</p>}
    <slot />
  </div>
  <div class="pipes" aria-hidden="true"></div>
</section>
<style>
  .phead { background: var(--putz); }
  .inner { display: grid; gap: 20px; justify-items: start; padding-block: clamp(56px, 8vw, 112px) clamp(40px, 5vw, 64px); }
  h1 { font-size: var(--step-4); max-width: 14ch; }
  .lead { max-width: 52ch; }
</style>
