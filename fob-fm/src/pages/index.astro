---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import Icon from "../components/Icon.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Verteiler from "../components/Verteiler.astro";
import { COMPANY, FUNDING } from "../config/site";
import { u } from "../lib/url";
---
<Base title="FOB Haustechnik – Hausmeisterservice & Wärmepumpen" description="FOB Haustechnik Hausmeisterservice: Sanitär, Heizung, Elektro, Malerarbeiten, Böden und Gebäudereinigung rund um München – plus Luft-Wasser-Wärmepumpen mit Beratung und Förderung, deutschlandweit mit Partnern." current="/" jsonld>
  <!-- Einstieg: Schnittmodell als 3D-Szene -->
  <section class="hero dark" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-txt">
        <h1 id="hero-title">Alles rund ums Haus.</h1>
        <p class="lead muted">Schnell, sauber, zuverlässig: Sanitär, Heizung, Elektro, Maler- und Bodenarbeiten aus einer Hand. Neu dabei: Luft-Wasser-Wärmepumpen – mit Beratung, Förderung und Einbau über unsere Partner in ganz Deutschland.</p>
        <div class="btn-row">
          <a class="btn btn--brass" href={u("/kontakt/#anfrage")}>Anfrage stellen</a>
          <a class="btn btn--line" href={u("/waermepumpe/")}><Icon name="fan" />Wärmepumpe &amp; Förderung</a>
        </div>
      </div>
      <div class="scene" data-scene>
        <svg class="scene-fallback" viewBox="0 0 100 80" aria-hidden="true"><rect x="52" y="2" width="26" height="62" fill="#d9a21b" /><rect x="16" y="28" width="30" height="26" fill="#d9a21b" /><path d="M38 14 H86 V74 H70 M38 14 V38 M10 32 H48 M10 32 V74 H44 V54 M70 74 V44 H92 V66 L60 52" fill="none" stroke="#eef3ee" stroke-width="2.5" /></svg>
        <p class="legend" aria-hidden="true"><span class="k k--air">Außenluft</span><span class="k k--vor">Vorlauf</span><span class="k k--rueck">Rücklauf</span></p>
        <button class="pause" type="button" aria-pressed="false" data-pause hidden><span class="visually-hidden" data-pause-label>3D-Animation anhalten</span><span class="pause-ico" aria-hidden="true"></span></button>
      </div>
    </div>
    <ul class="wrap facts" aria-label="Kurz zu FOB Haustechnik">
      <li class="pipe-tag pipe-tag--brass"><b></b><span>6 Gewerke<small>aus einer Hand</small></span></li>
      <li class="pipe-tag pipe-tag--air"><b></b><span>Wärmepumpen<small>deutschlandweit mit Partnern</small></span></li>
      <li class="pipe-tag"><b></b><span>Hochstadt<small>bei Weßling, {COMPANY.region}</small></span></li>
    </ul>
  </section>

  <!-- Leistungen als Verteiler -->
  <section class="section svc" aria-labelledby="svc-title">
    <div class="wrap">
      <div class="head">
        <h2 id="svc-title">Ein Ansprechpartner, sechs Gewerke.</h2>
        <p class="muted">Wähle ein Gewerk und sieh, was wir dort für dich erledigen.</p>
      </div>
      <Verteiler />
    </div>
  </section>

  <!-- Wärmepumpe: Strang von der Außenluft bis zur Wärme -->
  <section class="hp dark" aria-labelledby="hp-title">
    <div class="wrap hp-grid">
      <div class="hp-txt">
        <h2 id="hp-title">Luft-Wasser-Wärmepumpe: von der Beratung bis zur Förderung.</h2>
        <p class="lead muted">Gemeinsam mit Fachpartnern begleiten wir dich deutschlandweit: Wir prüfen, ob dein Haus geeignet ist, kümmern uns um den Förderantrag und koordinieren den Einbau.</p>
        <a class="btn btn--brass" href={u("/waermepumpe/")}>Mehr zur Wärmepumpe<Icon name="arrow" /></a>
      </div>
      <div class="hp-strang">
        <p class="pipe-tag pipe-tag--air end"><b></b><span>Außenluft</span></p>
        <ol class="hp-steps">
          <li><span class="n">1</span><div><h3>Beratung</h3><p class="muted">Haus, Heizung und Verbrauch gemeinsam anschauen – passt eine Wärmepumpe?</p></div></li>
          <li><span class="n">2</span><div><h3>Förderung</h3><p class="muted">Zuschuss über das {FUNDING.program.split(" – ")[0]}-Programm: Grundförderung {FUNDING.base.replace(" ", "\u00a0")} plus mögliche Boni. Wir prüfen den aktuellen Stand.</p></div></li>
          <li><span class="n">3</span><div><h3>Einbau mit Partnern</h3><p class="muted">Installation und Inbetriebnahme durch Fachbetriebe aus unserem Partnernetz.</p></div></li>
        </ol>
        <p class="pipe-tag end"><b></b><span>Wärme fürs Haus</span></p>
      </div>
    </div>
  </section>

  <!-- Vorher / Nachher -->
  <section class="section" aria-labelledby="ref-title">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <h2 id="ref-title">Aus alt mach neu</h2>
          <p class="muted">Zieh am Handrad und vergleiche selbst.</p>
        </div>
        <a class="btn btn--line" href={u("/referenzen/")}>Alle Referenzen<Icon name="arrow" /></a>
      </div>
      <div class="ba-grid">
        <BeforeAfter before="fassadeVorher" after="fassadeNachher" label="Fassade neu gestrichen – mit unserem Partner-Malermeister" ratio="1136 / 1330" />
        <BeforeAfter before="wandVorher" after="wandNachher" label="Malerarbeiten innen: Farbe und Spachteltechnik nach Kundenwunsch" ratio="1170 / 1160" />
      </div>
    </div>
  </section>

  <!-- Bildstreifen -->
  <section class="strip" aria-labelledby="strip-title">
    <div class="wrap">
      <h2 id="strip-title" class="strip-h">Weitere Arbeiten</h2>
      <ul class="strip-list">
        <li class="s-big"><Img name="terrasse" sizes="(min-width: 900px) 50vw, 100vw" /><span>Holzterrasse erneuert</span></li>
        <li><Img name="waschtisch" sizes="(min-width: 900px) 25vw, 50vw" /><span>Waschtisch &amp; Armatur</span></li>
        <li><Img name="wcStand" sizes="(min-width: 900px) 25vw, 50vw" /><span>Stand-WC montiert</span></li>
        <li class="s-wide"><Img name="boden" sizes="(min-width: 900px) 50vw, 100vw" /><span>Vinylboden verlegt</span></li>
      </ul>
    </div>
  </section>

  <!-- Kontakt: Messingfläche wie im Firmenzeichen -->
  <section class="cta" aria-labelledby="cta-title">
    <div class="wrap cta-grid">
      <div class="cta-txt">
        <h2 id="cta-title">Was steht bei dir an?</h2>
        <p class="lead">Schreib uns kurz, worum es geht – wir melden uns mit einem Termin oder Angebot.</p>
      </div>
      <div class="cta-box">
        <a class="big" href={`mailto:${COMPANY.email}`}><Icon name="mail" />{COMPANY.email}</a>
        <p><Icon name="pin" />{COMPANY.street}, {COMPANY.zip} {COMPANY.city}</p>
        <a class="btn btn--ink" href={u("/kontakt/#anfrage")}>Zur Anfrage</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Einstieg ---------- */
  .hero { position: relative; overflow: hidden; background: var(--tanne); }
  .hero::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgb(238 243 238 / 0.045) 1px, transparent 1px), linear-gradient(90deg, rgb(238 243 238 / 0.045) 1px, transparent 1px); background-size: 32px 32px; pointer-events: none; }
  .hero-grid { position: relative; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 24px; align-items: center; min-height: min(calc(100svh - 150px), 720px); padding-block: 48px 24px; }
  .hero-txt { display: grid; gap: 24px; justify-items: start; position: relative; z-index: 1; }
  .hero h1 { font-size: clamp(3.4rem, 1.4rem + 6.4vw, 6rem); line-height: 0.88; letter-spacing: -0.02em; max-width: 8ch; }
  .hero .lead { max-width: 42ch; font-size: var(--step-0); line-height: 1.6; }
  .scene { position: relative; height: min(66vh, 600px); min-height: 360px; }
  .scene :global(canvas) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; opacity: 0; transition: opacity 0.9s var(--ease); }
  .scene.ready :global(canvas) { opacity: 1; }
  .scene-fallback { position: absolute; left: 50%; top: 50%; width: 42%; translate: -50% -50%; opacity: 0.85; transition: opacity 0.6s; }
  .scene.ready .scene-fallback { opacity: 0; }
  .legend { position: absolute; z-index: 2; left: 0; bottom: 8px; display: flex; flex-wrap: wrap; gap: 14px; font: 600 0.9rem / 1 var(--font); color: var(--ink-d2); }
  .k { display: inline-flex; align-items: center; gap: 7px; }
  .k::before { content: ""; width: 18px; height: 4px; border-radius: 2px; background: var(--vorlauf-lt); }
  .k--air::before { background: var(--ruecklauf-lt); height: 4px; background: repeating-linear-gradient(90deg, var(--ruecklauf-lt) 0 4px, transparent 4px 7px); }
  .k--rueck::before { background: var(--ruecklauf-lt); }
  .pause { position: absolute; z-index: 2; right: 0; bottom: 0; width: 48px; height: 48px; border-radius: 50%; border: 2px solid rgb(238 243 238 / 0.45); background: rgb(29 58 46 / 0.7); color: var(--ink-d); cursor: pointer; display: grid; place-items: center; }
  .pause:hover { border-color: var(--brass); }
  .pause[hidden] { display: none; }
  .pause-ico { width: 10px; height: 12px; border-inline: 3px solid currentColor; }
  .pause[aria-pressed="true"] .pause-ico { width: 0; height: 0; border-inline: 0; border-left: 10px solid currentColor; border-block: 6px solid transparent; margin-left: 3px; }
  .facts { position: relative; list-style: none; margin: 0 auto; padding-block: 8px 44px; display: flex; flex-wrap: wrap; gap: 12px 16px; }
  .facts .pipe-tag { min-height: 52px; font-size: 1.12rem; }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; min-height: 0; padding-block: 40px 8px; gap: 8px; }
    .scene { height: 320px; min-height: 0; margin-inline: calc(var(--pad) * -1); }
    .legend { left: var(--pad); }
    .pause { right: var(--pad); }
    .facts { flex-direction: column; align-items: flex-start; }
  }

  /* ---------- Köpfe ---------- */
  .head { display: grid; gap: 12px; margin-bottom: 40px; max-width: 60ch; }
  .head--row { max-width: none; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .head--row > div { display: grid; gap: 12px; }

  /* ---------- Wärmepumpe ---------- */
  .hp { padding-block: clamp(72px, 9vw, 128px); background: var(--tanne); }
  .hp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .hp-txt { display: grid; gap: 22px; justify-items: start; }
  .hp-txt h2 { font-size: var(--step-3); }
  .hp-strang { position: relative; display: grid; gap: 0; justify-items: start; }
  .hp-strang .pipe-tag { position: relative; z-index: 1; }
  .hp-steps { list-style: none; margin: 0; padding: 18px 0; display: grid; gap: 22px; position: relative; }
  /* senkrechter Strang: oben blau (Luft), unten rot (Wärme) */
  .hp-strang::before { content: ""; position: absolute; left: 21px; top: 20px; bottom: 20px; width: 6px; border-radius: 3px; background: linear-gradient(var(--ruecklauf-lt), var(--vorlauf-lt)); }
  .hp-steps li { position: relative; display: grid; grid-template-columns: 48px 1fr; gap: 18px; align-items: start; }
  .n { position: relative; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--tanne); border: 3px solid var(--brass); color: var(--brass); font: 800 1.35rem / 1 var(--display); }
  .hp-steps h3 { margin: 4px 0 6px; font-size: var(--step-1); }
  @media (max-width: 900px) { .hp-grid { grid-template-columns: 1fr; } }

  /* ---------- Vorher / Nachher ---------- */
  .ba-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(16px, 2.5vw, 32px); align-items: start; }
  @media (max-width: 800px) { .ba-grid { grid-template-columns: 1fr; } }

  /* ---------- Bildstreifen ---------- */
  .strip { padding-bottom: clamp(72px, 9vw, 128px); }
  .strip-h { font-size: var(--step-2); margin-bottom: 24px; }
  .strip-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1.3fr 1fr 1fr; grid-template-rows: repeat(2, minmax(0, 260px)); gap: 12px; }
  .strip-list li { position: relative; overflow: hidden; border-radius: var(--r-photo); background: var(--putz-2); }
  .strip-list .s-big { grid-row: span 2; }
  .strip-list .s-wide { grid-column: span 2; }
  .strip-list :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .strip-list span { position: absolute; left: 10px; bottom: 10px; padding: 7px 11px; border-radius: var(--r-tag); background: var(--white); color: var(--ink); font: 750 0.98rem / 1.15 var(--display); box-shadow: 0 2px 10px rgb(21 32 26 / 0.25); }
  @media (max-width: 800px) {
    .strip-list { grid-template-columns: 1fr 1fr; grid-template-rows: none; grid-auto-rows: 220px; }
    .strip-list .s-big { grid-row: auto; grid-column: span 2; height: 300px; }
    .strip-list .s-wide { grid-column: span 2; }
  }

  /* ---------- Kontakt ---------- */
  .cta { background: var(--brass); color: var(--ink); padding-block: clamp(64px, 8vw, 112px); }
  .cta-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 32px; align-items: end; }
  .cta-txt { display: grid; gap: 16px; }
  .cta-txt h2 { font-size: var(--step-4); }
  .cta-box { display: grid; gap: 14px; justify-items: start; }
  .cta-box :global(svg) { width: 22px; height: 22px; flex: none; }
  .cta-box p { display: flex; gap: 10px; align-items: center; font-weight: 600; }
  .cta :focus-visible { outline-color: var(--ink); }
  .big { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; font: 800 var(--step-2) / 1.1 var(--display); text-decoration-thickness: 3px; text-underline-offset: 6px; overflow-wrap: anywhere; }
  .big:hover { text-decoration-color: var(--vorlauf); }
  @media (max-width: 860px) { .cta-grid { grid-template-columns: 1fr; } }
</style>

<script>
  // 3D-Szene nachladen, sobald die Seite steht (Startbild bleibt bis dahin das Firmenzeichen)
  const host = document.querySelector<HTMLElement>("[data-scene]");
  const hasGL = () => { try { const c = document.createElement("canvas"); return !!(c.getContext("webgl2") || c.getContext("webgl")); } catch { return false; } };
  if (host && hasGL()) {
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const go = () => import("../scripts/hero3d").then(({ mount }) => {
      const ctl = mount(host, { calm });
      requestAnimationFrame(() => host.classList.add("ready"));
      // Dauerbewegung anhalten können (WCAG 2.2.2)
      const btn = host.querySelector<HTMLButtonElement>("[data-pause]"), lab = host.querySelector<HTMLElement>("[data-pause-label]");
      if (btn && lab && !calm) {
        btn.hidden = false;
        btn.addEventListener("click", () => { const p = btn.getAttribute("aria-pressed") !== "true"; btn.setAttribute("aria-pressed", String(p)); lab.textContent = p ? "3D-Animation fortsetzen" : "3D-Animation anhalten"; ctl.setPaused(p); });
      }
    }).catch(() => {});
    // Erst bei der ersten Bewegung des Besuchers oder nach kurzer Zeit laden – so bleibt der Seitenaufbau frei
    let started = false;
    const kick = () => { if (started) return; started = true; ["pointermove", "scroll", "touchstart", "keydown"].forEach((ev) => removeEventListener(ev, kick)); go(); };
    ["pointermove", "scroll", "touchstart", "keydown"].forEach((ev) => addEventListener(ev, kick, { once: true, passive: true }));
    const later = () => setTimeout(() => ("requestIdleCallback" in window ? requestIdleCallback(kick, { timeout: 1500 }) : kick()), 2500);
    if (document.readyState === "complete") later(); else addEventListener("load", later, { once: true });
  }
</script>
