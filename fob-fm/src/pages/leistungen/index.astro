---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Img from "../../components/Img.astro";
import Icon from "../../components/Icon.astro";
import { SERVICES, SERVICE_TASKS, SERVICE_ICONS } from "../../config/site";
import { u } from "../../lib/url";
---
<Base title="Leistungen – FOB Haustechnik Hausmeisterservice" description="Leistungen von FOB Haustechnik: Sanitär & Heizung, Elektrotechnik, Malerarbeiten, Gebäudereinigung, Böden & Terrassen und Hausmeisterservice rund um München." current="/leistungen/">
  <PageHead title="Alles aus einer Hand" lead="Sechs Gewerke, ein Ansprechpartner – schnell, sauber, zuverlässig.">
    <nav class="jump" aria-label="Gewerke auf dieser Seite">
      {SERVICES.map((s) => <a href={`#${s.key}`}><Icon name={SERVICE_ICONS[s.key]} />{s.title}</a>)}
    </nav>
  </PageHead>
  <section class="section section--tight">
    <div class="wrap list">
      {SERVICES.map((s, i) => (
        <article class:list={["row", { "row--rev": i % 2 === 1, "row--noimg": !s.image }]} id={s.key} aria-labelledby={`h-${s.key}`}>
          {s.image
            ? <div class="pic"><Img name={s.image} sizes="(min-width: 900px) 45vw, 100vw" /></div>
            : <div class="pic plate" aria-hidden="true"><Icon name={SERVICE_ICONS[s.key]} class="plate-ico" /></div>}
          <div class="txt">
            <h2 id={`h-${s.key}`}>{s.title}</h2>
            <p class="lead muted">{s.text}</p>
            <ul class="tasks">{SERVICE_TASKS[s.key].map((x) => <li>{x}</li>)}</ul>
          </div>
        </article>
      ))}
      <p class="note">Die Liste zeigt typische Aufgaben. Frag gern nach, wenn dein Anliegen nicht dabei ist – „und mehr …“ steht nicht umsonst auf unserem Schild.</p>
      <div class="btn-row"><a class="btn btn--brass" href={u("/kontakt/#anfrage")}>Anfrage stellen</a><a class="btn btn--line" href={u("/referenzen/")}>Referenzen ansehen</a></div>
    </div>
  </section>
</Base>
<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .jump a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; background: var(--white); border-radius: var(--r-tag); text-decoration: none; font: 750 1.02rem / 1 var(--display); box-shadow: inset 0 -3px 0 var(--line); }
  .jump a:hover { box-shadow: inset 0 -3px 0 var(--vorlauf); }
  .jump :global(svg) { width: 18px; height: 18px; color: var(--ink-2); }
  .list { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(48px, 7vw, 96px); }
  .row > * { min-width: 0; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 72px); align-items: center; scroll-margin-top: 100px; }
  .row--rev .pic { order: 2; }
  .pic { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--r-photo); }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .plate { display: grid; place-items: center; background: var(--tanne); background-image: linear-gradient(rgb(238 243 238 / 0.06) 1px, transparent 1px), linear-gradient(90deg, rgb(238 243 238 / 0.06) 1px, transparent 1px); background-size: 24px 24px; }
  .plate :global(.plate-ico) { width: 32%; height: auto; color: var(--brass); stroke-width: 1.1; }
  .txt { display: grid; gap: 16px; justify-items: start; }
  .txt h2 { font-size: var(--step-3); }
  .tasks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .tasks li { display: flex; gap: 12px; align-items: baseline; }
  .tasks li::before { content: ""; flex: none; width: 10px; height: 10px; border-radius: 50%; border: 2.5px solid var(--vorlauf); translate: 0 -1px; }
  @media (max-width: 860px) { .row { grid-template-columns: 1fr; } .row--rev .pic { order: 0; } .plate { aspect-ratio: 16 / 7; } }
</style>
