---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Icon from "../../components/Icon.astro";
import InquiryForm from "../../components/InquiryForm.astro";
import { FUNDING } from "../../config/site";
import { u } from "../../lib/url";
const steps = [
  { t: "Erstgespräch", d: "Du erzählst uns von Haus, Heizung und Plänen – wir sagen dir ehrlich, ob eine Wärmepumpe infrage kommt." },
  { t: "Vor-Ort-Check", d: "Heizlast, Heizflächen, Vorlauftemperatur und Aufstellort werden geprüft – die Grundlage für die richtige Größe." },
  { t: "Angebot", d: "Du bekommst ein Angebot für Gerät, Einbau und Nebenarbeiten – nachvollziehbar aufgeschlüsselt." },
  { t: "Förderantrag", d: "Wir unterstützen dich beim Zuschussantrag, bevor es losgeht – die Reihenfolge ist bei der Förderung wichtig." },
  { t: "Einbau", d: "Fachbetriebe aus unserem Partnernetz installieren Außen- und Inneneinheit, wir koordinieren die Termine." },
  { t: "Inbetriebnahme", d: "Einstellung, Einweisung und Unterlagen für den Verwendungsnachweis der Förderung." },
];
const faq = [
  { q: "Geht eine Wärmepumpe auch im Altbau?", a: "Oft ja. Entscheidend sind Heizlast, Heizflächen und die nötige Vorlauftemperatur. Genau das prüfen wir beim Vor-Ort-Check, bevor du dich festlegst." },
  { q: "Wie laut ist das Außengerät?", a: "Das hängt vom Gerät und vor allem vom Aufstellort ab. Wir planen den Standort so, dass Abstände und Schallschutz zu dir und deinen Nachbarn passen." },
  { q: "Welche Förderung gibt es?", a: `Für Privatpersonen läuft der Zuschuss derzeit über das Programm ${FUNDING.program}. Es gibt eine Grundförderung von ${FUNDING.base.replace(" ", "\u00a0")} der förderfähigen Kosten, dazu je nach Situation Boni. Sätze und Grenzen ändern sich regelmäßig – wir prüfen den aktuellen Stand für dein Vorhaben.` },
  { q: "Arbeitet ihr auch außerhalb von München?", a: "Ja. Die Wärmepumpen-Projekte begleiten wir gemeinsam mit Fachpartnern deutschlandweit. Sag uns einfach, wo dein Haus steht." },
];
---
<Base title="Luft-Wasser-Wärmepumpe: Beratung, Förderung, Einbau – FOB Haustechnik" description="Luft-Wasser-Wärmepumpen mit FOB Haustechnik: Beratung, Vor-Ort-Check, Unterstützung beim KfW-Förderantrag und Einbau mit Fachpartnern – deutschlandweit." current="/waermepumpe/">
  <PageHead title="Wärmepumpe mit Plan" lead="Beratung, Förderung und Einbau einer Luft-Wasser-Wärmepumpe – deutschlandweit gemeinsam mit unseren Fachpartnern.">
    <div class="btn-row"><a class="btn btn--brass" href="#anfrage">Beratung anfragen</a><a class="btn btn--line" href="#foerderung"><Icon name="euro" />Zur Förderung</a></div>
  </PageHead>

  <!-- So funktioniert's -->
  <section class="section" aria-labelledby="how-title">
    <div class="wrap how">
      <div class="how-txt">
        <h2 id="how-title">So funktioniert’s</h2>
        <p class="lead muted">Eine Luft-Wasser-Wärmepumpe holt Wärme aus der Außenluft und bringt sie mit Strom auf die Temperatur, die deine Heizung und dein Warmwasser brauchen.</p>
        <ol class="flow-list">
          <li><span class="sw sw--ice"></span><strong>Außengerät:</strong> saugt Außenluft an und nimmt ihre Wärme auf.</li>
          <li><span class="sw sw--gold"></span><strong>Verdichter:</strong> hebt die Wärme auf Heiztemperatur.</li>
          <li><span class="sw sw--warm"></span><strong>Heizkreis:</strong> verteilt sie über Heizkörper oder Fußbodenheizung – und erwärmt das Wasser im Speicher.</li>
        </ol>
      </div>
      <svg class="diagram" viewBox="0 0 520 300" role="img" aria-labelledby="dg-t">
        <title id="dg-t">Schema: Außenluft fließt ins Außengerät, Wärme fließt über eine Leitung ins Haus zu Heizkörper und Warmwasserspeicher.</title>
        <g fill="none" stroke="#15201a" stroke-width="3">
          <path d="M250 270 V120 L360 40 L470 120 V270 Z" />
          <rect x="70" y="190" width="120" height="80" />
          <circle cx="110" cy="230" r="26" />
          <rect x="400" y="170" width="44" height="80" rx="6" />
          <path d="M290 200 h50 M290 215 h50 M290 230 h50" />
        </g>
        <rect x="360" y="120" width="40" height="40" fill="#d9a21b" />
        <g class="spin" style="transform-origin:110px 230px"><path d="M110 230 l0 -20 M110 230 l17 10 M110 230 l-17 10" stroke="#15201a" stroke-width="4" stroke-linecap="round" /></g>
        <g class="air" stroke="#205e98" stroke-width="3" stroke-linecap="round" fill="none"><path d="M10 205 h45" /><path d="M10 230 h45" /><path d="M10 255 h45" /></g>
        <path class="pipe" d="M190 215 C 230 215, 230 205, 290 205" stroke="#b3301b" stroke-width="5" fill="none" stroke-dasharray="10 10" />
        <path class="pipe" d="M340 215 C 370 215, 380 200, 400 200" stroke="#b3301b" stroke-width="5" fill="none" stroke-dasharray="10 10" />
        <text x="70" y="290" font-size="15" font-weight="700" fill="#47544c">Außengerät</text>
        <text x="282" y="190" font-size="15" font-weight="700" fill="#47544c">Heizkörper</text>
        <text x="392" y="268" font-size="15" font-weight="700" fill="#47544c">Speicher</text>
      </svg>
    </div>
  </section>

  <!-- Ablauf -->
  <section class="section dark" aria-labelledby="steps-title">
    <div class="wrap">
      <h2 id="steps-title">In sechs Schritten zur Wärmepumpe</h2>
      <ol class="steps">{steps.map((s, i) => <li><span class="n">{i + 1}</span><h3>{s.t}</h3><p class="muted">{s.d}</p></li>)}</ol>
    </div>
  </section>

  <!-- Förderung -->
  <section class="section" id="foerderung" aria-labelledby="fund-title">
    <div class="wrap fund">
      <div>
        <h2 id="fund-title">Zuschuss für deine neue Heizung</h2>
        <p class="lead muted">Für selbstgenutzte und vermietete Wohngebäude gibt es einen staatlichen Zuschuss für den Heizungstausch. Wir helfen dir, die passende Förderung zu beantragen.</p>
      </div>
      <div class="fund-box">
        <h3>{FUNDING.program}</h3>
        <ul class="checks">
          <li><Icon name="check" />Grundförderung: <strong>{FUNDING.base.replace(" ", "\u00a0")}</strong> der förderfähigen Kosten</li>
          <li><Icon name="check" />Mögliche Boni je nach Situation, z. B. für schnellen Heizungstausch, geringes Einkommen oder besonders effiziente Geräte</li>
          <li><Icon name="check" />Antrag vor Beginn der Arbeiten – wir sagen dir, was wann nötig ist</li>
        </ul>
        <p class="note"><span>Stand: {FUNDING.asOf}, ohne Gewähr. Fördersätze, Boni und Kostengrenzen ändern sich regelmäßig. Verbindlich sind die Angaben der KfW: <a href={FUNDING.url} target="_blank" rel="noopener">kfw.de/458<span class="visually-hidden"> (öffnet neuen Tab)</span></a>.</span></p>
      </div>
    </div>
  </section>

  <!-- Partner -->
  <section class="section section--tight partner dark" aria-labelledby="partner-title">
    <div class="wrap partner-grid">
      <h2 id="partner-title">Deutschlandweit mit Partnern</h2>
      <p class="lead muted">Wir koordinieren Beratung und Planung, Fachbetriebe aus unserem Partnernetz übernehmen den Einbau in deiner Region. So hast du einen Ansprechpartner – egal, wo dein Haus steht.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq">
      <h2 id="faq-title">Häufige Fragen</h2>
      <div class="qa">{faq.map((f) => <details><summary>{f.q}</summary><p class="muted">{f.a}</p></details>)}</div>
    </div>
  </section>

  <!-- Anfrage -->
  <section class="section section--tight form-sec" id="anfrage" aria-labelledby="form-title">
    <div class="wrap form-grid">
      <div>
        <h2 id="form-title">Beratung anfragen</h2>
        <p class="lead muted">Ein paar Angaben reichen – wir melden uns mit den nächsten Schritten.</p>
      </div>
      <InquiryForm topic="waermepumpe" />
    </div>
  </section>
</Base>
<style>
  .how { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(28px, 5vw, 72px); align-items: center; }
  .how-txt { display: grid; gap: 20px; }
  .flow-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .flow-list li { position: relative; padding-left: 36px; }
  .sw { position: absolute; left: 0; top: 0.72em; width: 22px; height: 6px; border-radius: 3px; } .sw--ice { background: var(--ruecklauf); } .sw--gold { background: var(--brass); } .sw--warm { background: var(--vorlauf); }
  .diagram { width: 100%; height: auto; background: var(--white); border-radius: var(--r-photo); padding: 16px; font-family: var(--font); }
  .spin { animation: spin 1.2s linear 4; }  /* begrenzt: Bewegung endet nach ≤ 5 s (WCAG 2.2.2) */
  .pipe { animation: flow 1s linear 5; }
  .air path { stroke-dasharray: 8 8; animation: flow 0.9s linear 5 reverse; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes flow { to { stroke-dashoffset: -20; } }
  @media (prefers-reduced-motion: reduce) { .spin, .pipe, .air path { animation: none; } }
  /* Ablauf als waagerechter Strang mit sechs Abzweigen */
  .steps { position: relative; list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 20px; }
  .steps::before { content: ""; position: absolute; left: 24px; right: 24px; top: 21px; height: 6px; border-radius: 3px; background: linear-gradient(90deg, var(--ruecklauf-lt), var(--vorlauf-lt)); }
  .steps li { position: relative; display: grid; gap: 10px; align-content: start; }
  .n { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--tanne); border: 3px solid var(--brass); color: var(--brass); font: 800 1.35rem / 1 var(--display); margin-bottom: 6px; }
  .fund { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  .fund > div:first-child { display: grid; gap: 18px; }
  .fund-box { display: grid; gap: 18px; padding: clamp(22px, 3vw, 32px); background: var(--white); border-radius: var(--r-tag); box-shadow: inset 0 6px 0 var(--brass); }
  .fund > *, .how > *, .faq > *, .form-grid > *, .partner-grid > * { min-width: 0; }
  .fund-box h3 { font-size: var(--step-1); overflow-wrap: break-word; hyphens: auto; }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .checks li { display: flex; gap: 10px; align-items: flex-start; }
  .checks :global(svg) { width: 20px; height: 20px; color: var(--vorlauf); flex: none; margin-top: 4px; }
  .partner { background: var(--tanne-2); }
  .partner-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 32px; align-items: center; }
  .faq { display: grid; grid-template-columns: 1fr 1.6fr; gap: 32px; }
  .qa details { border-bottom: 1px solid var(--line-2); }
  .qa summary { min-height: 60px; display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; font: 750 var(--step-1) / 1.2 var(--display); list-style: none; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary::after { content: ""; flex: none; width: 24px; height: 24px; border-radius: 50%; background: linear-gradient(#fff, #fff) center / 70% 4px no-repeat var(--ruecklauf); transition: transform 0.35s var(--ease), background-color 0.35s; }
  .qa details[open] summary::after { transform: rotate(90deg); background-color: var(--vorlauf); }
  .qa summary:hover { color: var(--tanne-3); }
  .qa p { padding-bottom: 20px; max-width: 64ch; }
  .form-sec { background: var(--putz-2); }
  .form-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; align-items: start; }
  .form-grid > div:first-child { display: grid; gap: 14px; }
  @media (max-width: 1000px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 36px; } .steps::before { display: none; } }
  @media (max-width: 900px) { .how, .fund, .partner-grid, .faq, .form-grid { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .steps { grid-template-columns: 1fr; gap: 24px; }
    .steps::before { display: block; left: 21px; right: auto; top: 24px; bottom: 24px; width: 6px; height: auto; background: linear-gradient(var(--ruecklauf-lt), var(--vorlauf-lt)); }
    .steps li { grid-template-columns: 48px 1fr; column-gap: 16px; row-gap: 4px; }
    .steps .n { grid-row: span 2; }
    .steps h3 { margin-top: 10px; }
  }
</style>
